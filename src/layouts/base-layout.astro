---
import Nav from '../components/nav.astro';
import Footer from '../components/footer.astro';
import '../styles/global.css';

interface Props {
  title:        string;
  description?: string;
  world?:       'dark' | 'light';  // HK or CA
  sections?:    { id: string; label: string }[];
}

const {
  title,
  description = 'Andrew YIP — UX/UI Designer & Developer',
  world = 'dark',
  sections = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle    = `${title} · Andrew YIP`;
---

<!DOCTYPE html>
<html lang="en" data-theme={world}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={canonicalURL} />
  <meta property="og:title"       content={fullTitle} />
  <meta property="og:description" content={description} />

  <link rel="icon" type="image/png" href="/images/andrew-yip-logo.png" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=DM+Sans:wght@300;400;500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <!-- Design system injected via Astro build (see frontmatter import) -->

  <!-- Per-page head injections (JSON-LD, etc.) -->
  <slot name="head" />
</head>
<body>
  <!-- Page transition curtain -->
  <div id="curtain" aria-hidden="true"></div>

  <!-- Global navigation -->
  <Nav sections={sections} />

  <!-- Page content goes here -->
  <slot />

  <!-- Global footer -->
  <Footer />

  <!-- GSAP loaded once, at the bottom -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
  <script is:inline src="/scripts/gsap.js"></script>
  <script is:inline>
    document.querySelectorAll('img, video, svg').forEach((el) => {
      el.setAttribute('draggable', 'false');
    });
  </script>
</body>
</html>