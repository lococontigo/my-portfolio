---
import BaseLayout from '../layouts/base-layout.astro';
---

<BaseLayout title="Contact" world="dark" description="Contact Andrew Yip — UX/UI designer and developer in Vancouver, BC. Tell me about your project, budget, and timeline, and I'll reply as soon as I can." translated={true}>
  <script slot="head" is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Contact Andrew Yip",
    "url": "https://andrewthyip.com/contact/",
    "description": "Contact form for project inquiries, freelance work, and full-time opportunities.",
    "about": {
      "@type": "Person",
      "name": "Andrew Yip",
      "jobTitle": "UX/UI Designer & Developer",
      "url": "https://andrewthyip.com",
      "email": "andrewthyip@gmail.com",
      "sameAs": ["https://www.linkedin.com/in/andrewthyip/"]
    }
  }
  </script>

  <main class="main">

    <!-- ── Contact: intro + form ─────────────── -->
    <section class="contact-section">
      <div class="padding-global">
        <div class="container-main">
          <div class="contact">

            <div class="contact-intro">
              <h1 class="contact-title">Tell Me About Your Project</h1>

              <div class="contact-guide">
                <p class="t-body">You can start from sending:</p>
                <ul class="t-body contact-guide-list">
                  <li>What is your project about?</li>
                  <li>Your budget &amp; timeline?</li>
                </ul>
                <p class="t-body">Thanks for your interest. I will read all the message and reply as soon as I could.</p>
              </div>
            </div>

            <div class="contact-card">
              <form id="contact-form" class="contact-form" novalidate>

                <!-- Honeypot — Web3Forms spam check, hidden from humans -->
                <input type="checkbox" name="botcheck" class="contact-botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
                <input type="hidden" name="from_name" value="andrewthyip.com contact form" />

                <div class="contact-form-grid">
                  <div class="contact-field">
                    <label for="contact-name" class="contact-label">Name</label>
                    <input id="contact-name" name="name" type="text" class="contact-input" placeholder="Enter your name" autocomplete="name" required aria-describedby="contact-name-hint" aria-invalid="false" />
                    <span id="contact-name-hint" class="contact-field-hint"></span>
                  </div>

                  <div class="contact-field">
                    <label for="contact-email" class="contact-label">Email</label>
                    <input id="contact-email" name="email" type="email" class="contact-input" placeholder="Enter your email" autocomplete="email" required aria-describedby="contact-email-hint" aria-invalid="false" />
                    <span id="contact-email-hint" class="contact-field-hint"></span>
                  </div>

                  <div class="contact-field">
                    <label for="contact-company" class="contact-label">Company (optional)</label>
                    <input id="contact-company" name="company" type="text" class="contact-input" placeholder="Enter company name" autocomplete="organization" />
                  </div>

                  <div class="contact-field">
                    <label for="contact-phone" class="contact-label">Phone (optional)</label>
                    <input id="contact-phone" name="phone" type="tel" class="contact-input" placeholder="Enter your phone number" autocomplete="tel" />
                  </div>

                  <div class="contact-field contact-field-full">
                    <label for="contact-message" class="contact-label">Message</label>
                    <textarea id="contact-message" name="message" class="contact-input contact-textarea" placeholder="Tell me about your project..." rows="4" required aria-describedby="contact-message-hint" aria-invalid="false"></textarea>
                    <span id="contact-message-hint" class="contact-field-hint"></span>
                  </div>
                </div>

                <button type="submit" class="contact-submit">Send Message</button>

                <p id="contact-status" class="contact-status" role="status" aria-live="polite"></p>

              </form>
            </div>

          </div>
        </div>
      </div>
    </section>

  </main>

  <script is:inline>
    (function () {
      var form      = document.getElementById('contact-form');
      var submitBtn = form.querySelector('button[type="submit"]');
      var status    = document.getElementById('contact-status');

      // ── Per-field validation (kit's .input-error/.input-success states) ──
      var fields = [
        {
          input: document.getElementById('contact-name'),
          hint:  document.getElementById('contact-name-hint'),
          messages: { empty: 'Enter your name' },
        },
        {
          input: document.getElementById('contact-email'),
          hint:  document.getElementById('contact-email-hint'),
          messages: { empty: 'Enter your email address', invalid: 'Enter a valid email address' },
        },
        {
          input: document.getElementById('contact-message'),
          hint:  document.getElementById('contact-message-hint'),
          messages: { empty: 'Tell me about your project' },
        },
      ];

      function validateField(field) {
        var input = field.input;
        var valid = input.checkValidity();
        if (valid) {
          input.classList.remove('input-error');
          input.classList.add('input-success');
          input.setAttribute('aria-invalid', 'false');
          field.hint.textContent = '';
          field.hint.classList.remove('error');
        } else {
          input.classList.remove('input-success');
          input.classList.add('input-error');
          input.setAttribute('aria-invalid', 'true');
          field.hint.textContent = input.validity.valueMissing
            ? field.messages.empty
            : (field.messages.invalid || field.messages.empty);
          field.hint.classList.add('error');
        }
        return valid;
      }

      fields.forEach(function (field) {
        // First pass on blur — don't flag anything before the visitor has
        // actually left the field once.
        field.input.addEventListener('blur', function () { validateField(field); });
        // Once a field has been flagged, re-check live as they type so the
        // error clears the moment it's fixed instead of waiting for another blur.
        field.input.addEventListener('input', function () {
          if (field.input.classList.contains('input-error')) validateField(field);
        });
      });

      function resetFieldStates() {
        fields.forEach(function (field) {
          field.input.classList.remove('input-success', 'input-error');
          field.input.setAttribute('aria-invalid', 'false');
          field.hint.textContent = '';
          field.hint.classList.remove('error');
        });
      }

      form.addEventListener('submit', async function (e) {
        e.preventDefault();

        var results = fields.map(validateField);
        var firstInvalidIndex = results.indexOf(false);
        if (firstInvalidIndex !== -1) {
          fields[firstInvalidIndex].input.focus();
          return;
        }

        var formData = new FormData(form);
        formData.append('access_key', '9eed3f9e-06a2-44b5-8691-423fe0a83b33');

        var senderName = (formData.get('name') || '').toString().trim();
        formData.set('subject', senderName ? 'Project inquiry from ' + senderName : 'New project inquiry — andrewthyip.com');

        var originalText = submitBtn.textContent;

        submitBtn.textContent = 'Sending...';
        submitBtn.disabled = true;
        status.textContent = '';
        status.classList.remove('is-success', 'is-error');

        try {
          var response = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            body: formData
          });

          var data = await response.json();

          if (response.ok) {
            status.textContent = 'Thanks — your message has been sent. I’ll reply as soon as I can.';
            status.classList.add('is-success');
            form.reset();
            resetFieldStates();
          } else {
            status.textContent = 'Error: ' + (data.message || 'something went wrong. Please try again.');
            status.classList.add('is-error');
          }
        } catch (error) {
          status.textContent = 'Something went wrong. Please try again.';
          status.classList.add('is-error');
        } finally {
          submitBtn.textContent = originalText;
          submitBtn.disabled = false;
        }
      });
    })();
  </script>
</BaseLayout>

<style>
  /* ── Two-column split ──────────────────── */
  .contact {
    display:               grid;
    grid-template-columns: 1fr 1.2fr;
    align-items:           center;
    gap:                   clamp(32px, 5.5vw, 80px);
    min-height:            60vh;
  }

  /* ── Intro (left) ──────────────────────── */
  .contact-title {
    font-family:    var(--font-display);
    font-size:      clamp(49px, 6.5vw, 88px);
    font-weight:    400;
    color:          var(--text-1);
    letter-spacing: -0.02em;
    line-height:    1.1;
    max-width:      14ch;
    margin-bottom:  clamp(32px, 5.5vw, 80px);
    text-wrap:      balance;
  }

  .contact-guide p + ul,
  .contact-guide ul + p {
    margin-top: var(--space-sm);
  }

  .contact-guide-list {
    list-style: none;
  }

  .contact-guide-list li::before {
    content:      '\2022';
    color:        var(--text-2);
    margin-right: 8px;
  }

  /* ── Form card (right) ─────────────────── */
  .contact-card {
    background:    var(--surface);
    border:        0.5px solid var(--border);
    border-radius: var(--r-lg);
    padding:       clamp(24px, 2.8vw, 40px);
  }

  .contact-form-grid {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(12px, 1.7vw, 24px);
  }

  .contact-field {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-xs);
  }

  .contact-field-full {
    grid-column: 1 / -1;
  }

  .contact-label {
    font-family:    var(--font-body);
    font-size:      11px;
    font-weight:    500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color:          var(--text-2);
  }

  .contact-input {
    font-family:   var(--font-body);
    font-size:     15px;
    font-weight:   300;
    line-height:   1.6;
    color:         var(--text-1);
    background:    var(--bg-2);
    border:        0.5px solid var(--border);
    border-radius: var(--r-md);
    padding:       10px 14px;
    width:         100%;
    transition:    border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }

  .contact-input::placeholder {
    color: var(--text-3);
  }

  /* Autofill (Chrome/Edge/Safari) ignores background — override via inset shadow */
  .contact-input:-webkit-autofill,
  .contact-input:-webkit-autofill:hover,
  .contact-input:-webkit-autofill:focus {
    -webkit-box-shadow: 0 0 0 1000px var(--bg-2) inset;
    box-shadow:         0 0 0 1000px var(--bg-2) inset;
    -webkit-text-fill-color: var(--text-1);
    caret-color:             var(--text-1);
    transition: background-color 9999s var(--ease) 0s;
  }

  .contact-input:hover {
    border-color: var(--border-2);
  }

  .contact-input:focus-visible {
    outline:      none;
    border-color: var(--accent);
    box-shadow:   var(--neon-sm);
  }

  .contact-textarea {
    resize:     vertical;
    min-height: 120px;
  }

  /* ── Validation states (kit §06 Form Inputs) ───── */
  .contact-input.input-error {
    border-color: var(--danger);
  }

  .contact-input.input-error:focus-visible {
    border-color: var(--danger);
    box-shadow:   0 0 8px var(--danger), 0 0 20px color-mix(in srgb, var(--danger) 30%, transparent);
  }

  .contact-input.input-success {
    border-color: var(--success);
  }

  .contact-field-hint {
    font-family: var(--font-body);
    font-size:   11px;
    color:       var(--text-2);
  }

  .contact-field-hint.error {
    color: var(--danger);
  }

  /* Honeypot — visually removed, still submittable */
  .contact-botcheck {
    position:       absolute;
    width:          1px;
    height:         1px;
    opacity:        0;
    pointer-events: none;
  }

  /* ── Submit ────────────────────────────── */
  .contact-submit {
    font-family:    var(--font-body);
    font-size:      12px;
    font-weight:    500;
    letter-spacing: 0.02em;
    color:          var(--accent-text);
    background:     transparent;
    border:         0.5px solid var(--accent);
    border-radius:  var(--r-sm);
    padding:        10px 20px;
    margin-top:     var(--space-sm);
    cursor:         pointer;
    transition:     background 0.2s var(--ease), box-shadow 0.2s var(--ease), transform 0.1s var(--ease);
  }

  .contact-submit:hover,
  .contact-submit:focus-visible {
    background: var(--accent-dim);
    box-shadow: var(--neon-sm);
  }

  .contact-submit:focus-visible {
    outline:        1px solid var(--accent);
    outline-offset: 2px;
  }

  .contact-submit:active { transform: scale(0.96); }

  .contact-submit:disabled {
    opacity: 0.6;
    cursor:  default;
  }

  /* ── Status line ───────────────────────── */
  .contact-status {
    font-family: var(--font-body);
    font-size:   12px;
    font-weight: 400;
    margin-top:  var(--space-xs);
  }

  .contact-status.is-success { color: var(--success); }
  .contact-status.is-error   { color: var(--danger); }

  /* ── Responsive ────────────────────────── */
  @media (max-width: 1024px) {
    .contact {
      grid-template-columns: 1fr;
      align-items:           start;
      min-height:            0;
    }

    .contact-title { margin-bottom: var(--space-md); }
  }

  @media (max-width: 520px) {
    .contact-form-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
