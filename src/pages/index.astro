---
import BaseLayout from '../layouts/base-layout.astro';
import '../styles/index.css';
---

<BaseLayout title="Andrew YIP" world="dark">
  <main class="main">

    <!-- ── Brief Intro ────────────────────────── -->
    <section>
      <div class="padding-global">
        <div class="container-main">
          <div class="intro-content">

            <div class="intro-header">
              <p class="intro-name">Andrew YIP</p>
              <div class="intro-meta">
                <span class="intro-role">UX/UI Designer</span>
                <div class="intro-location">
                  <span class="intro-location-dot"></span>
                  <span class="intro-location-label">BC · Canada</span>
                </div>
              </div>
            </div>

            <div class="intro-logos">
              <img class="intro-logo-item" src="/images/Delta%20Controls.svg" alt="Delta Controls" />
              <img class="intro-logo-item" src="/images/Rosamary%20Diamond.svg" alt="Rosemary Diamond" />
              <img class="intro-logo-item" src="/images/Blu%20bathworks.svg" alt="Blu Bathworks" />
              <img class="intro-logo-item" src="/images/Yocale%20AI.svg" alt="Yocale AI" />
              <img class="intro-logo-item" src="/images/RKW%20Communications.svg" alt="RKW Communications" />
              <img class="intro-logo-item" src="/images/ANT%20Rentals.svg" alt="ANT Rentals" />
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- ── Work: Yocale ─────────────────────── -->
    <section>
      <div class="padding-global">
        <div class="container-main">
          <div class="work-featured">

            <div class="work-featured-info">
              <div class="work-featured-text">
                <h2 class="work-featured-title">Yocale</h2>
                <p class="work-featured-desc">Yocale is an all-in-one business management and client scheduling software designed for appointment-based businesses.</p>
              </div>
              <a href="/work/yocale" class="work-featured-link">
                Read the case study →
              </a>
            </div>

            <div class="work-featured-visual">
              <!-- Replace with final asset: public/images/yocale-preview.png -->
              <img
                src="/images/yocale-preview.png"
                alt="Yocale dashboard — booking management interface"
                class="work-featured-img"
                loading="lazy"
              />
            </div>

          </div>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
