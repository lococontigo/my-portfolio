---
import BaseLayout from '../layouts/base-layout.astro';
---

<BaseLayout title="Andrew YIP" world="dark">
  <main class="main">

    <!-- ── Brief Intro ────────────────────────── -->
    <section>
      <div class="padding-global">
        <div class="container-main">
          <div class="intro-content">

            <div class="intro-header">
              <p class="intro-name">Andrew YIP</p>
              <div class="intro-meta">
                <span class="intro-role">UX/UI Designer</span>
                <div class="intro-location">
                  <span class="intro-location-dot"></span>
                  <span class="intro-location-label">BC · Canada</span>
                </div>
              </div>
            </div>

            <div class="intro-logos">
              <img class="intro-logo-item" src="/images/Delta%20Controls.svg" alt="Delta Controls" />
              <img class="intro-logo-item" src="/images/Rosamary%20Diamond.svg" alt="Rosemary Diamond" />
              <img class="intro-logo-item" src="/images/Blu%20bathworks.svg" alt="Blu Bathworks" />
              <img class="intro-logo-item" src="/images/Yocale%20AI.svg" alt="Yocale AI" />
              <img class="intro-logo-item" src="/images/RKW%20Communications.svg" alt="RKW Communications" />
              <img class="intro-logo-item" src="/images/ANT%20Rentals.svg" alt="ANT Rentals" />
            </div>

          </div>
        </div>
      </div>
    </section>



  </main>
</BaseLayout>

<style>
  .main {
    padding-top: 96px;
    min-height:  100vh;
  }

  @media (max-width: 768px) { .main { padding-top: 80px; } }
  @media (max-width: 520px) { .main { padding-top: 72px; } }

  /* ── Intro section ───────────────────────── */
  .intro-content {
    display:        flex;
    flex-direction: column;
    gap:            80px;
  }

  .intro-name {
    font-family:    var(--font-display);
    font-size:      clamp(44px, 5.5vw, 75px);
    font-weight:    400;
    line-height:    1.2;
    letter-spacing: -0.28px;
    color:          var(--text-1);
  }

  .intro-meta {
    display:     flex;
    align-items: center;
    gap:         8px;
    margin-top:  16px;
  }

  .intro-role {
    font-family: var(--font-body);
    font-size:   clamp(18px, 2vw, 26px);
    font-weight: 400;
    color:       var(--text-1);
  }

  .intro-location {
    display:       flex;
    align-items:   center;
    gap:           5px;
    padding:       4px 11px;
    background:    rgba(239, 159, 39, 0.1);
    border:        1px solid rgba(239, 159, 39, 0.25);
    border-radius: var(--r-pill);
  }

  .intro-location-dot {
    display:       block;
    width:         5px;
    height:        5px;
    border-radius: 2.5px;
    background:    var(--accent);
    flex-shrink:   0;
  }

  .intro-location-label {
    font-family:    var(--font-body);
    font-size:      11px;
    font-weight:    400;
    color:          var(--accent);
    letter-spacing: 0.33px;
    white-space:    nowrap;
  }

  .intro-logos {
    display:         flex;
    align-items:     center;
    justify-content: space-between;
  }

  .intro-logo-item {
    width:       176px;
    height:      100px;
    flex-shrink: 1;
    object-fit:  contain;
    display:     block;
  }

  @media (max-width: 768px) {
    .intro-content { gap: 48px; }
    .intro-logos   { justify-content: flex-start; flex-wrap: wrap; gap: 16px; }
    .intro-logo-item { width: 140px; height: 80px; flex-shrink: 0; }
  }

  @media (max-width: 520px) {
    .intro-content   { gap: 32px; }
    .intro-logo-item { width: calc(50% - 8px); height: 72px; }
  }

  /* ── Hero section ────────────────────────── */
  .t-display em {
    font-style: italic;
    color:      var(--accent);
  }
</style>
