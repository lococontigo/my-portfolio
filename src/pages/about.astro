---
import BaseLayout from '../layouts/base-layout.astro';
import Timeline from '../components/timeline.astro';
import Testimonials from '../components/testimonials.astro';
---

<BaseLayout title="About" world="dark" description="Andrew Yip is a UX/UI designer and developer based in Vancouver, BC. He specialises in product design, design systems, and web development for SaaS companies." translated={true}>
  <script slot="head" is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "About Andrew Yip",
    "url": "https://andrewthyip.com/about/",
    "about": { "@id": "https://andrewthyip.com/#person" }
  }
  </script>

  <main class="main">

    <!-- ── Section 1: Split — photo + bio (left) / Design Journey (right) ── -->
    <section class="about-section">
      <div class="padding-global">
        <div class="container-main">
          <div class="about-split">

            <div class="about-left">
              <div class="about-bio">
                <div class="about-photo-wrap">
                  <img
                    src="/images/andrew-yip-designer-photo.webp"
                    alt="Andrew Yip, UX/UI Designer"
                    class="about-photo"
                    width="464"
                    height="490"
                    fetchpriority="high"
                  />
                </div>
                <h1 class="about-name">About Andrew</h1>

                <p>I come from Hong Kong, a concrete city often known for its fast-paced lifestyle. My design career commenced in Canada, where I started a postgraduate program focused on design and development.</p>
                <p>Since then, I've been actively involved in the design field. At first, I volunteered to design for a UX community. After that, I put my skills to use by freelancing for a variety of businesses in British Columbia.</p>

                <h2 class="about-subheading">Work Philosophy</h2>
                <p>As a designer, I believe the nature of design is problem solving rather than just make things pretty.</p>
                <p>My job is to bridge design thinking and technical execution to deliver user-centric solutions that drive measurable business outcomes.</p>

                <h2 class="about-subheading">Personal Facts</h2>
                <ul class="about-facts">
                  <li>I speak English, Mandarin, Cantonese, and a bit of Spanish.</li>
                  <li>I am a fan of WONG KAR WAI movies.</li>
                  <li>I developed this portfolio using Astro, feel free to inspect.</li>
                </ul>

                <div class="about-tags">
                  <span class="about-tag">UX/UI Design</span>
                  <span class="about-tag">UX Research</span>
                  <span class="about-tag">User Testing</span>
                  <span class="about-tag">Technical SEO</span>
                  <span class="about-tag">Wireframing</span>
                  <span class="about-tag">UI Animation</span>
                  <span class="about-tag">Figma</span>
                  <span class="about-tag">Adobe Creative Suite</span>
                  <span class="about-tag">HTML</span>
                  <span class="about-tag">CSS</span>
                  <span class="about-tag">JavaScript</span>
                  <span class="about-tag">PHP</span>
                  <span class="about-tag">CMS</span>
                  <span class="about-tag">Prompt Engineering</span>
                </div>
              </div>
            </div>

            <div class="about-right">
              <h2 class="about-journey-heading">Design Journey</h2>
              <Timeline />
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- ── Section 2: CTA (left) + Testimonials (right) ── -->
    <section class="about-section">
      <div class="padding-global">
        <div class="container-main">
          <div class="about-split">

            <div class="about-cta">
              <h2 class="about-cta-heading">Let's build something great together!</h2>
              <div class="about-cta-actions">
                <a
                  href="https://www.linkedin.com/in/andrewthyip/"
                  class="about-btn-outline"
                  target="_blank"
                  rel="noopener noreferrer"
                >Connect on LinkedIn</a>
                <a href="mailto:andrewthyip@gmail.com" class="about-btn-accent">Say Hello</a>
              </div>
            </div>

            <div class="about-testi">
              <h2 class="about-testi-heading">Testimonials</h2>
              <div class="about-testi-box">
                <Testimonials />
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  /* ── Split hero layout ──────────────────────── */
  .about-section {
    padding-block: 0;
  }

  .about-split {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    background:            linear-gradient(90deg, transparent 50%, var(--bg-2) 50%);
  }

  .about-left {
    border-right: 0.5px solid var(--border);
    padding:      var(--space-xl) var(--space-md);
  }

  .about-photo-wrap {
    display:         flex;
    justify-content: center;
    overflow:        hidden;
    border-radius:   var(--r-md);
    margin-bottom:   var(--space-lg);
  }

  .about-photo {
    width:     auto;
    max-width: 100%;
    height:    auto;
    display:   block;
  }

  .about-right {
    padding:         var(--space-xl) var(--space-md);
    background:      var(--bg-2);
    position:        sticky;
    top:             0;
    height:          100vh;
    height:          100dvh;
    display:         flex;
    flex-direction:  column;
    justify-content: center;
    align-self:      start;
    overflow:        hidden;
  }

  /* ── Left column — typography ───────────────── */
  .about-name {
    font-family:    var(--font-display);
    font-size:      clamp(49px, 5.5vw, 76px);
    font-weight:    400;
    color:          var(--text-1);
    letter-spacing: -0.02em;
    margin-bottom:  var(--space-sm);
    text-wrap:      balance;
  }

  .about-bio p {
    font-family:   var(--font-body);
    font-size:     16px;
    font-weight:   300;
    color:         var(--text-2);
    line-height:   1.65;
    margin-bottom: var(--space-xs);
    text-wrap:     pretty;
  }

  .about-subheading {
    font-family:    var(--font-display);
    font-size:      39px;
    font-weight:    400;
    color:          var(--text-1);
    margin-top:     var(--space-md);
    margin-bottom:  8px;
    letter-spacing: -0.01em;
    text-wrap:      balance;
  }

  /* ── Facts list ─────────────────────────────── */
  .about-facts {
    list-style:     disc;
    padding-left:   var(--space-sm);
    display:        flex;
    flex-direction: column;
    gap:            4px;
  }

  .about-facts li {
    font-family: var(--font-body);
    font-size:   15px;
    font-weight: 300;
    color:       var(--text-2);
    line-height: 1.5;
    text-wrap:   pretty;
  }

  /* ── Skill tags ─────────────────────────────── */
  .about-tags {
    display:    flex;
    flex-wrap:  wrap;
    gap:        12px;
    margin-top: var(--space-md);
  }

  .about-tag {
    display:        inline-flex;
    align-items:    center;
    padding:        4px 10px;
    border-radius:  var(--r-pill);
    font-family:    var(--font-body);
    font-size:      12px;
    font-weight:    500;
    letter-spacing: 0.03em;
    color:          var(--text-2);
    background:     var(--bg-2);
    border:         0.5px solid var(--border);
    transition:     color 0.2s var(--ease), border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
    cursor:         pointer;
  }

  .about-tag:hover {
    color:        var(--accent-text);
    border-color: var(--accent);
    box-shadow:   var(--neon-sm);
  }

  /* ── Right column — Design Journey ─────────── */
  .about-journey-heading {
    font-family:    var(--font-display);
    font-size:      clamp(39px, 3.8vw, 49px);
    font-weight:    300;
    color:          var(--text-1);
    letter-spacing: -0.02em;
    margin-bottom:  clamp(32px, 5.5vw, 80px);
    text-wrap:      balance;
  }

  /* ── Bottom section — CTA + Testimonials ────── */
  .about-cta {
    display:         flex;
    flex-direction:  column;
    justify-content: center;
    background:      var(--bg-2);
    padding:         var(--space-xl) var(--space-md);
    border-right:    0.5px solid var(--border);
  }

  .about-testi {
    padding:    var(--space-xl) var(--space-md);
    background: var(--bg);
  }

  .about-cta-heading {
    font-family:    var(--font-display);
    font-size:      clamp(49px, 5.5vw, 76px);
    font-weight:    400;
    color:          var(--text-1);
    letter-spacing: -0.02em;
    line-height:    1.1;
    margin-bottom:  var(--space-md);
    text-wrap:      balance;
  }

  .about-cta-actions {
    display:    flex;
    gap:        var(--space-xs);
    flex-wrap:  wrap;
    align-self: flex-start;
  }

  .about-btn-outline {
    font-family:   var(--font-body);
    font-size:     16px;
    font-weight:   400;
    color:         var(--text-1);
    border:        0.5px solid var(--border-2);
    border-radius: var(--r-sm);
    padding:       10px 28px;
    transition:    border-color 0.25s var(--ease), transform 0.1s var(--ease);
  }

  .about-btn-outline:hover  { border-color: var(--text-1); }
  .about-btn-outline:active { transform: scale(0.96); }

  .about-btn-accent {
    font-family:   var(--font-body);
    font-size:     16px;
    font-weight:   400;
    color:         var(--accent-text);
    border:        0.5px solid var(--accent);
    border-radius: var(--r-sm);
    padding:       10px 28px;
    transition:    background 0.25s var(--ease), box-shadow 0.25s var(--ease), transform 0.1s var(--ease);
  }

  .about-btn-accent:hover  { background: var(--accent-dim); box-shadow: var(--neon-sm); }
  .about-btn-accent:active { transform: scale(0.96); }

  .about-testi-heading {
    font-family:    var(--font-display);
    font-size:      clamp(39px, 3.8vw, 49px);
    font-weight:    300;
    color:          var(--text-1);
    letter-spacing: -0.02em;
    margin-bottom:  var(--space-md);
    text-wrap:      balance;
  }

  .about-testi-box {
    border:        0.5px solid var(--border);
    border-radius: var(--r-lg);
    padding:       var(--space-md) var(--space-sm);
  }

  /* ── About responsive ───────────────────────── */
  @media (max-width: 1024px) {
    .about-left  { padding: var(--space-md) var(--space-sm); }
    .about-right { padding: var(--space-lg) var(--space-sm); }
  }

  @media (max-width: 768px) {
    .about-split               { grid-template-columns: 1fr; background: none; }
    .about-left, .about-cta   { border-right: none; border-bottom: 0.5px solid var(--border); }
    .about-right               { position: static; height: auto; }
    .about-testi               { order: -1; }
  }

  @media (max-width: 520px) {
    .about-left         { padding: var(--space-md) var(--space-xs); }
    .about-right        { padding: var(--space-md) var(--space-xs); }
    .about-photo-wrap   { aspect-ratio: 1 / 1; }
  }
</style>
