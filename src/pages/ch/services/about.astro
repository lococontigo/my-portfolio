---
import BaseLayout from '../../../layouts/base-layout.astro';
import Timeline from '../../../components/timeline.astro';
import Testimonials from '../../../components/testimonials.astro';

const zhTimelineItems = [
  {
    year:  '2022',
    title: '抵達',
    emphasis: '加拿大',
    desc:  '落腳溫哥華,踏入新半球,展開新一章。',
  },
  {
    year:  '2022',
    title: 'WMDD 課程',
    desc:  '於 Langara College 修讀網頁及手機應用程式設計與開發深造課程。',
  },
  {
    year:  '2022',
    title: '自由接案項目',
    desc:  '為 RKWINC 及 BLU-BATH 主導開發客製化 WordPress 及電商方案,成功遷移超過 2,000 個項目,並帶動轉換率提升 25%。',
  },
  {
    year:  '2023',
    title: 'Ant Equipment Group',
    desc:  '透過策略性 CMS 整合及主頁重新設計,優化 ANT EQUIPMENT GROUP 的網頁平台,帶動流量提升 36.7%,每月網上訂單增長 4 至 6 倍。',
  },
  {
    year:  '2024',
    title: 'Delta Controls',
    desc:  '為 Delta Intelligent Building Technologies 設計並開發全新內部資源平台及客製化 CRM 方案,運用 Figma 及 WordPress,將用戶參與度提升 15%。',
  },
  {
    year:  '2025',
    title: 'Yocale AI',
    desc:  '為 Yocale 四次重大產品發佈推出功能頁面,建立可擴展的 Figma/Webflow 元件庫,並優化 Google Ads 着陸頁面,達致 5.15% 點擊率。',
  },
  {
    year:  'Now',
    title: '積極尋求新',
    emphasis: '機會!',
    desc:  '在 AI 時代建構用戶體驗。',
    current: true,
  },
];
---

<BaseLayout title="關於我" world="light" navVariant="services" translated={true} description="認識 Andrew Yip —— 這個網站背後的 UX/UI 設計師及開發者,現居加拿大卑詩省溫哥華,專注於產品設計及 SaaS 網頁開發。">
  <script slot="head" is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Andrew Yip",
    "jobTitle": "UX/UI 設計師及開發者",
    "url": "https://andrewthyip.com",
    "image": "https://andrewthyip.com/images/andrew-yip-designer-photo.webp",
    "sameAs": ["https://www.linkedin.com/in/andrewthyip/"],
    "alumniOf": { "@type": "EducationalOrganization", "name": "Langara College" },
    "inLanguage": "zh-Hant"
  }
  </script>
  <script slot="head" is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Testimonials for Andrew Yip",
    "itemListElement": [
      {
        "@type": "ListItem", "position": 1,
        "item": {
          "@type": "Review",
          "reviewBody": "I found Andrew's understanding of user experience design for web combined with his relentless drive to find and implement viable solutions to achieve positive outcomes were amongst his strongest assets and talents. I strongly recommend Andrew to any potential employers or contractors needing web management or any type of UX web skills on their team as I find him to be highly reliable and very skilled in his craft.",
          "author": { "@type": "Person", "name": "Allan Lanzador", "jobTitle": "Director of Marketing", "worksFor": { "@type": "Organization", "name": "Delta Controls Inc." } },
          "itemReviewed": { "@type": "ProfessionalService", "name": "Andrew Yip — UX/UI Design & Development", "url": "https://andrewthyip.com" }
        }
      },
      {
        "@type": "ListItem", "position": 2,
        "item": {
          "@type": "Review",
          "reviewBody": "Whether you are looking for a UX/UI designer or a promising project manager, he would bring an extraordinary level of experience, passion and leadership to any position. Given the chance, Andrew would undoubtedly be an excellent addition to any team.",
          "author": { "@type": "Person", "name": "Aurelio Selman", "jobTitle": "Web Development Specialist" },
          "itemReviewed": { "@type": "ProfessionalService", "name": "Andrew Yip — UX/UI Design & Development", "url": "https://andrewthyip.com" }
        }
      },
      {
        "@type": "ListItem", "position": 3,
        "item": {
          "@type": "Review",
          "reviewBody": "Andrew has exceptional project management and design thinking skills. His strong organizational skills and ability to delegate tasks effectively helped us stay focused and productive throughout the project.",
          "author": { "@type": "Person", "name": "Ana Rodriguez", "jobTitle": "Senior Graphic Designer" },
          "itemReviewed": { "@type": "ProfessionalService", "name": "Andrew Yip — UX/UI Design & Development", "url": "https://andrewthyip.com" }
        }
      },
      {
        "@type": "ListItem", "position": 4,
        "item": {
          "@type": "Review",
          "reviewBody": "Andrew values punctuality and organization. He has a reputation for fulfilling his commitments in a timely manner. Andrew will thrive in the most complex of challenges, and he would be a valuable addition to any organization requiring his skillset.",
          "author": { "@type": "Person", "name": "Winall Lopes", "jobTitle": "Senior SAP Consultant", "worksFor": { "@type": "Organization", "name": "IBM" } },
          "itemReviewed": { "@type": "ProfessionalService", "name": "Andrew Yip — UX/UI Design & Development", "url": "https://andrewthyip.com" }
        }
      },
      {
        "@type": "ListItem", "position": 5,
        "item": {
          "@type": "Review",
          "reviewBody": "Andrew has a unique combination of creativity and strategic thinking that sets him apart from other designers. He has a deep understanding of user needs and always delivers designs that meet those needs.",
          "author": { "@type": "Person", "name": "Florida Joca", "jobTitle": "Software Developer" },
          "itemReviewed": { "@type": "ProfessionalService", "name": "Andrew Yip — UX/UI Design & Development", "url": "https://andrewthyip.com" }
        }
      },
      {
        "@type": "ListItem", "position": 6,
        "item": {
          "@type": "Review",
          "reviewBody": "We got our website made from Andrew and he designed it really well. Thanks to his services we were able to bring our business online and get more clients.",
          "author": { "@type": "Organization", "name": "Khachak Studio" },
          "itemReviewed": { "@type": "ProfessionalService", "name": "Andrew Yip — UX/UI Design & Development", "url": "https://andrewthyip.com" }
        }
      }
    ]
  }
  </script>

  <main class="main">

    <!-- ── Section 1: Split — photo + bio (left) / Design Journey (right) ── -->
    <section class="about-section">
      <div class="padding-global">
        <div class="container-main">
          <div class="about-split">

            <div class="about-left">
              <div class="about-bio">
                <div class="about-photo-wrap">
                  <img
                    src="/images/self-image-light.webp"
                    alt="Andrew Yip, UX/UI 設計師"
                    class="about-photo"
                    width="464"
                    height="490"
                    fetchpriority="high"
                  />
                </div>
                <h1 class="about-name">關於 Andrew</h1>

                <p>我來自香港 —— 一座以急促生活節奏聞名的石屎森林。我的設計事業始於加拿大,在當地修讀了一個專注於設計與開發的深造課程。</p>
                <p>自此,我一直積極參與設計工作。起初,我為一個 UX 社群擔任義務設計師;其後,我開始為卑詩省多間企業提供自由接案設計服務。</p>

                <h2 class="about-subheading">工作理念</h2>
                <p>作為設計師,我相信設計的本質是解決問題,而不只是把東西做得好看。</p>
                <p>我的工作是連結設計思維與技術執行,提供以用戶為本的方案,帶來實際可量度的業務成效。</p>

                <h2 class="about-subheading">個人趣事</h2>
                <ul class="about-facts">
                  <li>我懂英語、普通話、廣東話,還有一點西班牙文。</li>
                  <li>我是王家衛電影的忠實影迷。</li>
                  <li>這個作品集網站是我用 Astro 開發的,歡迎查閱原始碼。</li>
                </ul>

                <div class="about-tags">
                  <span class="about-tag">UX/UI 設計</span>
                  <span class="about-tag">UX 研究</span>
                  <span class="about-tag">用戶測試</span>
                  <span class="about-tag">技術性 SEO</span>
                  <span class="about-tag">線框設計</span>
                  <span class="about-tag">UI 動畫</span>
                  <span class="about-tag">Figma</span>
                  <span class="about-tag">Adobe Creative Suite</span>
                  <span class="about-tag">HTML</span>
                  <span class="about-tag">CSS</span>
                  <span class="about-tag">JavaScript</span>
                  <span class="about-tag">PHP</span>
                  <span class="about-tag">CMS</span>
                  <span class="about-tag">Prompt Engineering</span>
                </div>
              </div>
            </div>

            <div class="about-right">
              <h2 class="about-journey-heading">設計旅程</h2>
              <Timeline items={zhTimelineItems} />
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- ── Section 2: CTA (left) + Testimonials (right) ── -->
    <section class="about-section">
      <div class="padding-global">
        <div class="container-main">
          <div class="about-split">

            <div class="about-cta">
              <h2 class="about-cta-heading">讓我們一起打造出色的作品!</h2>
              <div class="about-cta-actions">
                <a
                  href="https://www.linkedin.com/in/andrewthyip/"
                  class="about-btn-outline"
                  target="_blank"
                  rel="noopener noreferrer"
                >透過 LinkedIn 聯繫</a>
                <a href="/ch/services/contact/" class="about-btn-accent">聯絡我</a>
              </div>
            </div>

            <div class="about-testi">
              <h2 class="about-testi-heading">客戶評價</h2>
              <div class="about-testi-box">
                <Testimonials prevLabel="上一則" nextLabel="下一則" slideLabel={(n: number) => `第 ${n} 則`} />
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  /* ── Split hero layout ──────────────────────── */
  .about-section {
    padding-block: 0;
  }

  .about-split {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    background:            linear-gradient(90deg, transparent 50%, var(--bg-2) 50%);
  }

  .about-left {
    border-right: 0.5px solid var(--border);
    padding:      var(--space-xl) var(--space-md);
  }

  .about-photo-wrap {
    display:         flex;
    justify-content: center;
    overflow:        hidden;
    border-radius:   var(--r-md);
    margin-bottom:   var(--space-lg);
  }

  .about-photo {
    width:     auto;
    max-width: 100%;
    height:    auto;
    display:   block;
  }

  .about-right {
    padding:         var(--space-xl) var(--space-md);
    background:      var(--bg-2);
    position:        sticky;
    top:             0;
    height:          100vh;
    height:          100dvh;
    display:         flex;
    flex-direction:  column;
    justify-content: center;
    align-self:      start;
    overflow:        hidden;
  }

  /* ── Left column — typography ───────────────── */
  .about-name {
    font-family:    var(--font-display);
    font-size:      clamp(49px, 5.5vw, 76px);
    font-weight:    400;
    color:          var(--text-1);
    letter-spacing: -0.02em;
    margin-bottom:  var(--space-sm);
    text-wrap:      balance;
  }

  .about-bio p {
    font-family:   var(--font-body);
    font-size:     16px;
    font-weight:   300;
    color:         var(--text-2);
    line-height:   1.65;
    margin-bottom: var(--space-xs);
    text-wrap:     pretty;
  }

  .about-subheading {
    font-family:    var(--font-display);
    font-size:      39px;
    font-weight:    400;
    color:          var(--text-1);
    margin-top:     var(--space-md);
    margin-bottom:  8px;
    letter-spacing: -0.01em;
    text-wrap:      balance;
  }

  /* ── Facts list ─────────────────────────────── */
  .about-facts {
    list-style:     disc;
    padding-left:   var(--space-sm);
    display:        flex;
    flex-direction: column;
    gap:            4px;
  }

  .about-facts li {
    font-family: var(--font-body);
    font-size:   15px;
    font-weight: 300;
    color:       var(--text-2);
    line-height: 1.5;
    text-wrap:   pretty;
  }

  /* ── Skill tags ─────────────────────────────── */
  .about-tags {
    display:    flex;
    flex-wrap:  wrap;
    gap:        12px;
    margin-top: var(--space-md);
  }

  .about-tag {
    display:        inline-flex;
    align-items:    center;
    padding:        4px 10px;
    border-radius:  var(--r-pill);
    font-family:    var(--font-body);
    font-size:      12px;
    font-weight:    500;
    letter-spacing: 0.03em;
    color:          var(--text-2);
    background:     var(--bg-2);
    border:         0.5px solid var(--border);
    transition:     color 0.2s var(--ease), border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
    cursor:         pointer;
  }

  .about-tag:hover {
    color:        var(--accent-text);
    border-color: var(--accent);
    box-shadow:   var(--neon-sm);
  }

  /* ── Right column — Design Journey ─────────── */
  .about-journey-heading {
    font-family:    var(--font-display);
    font-size:      clamp(39px, 3.8vw, 49px);
    font-weight:    300;
    color:          var(--text-1);
    letter-spacing: -0.02em;
    margin-bottom:  clamp(32px, 5.5vw, 80px);
    text-wrap:      balance;
  }

  /* ── Bottom section — CTA + Testimonials ────── */
  .about-cta {
    display:         flex;
    flex-direction:  column;
    justify-content: center;
    background:      var(--bg-2);
    padding:         var(--space-xl) var(--space-md);
    border-right:    0.5px solid var(--border);
  }

  .about-testi {
    padding:    var(--space-xl) var(--space-md);
    background: var(--bg);
  }

  .about-cta-heading {
    font-family:    var(--font-display);
    font-size:      clamp(49px, 5.5vw, 76px);
    font-weight:    400;
    color:          var(--text-1);
    letter-spacing: -0.02em;
    line-height:    1.1;
    margin-bottom:  var(--space-md);
    text-wrap:      balance;
  }

  .about-cta-actions {
    display:    flex;
    gap:        var(--space-xs);
    flex-wrap:  wrap;
    align-self: flex-start;
  }

  .about-btn-outline {
    font-family:   var(--font-body);
    font-size:     16px;
    font-weight:   400;
    color:         var(--text-1);
    border:        0.5px solid var(--border-2);
    border-radius: var(--r-sm);
    padding:       10px 28px;
    transition:    border-color 0.25s var(--ease), transform 0.1s var(--ease);
  }

  .about-btn-outline:hover  { border-color: var(--text-1); }
  .about-btn-outline:active { transform: scale(0.96); }

  .about-btn-accent {
    font-family:   var(--font-body);
    font-size:     16px;
    font-weight:   400;
    color:         var(--accent-text);
    border:        0.5px solid var(--accent);
    border-radius: var(--r-sm);
    padding:       10px 28px;
    transition:    background 0.25s var(--ease), box-shadow 0.25s var(--ease), transform 0.1s var(--ease);
  }

  .about-btn-accent:hover  { background: var(--accent-dim); box-shadow: var(--neon-sm); }
  .about-btn-accent:active { transform: scale(0.96); }

  .about-testi-heading {
    font-family:    var(--font-display);
    font-size:      clamp(39px, 3.8vw, 49px);
    font-weight:    300;
    color:          var(--text-1);
    letter-spacing: -0.02em;
    margin-bottom:  var(--space-md);
    text-wrap:      balance;
  }

  .about-testi-box {
    border:        0.5px solid var(--border);
    border-radius: var(--r-lg);
    padding:       var(--space-md) var(--space-sm);
  }

  /* ── About responsive ───────────────────────── */
  @media (max-width: 1024px) {
    .about-left  { padding: var(--space-md) var(--space-sm); }
    .about-right { padding: var(--space-lg) var(--space-sm); }
  }

  @media (max-width: 768px) {
    .about-split               { grid-template-columns: 1fr; background: none; }
    .about-left, .about-cta   { border-right: none; border-bottom: 0.5px solid var(--border); }
    .about-right               { position: static; height: auto; }
    .about-testi               { order: -1; }
  }

  @media (max-width: 520px) {
    .about-left         { padding: var(--space-md) var(--space-xs); }
    .about-right        { padding: var(--space-md) var(--space-xs); }
    .about-photo-wrap   { aspect-ratio: 1 / 1; }
  }
</style>
