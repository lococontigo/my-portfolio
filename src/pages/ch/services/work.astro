---
import BaseLayout from '../../../layouts/base-layout.astro';
import '../../../styles/services-work.css';
---

<BaseLayout
  title="作品"
  world="light"
  navVariant="services"
  translated={true}
  description="由 Andrew Yip 設計及開發的客戶作品精選 —— 涵蓋 SaaS 儀表板、企業內聯網、品牌網站及手機應用程式。"
>
  <script slot="head" is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "作品 · Andrew YIP",
    "url": "https://andrewthyip.com/ch/services/work/",
    "description": "由 Andrew Yip 設計及開發的客戶作品精選 —— 涵蓋 SaaS 儀表板、企業內聯網、品牌網站及手機應用程式。",
    "about": {
      "@type": "Person",
      "name": "Andrew Yip",
      "jobTitle": "UX/UI 設計師及開發者",
      "url": "https://andrewthyip.com"
    },
    "inLanguage": "zh-Hant"
  }
  </script>

  <main class="main">

    <!-- ── Page heading ───────────────────────── -->
    <section>
      <div class="padding-global">
        <div class="container-main">
          <div class="work-page-heading">
            <h1 class="work-page-title">我的作品</h1>
            <p class="work-page-subtitle">涵蓋 SaaS、企業及手機應用程式的精選項目 —— 每一個都為推動實際業務目標而設計。</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Work: Yocale ─────────────────────── -->
    <section>
      <div class="padding-global">
        <div class="container-main">
          <div class="work-featured">

            <div class="work-featured-info">
              <div class="work-featured-text">
                <h2 class="work-featured-title">Yocale</h2>
                <p class="work-featured-desc">Yocale 是一套一站式企業管理及客戶預約系統,專為預約制業務而設計。</p>
              </div>
              <a href="/ch/work/yocale/" class="work-featured-link">
                查看作品 →
              </a>
            </div>

            <div class="work-featured-visual">
              <a href="/ch/work/yocale/">
                <img
                  src="/images/yocale-mockup.webp"
                  alt="Yocale 預約管理系統儀表板介面"
                  class="work-featured-img"
                  width="704" height="704"
                  fetchpriority="high"
                />
              </a>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- ── Work: Delta Controls ─────────────────────── -->
    <section>
      <div class="padding-global">
        <div class="container-main">
          <div class="work-featured">

            <div class="work-featured-info">
              <div class="work-featured-text">
                <h2 class="work-featured-title">Delta Intelligent Building Technologies </h2>
                <p class="work-featured-desc">The Source 是一個數碼資料庫,專為 Delta Controls 的合作夥伴及員工提供非技術文件、培訓資料及市場推廣素材。</p>
              </div>
              <a href="/ch/work/delta/" class="work-featured-link">
                閱讀個案研究 →
              </a>
            </div>

            <div class="work-featured-visual">
              <a href="/ch/work/delta/">
                <img
                  src="/images/Mac-Studio-mockup.svg"
                  alt="Delta Intelligent Building Technologies 資源平台介面"
                  class="work-featured-img"
                  width="704" height="704"
                  loading="lazy"
                />
              </a>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- ── Work: ANT Rentals ─────────────────────── -->
    <section>
      <div class="padding-global">
        <div class="container-main">
          <div class="work-featured">

            <div class="work-featured-info">
              <div class="work-featured-text">
                <h2 class="work-featured-title">Ant Equipment Group</h2>
                <p class="work-featured-desc">ANT 是加拿大西部最大型的獨立設備租賃及銷售供應商。</p>
              </div>
              <a href="/ch/work/ant/" class="work-featured-link">
                查看作品 →
              </a>
            </div>

            <div class="work-featured-visual">
              <a href="/ch/work/ant/">
                <img
                  src="/images/ant-mockup.svg"
                  alt="ANT Rentals 網誌版面設計"
                  class="work-featured-img"
                  width="704" height="704"
                  loading="lazy"
                />
              </a>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- ── Work: Crowd Ease ─────────────────────── -->
    <section>
      <div class="padding-global">
        <div class="container-main">
          <div class="work-featured">

            <div class="work-featured-info">
              <div class="work-featured-text">
                <h2 class="work-featured-title">Crowd Ease</h2>
                <p class="work-featured-desc">Crowd Ease 是一款手機應用程式,透過提供活動資訊及實時人流追蹤,協助餐廳規劃資源及市場推廣策略。</p>
              </div>
              <a href="/ch/work/crowd-ease/" class="work-featured-link">
                閱讀個案研究 →
              </a>
            </div>

            <div class="work-featured-visual">
              <a href="/ch/work/crowd-ease/">
                <img
                  src="/images/UI-CROWDEASE-1.svg"
                  alt="Crowd Ease 手機應用程式介面,顯示活動追蹤及實時人流資料"
                  class="work-featured-img"
                  width="704" height="704"
                  loading="lazy"
                />
              </a>
            </div>

          </div>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
