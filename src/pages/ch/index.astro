---
import BaseLayout from '../../layouts/base-layout.astro';
---

<BaseLayout title="首頁" world="dark" description="Andrew Yip 是一位居於溫哥華的 UX/UI 設計師及開發者。瀏覽作品集,或為您的業務打造全新網站。" chrome={false} translated={true}>
  <script slot="head" is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Andrew Yip — 首頁",
    "url": "https://andrewthyip.com/ch/",
    "description": "Andrew Yip 是一位居於溫哥華的 UX/UI 設計師及開發者。瀏覽作品集,或為您的業務打造全新網站。",
    "inLanguage": "zh-Hant"
  }
  </script>
  <script slot="head" is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Andrew Yip",
    "jobTitle": "UX/UI 設計師及開發者",
    "url": "https://andrewthyip.com",
    "sameAs": ["https://www.linkedin.com/in/andrewthyip/"],
    "knowsAbout": ["UX Design", "UI Design", "Web Development", "Design Systems"],
    "inLanguage": "zh-Hant"
  }
  </script>

  <main class="split-gate">

    <a href="/" class="split-lang-toggle" aria-label="切換至英文">EN</a>

    <a href="/ch/portfolio/" class="split-panel" data-theme="dark" aria-label="我要招聘 — 查看 Andrew Yip 的作品集">
      <div class="split-panel-media"></div>
      <div class="split-panel-content">
        <h1 class="split-headline">我要招聘</h1>
        <span class="split-cta">andrewthyip.com/ch/portfolio →</span>
      </div>
    </a>

    <a href="/ch/services/" class="split-panel split-panel-light" data-theme="light" aria-label="我需要網站 — 查看 Andrew Yip 提供的服務">
      <div class="split-panel-media"></div>
      <div class="split-panel-content">
        <h2 class="split-headline">我需要網站</h2>
        <span class="split-cta">andrewthyip.com/ch/services →</span>
      </div>
    </a>

  </main>

  <script is:inline>
    // Keep the stored language preference in sync with this toggle — the
    // English homepage (index.astro) redirects a fresh "/" visit straight to
    // /ch/ whenever the stored preference is 'zh-Hant'. Without this, clicking
    // "EN" here would land on "/" only to be bounced right back to /ch/,
    // making the toggle look like it does nothing.
    document.querySelector('.split-lang-toggle')?.addEventListener('click', () => {
      try { localStorage.setItem('preferredLocale', 'en'); } catch { /* storage unavailable, non-critical */ }
    });
  </script>
</BaseLayout>

<style>
  .split-gate {
    display:    flex;
    min-height: 100vh;
  }

  .split-lang-toggle {
    position:       fixed;
    top:            var(--space-sm);
    left:           50%;
    transform:      translateX(-50%);
    z-index:        10;
    display:        inline-flex;
    align-items:    center;
    justify-content: center;
    font-family:    var(--font-body);
    font-size:      11px;
    font-weight:    500;
    letter-spacing: 0.02em;
    color:          var(--text-1);
    background:     color-mix(in srgb, var(--bg-2) 70%, transparent);
    backdrop-filter:         blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border:         0.5px solid var(--border-2);
    border-radius:  var(--r-pill);
    padding:        8px 16px;
    transition:     color 0.2s var(--ease), border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }

  .split-lang-toggle:hover {
    color:        var(--accent-text);
    border-color: var(--accent);
    box-shadow:   var(--neon-sm);
  }

  .split-lang-toggle:focus-visible {
    outline:        2px solid var(--accent);
    outline-offset: 2px;
  }

  .split-panel {
    position:        relative;
    flex:            1;
    display:         flex;
    align-items:     center;
    justify-content: center;
    overflow:        hidden;
    background:      var(--bg);
    color:           var(--text-1);
  }

  /* ── Background photo (fades in on hover/focus) ───── */
  .split-panel-media {
    position:         absolute;
    inset:            0;
    background-image: linear-gradient(var(--scrim), var(--scrim)), url('/images/night-background.webp');
    background-size:     cover;
    background-position: center;
    opacity:    0;
    transition: opacity 0.5s var(--ease);
  }

  .split-panel-light .split-panel-media {
    background-image: linear-gradient(
        color-mix(in srgb, var(--bg) 55%, transparent),
        color-mix(in srgb, var(--bg) 55%, transparent)
      ),
      url('/images/light-background.webp');
  }

  /* ── Content ───────────────────────────────────────── */
  .split-panel-content {
    position:       relative;
    z-index:        1;
    display:        flex;
    flex-direction: column;
    align-items:    center;
    gap:            var(--space-sm);
    padding:        var(--space-md);
    text-align:     center;
  }

  .split-headline {
    font-family:    var(--font-display);
    font-size:      clamp(44px, 5.5vw, 75px);
    font-weight:    300;
    line-height:    1.15;
    letter-spacing: -0.28px;
    color:          var(--text-1);
    text-wrap:      balance;
    transition:     color 0.4s var(--ease);
  }

  .split-cta {
    display:        inline-flex;
    align-items:    center;
    gap:            6px;
    font-family:    var(--font-body);
    font-size:      12px;
    font-weight:    400;
    letter-spacing: 0.26px;
    color:          var(--text-2);
    border:         0.5px solid transparent;
    border-radius:  var(--r-sm);
    padding:        10px 14px;
    white-space:    nowrap;
    transition:     color 0.3s var(--ease),
                    gap 0.3s var(--ease),
                    border-color 0.3s var(--ease),
                    box-shadow 0.3s var(--ease);
  }

  /* ── Hover (pointer devices only, avoids a stuck reveal on touch) ── */
  @media (hover: hover) {
    .split-panel:hover .split-panel-media {
      opacity: 1;
    }

    .split-panel:hover .split-headline {
      color: var(--text-on-image);
    }

    .split-panel:hover .split-cta {
      color:        var(--accent-text);
      gap:          10px;
      border-color: var(--accent);
      box-shadow:   var(--neon-sm);
    }

    .split-panel-light:hover .split-headline {
      color: var(--text-1);
    }
  }

  /* ── Keyboard focus — same treatment, on every device ── */
  .split-panel:focus-visible .split-panel-media {
    opacity: 1;
  }

  .split-panel:focus-visible .split-headline {
    color: var(--text-on-image);
  }

  .split-panel:focus-visible .split-cta {
    color:        var(--accent-text);
    gap:          10px;
    border-color: var(--accent);
    box-shadow:   var(--neon-sm);
  }

  .split-panel-light:focus-visible .split-headline {
    color: var(--text-1);
  }

  /* ── Mobile: stack top/bottom ──────────────────────── */
  @media (max-width: 768px) {
    .split-gate {
      flex-direction: column;
    }

    .split-headline {
      font-size: clamp(32px, 9vw, 44px);
    }
  }
</style>
