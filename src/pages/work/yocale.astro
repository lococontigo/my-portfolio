---
import BaseLayout from '../../layouts/base-layout.astro';
import CaseStudyHero from '../../components/case-study-hero.astro';
import CaseStudyHighlight from '../../components/case-study-highlight.astro';
import CaseStudySectionHeader from '../../components/case-study-section-header.astro';
import CaseStudyDeliverableImage from '../../components/case-study-deliverable-image.astro';
import CaseStudyCompareSlider from '../../components/case-study-compare-slider.astro';
import CaseStudyKeepReading from '../../components/case-study-keep-reading.astro';

const sections = [
  { id: 'impact',    label: '01-Impact' },
  { id: 'overview',  label: '02-Overview' },
  { id: 'challenge', label: '03-Challenge' },
  { id: 'approach',  label: '04-Approach' },
  { id: 'identity',  label: '05-Visual Identity' },
  { id: 'features',  label: '06-Feature Launches' },
  { id: 'landing',  label: '07-Landing Pages' },
  { id: 'webdev',   label: '08-Web Development' },
];
---

<BaseLayout title="Yocale" world="light" sections={sections}>
  <main class="main">

    <CaseStudyHero
      title="Yocale: Building a Design Growth System that Makes Lead Generation Effortless"
      fullTitle="Yocale: Building a Design Growth System that Makes Lead Generation Effortless"
      accentTitle="Yocale"
      role={["GTM Design", "Landing Page Design", "Technical SEO", "Web Development"]}
      tools={["Figma", "Webflow", "Claude", "Ahrefs"]}
      duration={["2025 – 2026"]}
    />

    <CaseStudyHighlight
      id="impact"
      eyebrow="01"
      title="Impact"
      stats={[
        { value: "5.15%", caption: "CTR" },
        { value: "4", caption: "feature release launches" },
        { value: "40% ↓", caption: "Bounce rate" },
      ]}
    />

    <section class="case-overview-section" id="overview">
      <div class="padding-global">
        <div class="container-main">
          <div class="case-overview">

            <CaseStudySectionHeader eyebrow="02" title="Overview" />

            <div class="case-overview-content">
              <h3 class="case-overview-heading">Yocale</h3>
              <div class="case-overview-body">
                <p>Yocale is a cloud-based platform that helps service-based businesses, like salons or med spas, to manage and schedule their appointments.</p>
                <p>Business Made Simple, we believe small businesses are the backbone of our economy and our job is to empower them by giving them a tool they need to run the business effortlessly.</p>
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

    <section class="case-challenge-section" id="challenge">
      <div class="padding-global">
        <div class="container-main">
          <div class="case-challenge">

            <CaseStudySectionHeader eyebrow="03" title="Challenge" />

            <div class="case-challenge-content">
              <h3 class="case-challenge-heading">Missing Brand Identity</h3>
              <p class="case-challenge-body">Yocale has no unified visual identity across marketing channels (email, social media, website etc). On top of that, the design and content of the website is outdated and needs to be optimized for a better user experience.</p>
            </div>

            <CaseStudyDeliverableImage
              src="/images/yocale/challenge.png"
              alt="Screenshot of Yocale's outdated website homepage showing the 'Why Yocale' and 'Our Promise' sections with a tablet mockup of the booking calendar"
              width="1196"
              height="560"
              maxWidth="1196px"
            />

          </div>
        </div>
      </div>
    </section>

    <section class="case-approach-section" id="approach">
      <div class="padding-global">
        <div class="container-main">
          <div class="case-approach">

            <CaseStudySectionHeader eyebrow="04" title="Approach" />

            <div class="case-approach-content">
              <div class="case-approach-item">
                <h3 class="case-approach-heading">Build a system</h3>
                <p class="case-approach-body">Build a system that makes branding consistent, and bring all the pieces together and create a reusable visual library for brand identity and fast delivery.</p>
              </div>
              <div class="case-approach-item">
                <h3 class="case-approach-heading">Design for success</h3>
                <p class="case-approach-body">Design and develop web pages for product GTM launches and SEO optimization.</p>
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

    <section class="case-identity-section" id="identity">
      <div class="padding-global">
        <div class="container-main">
          <div class="case-identity">

            <CaseStudySectionHeader eyebrow="05" title="Visual Identity" />

            <div class="case-identity-grid">
              <img src="/images/yocale/colors.png" alt="Yocale brand color palette: coral #F37063, navy #034796, a coral-to-blue gradient, and a light pink-to-blue gradient, each with hex codes" width="464" height="270" loading="lazy" />
              <img src="/images/yocale/type.png" alt="Yocale typography: General Sans typeface shown in regular weight for headings and bold weight for the 'abc123' sample" width="464" height="270" loading="lazy" />
              <img src="/images/yocale/logo.png" alt="Yocale logo wordmark and icon mark in coral with a starburst accent" width="464" height="270" loading="lazy" />
            </div>

          </div>
        </div>
      </div>
    </section>

    <section class="case-features-section" id="features">
      <div class="padding-global">
        <div class="container-main">
          <div class="case-features">

            <CaseStudySectionHeader eyebrow="06" title="Feature Launches" />

            <div class="feature-grid">
              <div class="feature-card">
                <div class="feature-card-image">
                  <img src="/images/yocale/invoicing.jpg" alt="Yocale invoicing interface showing an itemized receipt with services, subtotal, tax, and total, alongside a staff member holding a barcode scanner and product" width="708" height="354" loading="lazy" />
                </div>
                <div class="feature-card-info">
                  <span class="feature-card-number">01</span>
                  <h3 class="feature-card-title">Invoicing</h3>
                </div>
              </div>

              <div class="feature-card">
                <div class="feature-card-image">
                  <img src="/images/yocale/integrated-payments.png" alt="Yocale integrated payments landing page showing 'Integrated Payments &amp; Point of Sale Made Simple' messaging, adoption statistics, and a suite of supported payment devices" width="708" height="355" loading="lazy" />
                </div>
                <div class="feature-card-info">
                  <span class="feature-card-number">02</span>
                  <h3 class="feature-card-title">Integrated Payments</h3>
                </div>
              </div>

              <div class="feature-card">
                <div class="feature-card-image">
                  <img src="/images/yocale/bnpl.png" alt="Yocale 'Buy Now, Pay Later' promotional banner showing a phone displaying Affirm, Klarna, and Afterpay payment options" width="708" height="355" loading="lazy" />
                </div>
                <div class="feature-card-info">
                  <span class="feature-card-number">03</span>
                  <h3 class="feature-card-title">Buy Now Pay Later</h3>
                </div>
              </div>

              <div class="feature-card">
                <div class="feature-card-image">
                  <img src="/images/yocale/gift-card.png" alt="Yocale gift card management interface showing preset values and a digital gift card balance, with a salon stylist cutting a client's hair in the background" width="708" height="355" loading="lazy" />
                </div>

                <div class="feature-card-info">
                  <span class="feature-card-number">04</span>
                  <h3 class="feature-card-title">Gift Card</h3>
                </div>
              </div>
            </div>

            <div class="feature-gallery">
              <CaseStudyDeliverableImage
                src="/images/yocale/BNOK.png"
                alt="Yocale 'Buy Now, Pay Later' blog article preview with the heading 'Let Clients Book Bigger Services. You Get Paid In Full, Upfront', stat cards for '2-3x higher average tickets' and '0 chasing and risk', and a panel showing Affirm, Afterpay, and Klarna logos"
                width="1196"
                height="467"
                maxWidth="1196px"
              />
            </div>

            <div class="feature-gallery-row-2">
              <div class="feature-scanner-image">
                <img src="/images/yocale/Scanner.png" alt="Photo of a hand using a barcode scanner on a product box, overlaid with a Yocale interface card showing 'Hand cream', quantity 88, price $45.00, and brand 'Necessaire'" width="536" height="480" loading="lazy" />
              </div>
              <div class="feature-gift-cards">
                <div class="gift-card-row" data-marquee aria-label="Yocale gift card designs: Thank You, Congrats, For You">
                  <div class="gift-card-track" data-marquee-track>
                    <img src="/images/yocale/gift_cards/Thank You.png" alt="Yocale 'Thank You' gift card design in deep plum with the Yocale logo and a ring-pattern accent" width="350" height="233" loading="lazy" />
                    <img src="/images/yocale/gift_cards/Congrats.png" alt="Yocale 'Congrats' gift card design in deep rust with the Yocale logo and a ring-pattern accent" width="350" height="233" loading="lazy" />
                    <img src="/images/yocale/gift_cards/For You.png" alt="Yocale 'For You' gift card design in deep navy with the Yocale logo and a ring-pattern accent" width="350" height="233" loading="lazy" />
                    <img src="/images/yocale/gift_cards/Thank You.png" alt="" width="350" height="233" loading="lazy" aria-hidden="true" />
                    <img src="/images/yocale/gift_cards/Congrats.png" alt="" width="350" height="233" loading="lazy" aria-hidden="true" />
                    <img src="/images/yocale/gift_cards/For You.png" alt="" width="350" height="233" loading="lazy" aria-hidden="true" />
                  </div>
                </div>
                <div class="gift-card-row" data-marquee data-marquee-reverse aria-label="Yocale gift card designs: Just Because, With Love, Happy Birthday">
                  <div class="gift-card-track" data-marquee-track>
                    <img src="/images/yocale/gift_cards/Just Because.png" alt="Yocale 'Just Because' gift card design in deep maroon with the Yocale logo and a ring-pattern accent" width="350" height="233" loading="lazy" />
                    <img src="/images/yocale/gift_cards/With Love.png" alt="Yocale 'With Love' gift card design in deep indigo with the Yocale logo and a ring-pattern accent" width="350" height="233" loading="lazy" />
                    <img src="/images/yocale/gift_cards/Happy Birthday.png" alt="Yocale 'Happy Birthday' gift card design in forest green with the Yocale logo and a ring-pattern accent" width="350" height="233" loading="lazy" />
                    <img src="/images/yocale/gift_cards/Just Because.png" alt="" width="350" height="233" loading="lazy" aria-hidden="true" />
                    <img src="/images/yocale/gift_cards/With Love.png" alt="" width="350" height="233" loading="lazy" aria-hidden="true" />
                    <img src="/images/yocale/gift_cards/Happy Birthday.png" alt="" width="350" height="233" loading="lazy" aria-hidden="true" />
                  </div>
                </div>
              </div>
            </div>

            <div class="feature-gallery-row-3">
              <CaseStudyDeliverableImage
                src="/images/yocale/nav.png"
                alt="Yocale website navigation bar with the 'Features' menu open, showing a mega-menu of feature categories including Online Calendar, Online Booking, Marketing, Virtual Meeting, Client Management, Point of Sale, Notifications, Reserve with Google, Client Portal, Business Management, Form &amp; Annotation, Integrated Payment, Invoicing, Yocale Pay, and Yocale Marketing, set against a hero background photo of two people"
                width="1196"
                height="573"
                maxWidth="1196px"
              />
            </div>

            <div class="feature-gallery-row-4">
              <img src="/images/yocale/never lose track of a payment.png" alt="Yocale invoicing dashboard showing a list of invoices with date, client, and status columns, and a status filter dropdown open with Draft, Outstanding, Partially Paid, Paid, and Voided options" width="708" height="630" loading="lazy" />
              <img src="/images/yocale/accept every way to pay.png" alt="Yocale payment integrations panel showing Affirm, Klarna, and Afterpay cards via Stripe, each enabled with a toggle switch and edit button" width="708" height="630" loading="lazy" />
            </div>

            <div class="feature-gallery-row-5">
              <div class="feature-gallery-row-5-grid">
                <img src="/images/yocale/Group 60302.png" alt="Yocale mobile screen showing a hand using a phone for integrated payments near retail shelves, with the heading 'Integrated Payments &amp; Point of Sale Made Simple'" width="343" height="515" loading="lazy" />
                <img src="/images/yocale/Group 60300.png" alt="Yocale mobile screen with the heading 'Let Clients Book Bigger Services. You Get Paid In Full, Upfront', stat cards for '2-3x higher average tickets' and '0 chasing and risk', and a panel showing Affirm, Afterpay, and Klarna logos" width="343" height="515" loading="lazy" />
                <img src="/images/yocale/Group 60301.png" alt="Yocale mobile screen showing an invoice creation interface with line items and a signature panel, with the heading 'Create Invoices In Seconds. Get Paid Fast.'" width="343" height="515" loading="lazy" />
              </div>
            </div>

            <div class="feature-gallery-row-6">
              <div class="feature-gallery-row-6-item">
                <img src="/images/yocale/mockup-bnpl.png" alt="Yocale mobile checkout screen showing an invoice with 'Amount due $450.00', Affirm and Klarna buy-now-pay-later options, payment method selection with Affirm selected, and a 'Confirm payment' button" width="550" height="708" loading="lazy" />
              </div>
              <div class="feature-gallery-row-6-item">
                <img src="/images/yocale/Commission.png" alt="Photo of a woman checking her phone, with a 'Blowdry Commission' card overlay showing a discounted price of $49.00 from $70.00 and staff member 'Natan Jein'" width="536" height="480" loading="lazy" />
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

    <section class="case-features-section" id="landing">
      <div class="padding-global">
        <div class="container-main">
          <div class="case-features">

            <CaseStudySectionHeader eyebrow="07" title="Landing Pages"/>

            <div class="landing-video-placeholder">
              <svg class="landing-video-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 4v16l13-8z" />
              </svg>
              <p class="landing-video-label">Demo video coming soon</p>
            </div>

            <div class="landing-content">
              <h3 class="landing-content-title">Conversion Funnel</h3>
              <div class="landing-content-body">
                <p>Marketing has a playbook on converting traffic into a lead. Almost all successful landing pages are following this formula:</p>
                <ol class="landing-content-list">
                  <li>1. Hook — Awareness &amp; (Awareness & Primary Value Proposition) </li>
                  <li>2. Core Value — Interest &amp; (Interest & How to address my problem)</li>
                  <li>3. Social Proof — Remove Objections &amp; (Remove Objections & Build Desire)</li>
                  <li>4. Call To Action — (The Conversion)</li>
                </ol>
              </div>
            </div>

            <div class="landing-gallery">
              <CaseStudyDeliverableImage
                src="/images/yocale/Container.png"
                alt="Yocale landing page layout showing the full-width container structure and section hierarchy"
                width="1196"
                height="720"
                maxWidth="1196px"
              />

              <div class="landing-gallery-row-2">
                <CaseStudyDeliverableImage
                  src="/images/yocale/hero header.png"
                  alt="Yocale hero header design showing the headline, subheading, CTA button, and phone mockup on a clean background"
                  width="1296"
                  height="589"
                  maxWidth="1196px"
                />
              </div>

              <div class="landing-gallery-row-3">
                <div class="landing-row-3-left">
                  <img src="/images/yocale/clients_quotes.png" alt="Yocale Spanish-language landing page section showing two client testimonials from Preet and Elena with their photos and quotes" width="574" height="575" loading="lazy" />
                </div>
                <div class="landing-row-3-right">
                  <img src="/images/yocale/Section data.png" alt="Yocale Spanish-language 'Beneficios de Yocale' section showing a laptop mockup alongside four statistics: 86% reduction in no-shows, 34% increase in client bookings, 30% increase in recurring bookings, and 64% increase in new bookings" width="611" height="358" loading="lazy" />
                </div>
              </div>

              <div class="landing-localization">
                <h3 class="landing-localization-title">Localization</h3>
                <p class="landing-localization-body">Latam is also our service area and our target audiences. To expand our business and provide value proposition to the Spanish readers. We worked together on a landing page which Latin America sales can spread this around.</p>
              </div>

              <div class="landing-gallery-row-4" data-parallax>
                <img
                  src="/images/yocale/Yocale Pay.png"
                  alt="Yocale Pay full-page landing page showing the hero headline, feature highlights, and call-to-action section"
                  width="1440"
                  height="800"
                  loading="lazy"
                />
              </div>

              <div class="landing-gallery-row-5">
                <CaseStudyDeliverableImage
                  src="/images/yocale/tracking.png"
                  alt="Yocale analytics tracking dashboard showing session data, conversion metrics, and user behaviour insights"
                  width="1196"
                  height="678"
                  maxWidth="1196px"
                />
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

    <section class="case-webdev-section" id="webdev">
      <div class="padding-global">
        <div class="container-main">
          <div class="case-webdev">

            <CaseStudySectionHeader eyebrow="08" title="Web Development" />

            <div class="webdev-compare">
              <CaseStudyCompareSlider
                beforeSrc="/images/yocale/old blog.png"
                afterSrc="/images/yocale/new blog.png"
                beforeAlt="Screenshot of the original Yocale blog layout from 2023 showing all posts on a single page with no category structure"
                afterAlt="Screenshot of the redesigned Yocale blog layout from 2024 showing structured categories and improved navigation"
                beforeLabel="Before · 2023"
                afterLabel="After · 2024"
                aspectRatio="1440 / 1798"
              />
            </div>

            <div class="webdev-content">
              <h3 class="webdev-content-title">Redesign to solve SEO issues</h3>
              <p class="webdev-content-body">The site always has orphan pages with blog as the original layout is dumping the latest 100 blogs into that page while there are more than 100 content. So I restructured the blog section and make sure every category is being indexed and shown.</p>
            </div>

          </div>
        </div>
      </div>
    </section>

    <CaseStudyKeepReading current="yocale" />

  </main>
</BaseLayout>

<style>
  .main {
    --case-accent:       var(--accent-yocale);
    --case-accent-solid: var(--accent-yocale-2);
    padding-top:         96px;
    min-height:          100vh;
  }

  /* ── 02 Overview ──────────────────────────── */
  .case-overview-content {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(12px, 1.7vw, 24px);
  }

  .case-overview-heading {
    font-family: var(--font-display);
    font-size:   36px;
    font-weight: 400;
    line-height: 1.2;
    color:       var(--text-1);
  }

  .case-overview-body {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-sm);
  }

  .case-overview-body p {
    font-family: var(--font-body);
    font-size:   15px;
    font-weight: 300;
    line-height: 1.6;
    color:       var(--text-2);
  }

  /* ── 03 Challenge ─────────────────────────── */
  .case-challenge-content {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(12px, 1.7vw, 24px);
    margin-bottom:         clamp(20px, 2.8vw, 40px);
  }

  .case-challenge-heading {
    font-family: var(--font-display);
    font-size:   clamp(28px, 3.1vw, 45px);
    font-weight: 400;
    line-height: 1.2;
    color:       var(--text-1);
  }

  .case-challenge-body {
    font-family: var(--font-body);
    font-size:   15px;
    font-weight: 300;
    line-height: 1.6;
    color:       var(--text-2);
  }

  /* ── 04 Approach ──────────────────────────── */
  .case-approach-content {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-lg);
  }

  .case-approach-item {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(12px, 1.7vw, 24px);
  }

  .case-approach-heading {
    font-family: var(--font-display);
    font-size:   36px;
    font-weight: 400;
    line-height: 1.2;
    color:       var(--text-1);
  }

  .case-approach-body {
    font-family: var(--font-body);
    font-size:   15px;
    font-weight: 300;
    line-height: 1.6;
    color:       var(--text-2);
  }

  /* ── 05 Visual Identity ───────────────────── */
  .case-identity-grid {
    display:               grid;
    grid-template-columns: repeat(3, 1fr);
    gap:                   clamp(12px, 1.7vw, 24px);
  }

  .case-identity-grid img {
    display: block;
    width:   100%;
    height:  auto;
  }

  /* ── 06 Feature Launches ──────────────────── */
  .feature-grid {
    display:               grid;
    grid-template-columns: repeat(2, 1fr);
    gap:                   clamp(12px, 1.7vw, 24px);
  }

  .feature-card {
    display:        flex;
    flex-direction: column;
    border-radius:  var(--r-lg);
    overflow:       hidden;
    background:     var(--bg-2);
  }

  .feature-card-image img {
    display:      block;
    width:        100%;
    height:       auto;
    aspect-ratio: 708 / 355;
    object-fit:   cover;
  }

  .feature-card-info {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-xs);
    padding:        var(--space-md);
  }

  .feature-card-number {
    font-family: var(--font-body);
    font-size:   16px;
    font-weight: 400;
    color:       var(--text-2);
  }

  .feature-card-title {
    font-family: var(--font-display);
    font-size:   36px;
    font-weight: 400;
    line-height: 1.2;
    color:       var(--text-1);
  }

  .feature-gallery {
    margin-top: clamp(12px, 1.7vw, 24px);
  }

  .feature-gallery-row-2 {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(12px, 1.7vw, 24px);
    margin-top:            clamp(12px, 1.7vw, 24px);
    --gift-card-row-h:     clamp(107px, 14.6vw, 186px);
  }

  .feature-gallery-row-3 {
    margin-top: clamp(12px, 1.7vw, 24px);
  }

  .feature-gallery-row-4 {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(12px, 1.7vw, 24px);
    margin-top:            clamp(12px, 1.7vw, 24px);
  }

  .feature-gallery-row-4 img {
    display:       block;
    width:         100%;
    height:        auto;
    border-radius: var(--r-lg);
  }

  .feature-gallery-row-5 {
    margin-top:    clamp(12px, 1.7vw, 24px);
    padding:       var(--space-md) var(--space-md) 0;
    background:    var(--bg-2);
    border-radius: var(--r-lg);
  }

  .feature-gallery-row-5-grid {
    display:               grid;
    grid-template-columns: repeat(3, 1fr);
    gap:                   clamp(12px, 1.7vw, 24px);
    max-width:             1196px;
    margin-inline:         auto;
  }

  .feature-gallery-row-5-grid img {
    display: block;
    width:   100%;
    height:  auto;
  }

  .feature-gallery-row-6 {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(12px, 1.7vw, 24px);
    margin-top:            clamp(12px, 1.7vw, 24px);
  }

  .feature-gallery-row-6-item {
    display:         flex;
    align-items:     center;
    justify-content: center;
    padding:         0 clamp(32px, 5.5vw, 80px);
    background:      var(--bg-2);
    border-radius:   var(--r-lg);
  }

  .feature-gallery-row-6-item img {
    display: block;
    width:   100%;
    height:  auto;
  }

  .feature-scanner-image {
    display:         flex;
    align-items:     center;
    justify-content: center;
    padding:         var(--space-md);
    background:      var(--bg-2);
    border-radius:   var(--r-lg);
  }

  .feature-scanner-image img {
    display: block;
    width:   auto;
