---
import BaseLayout from '../../layouts/base-layout.astro';
import CaseStudyHero from '../../components/case-study-hero.astro';
import CaseStudyKeepReading from '../../components/case-study-keep-reading.astro';
---

<BaseLayout title="Yocale" world="light">
  <main class="main">

    <CaseStudyHero
      title="Yocale: Building a Design Growth System that Makes Lead Generation Effortless"
      fullTitle="Yocale: Building a Design Growth System that Makes Lead Generation Effortless"
      accentTitle="Yocale"
      role={["GTM Design", "Landing Page Design", "Technical SEO", "Web Development"]}
      tools={["Figma", "Webflow", "Claude", "Ahrefs"]}
      duration={["2025 – 2026"]}
    />

    <CaseStudyKeepReading current="yocale" />

  </main>
</BaseLayout>

<style>
  .main {
    --case-accent:       var(--accent-yocale);
    --case-accent-solid: var(--accent-yocale-2);
    padding-top:         96px;
    min-height:          100vh;
  }

  @media (max-width: 768px) {
    .main { padding-top: 80px; }
  }

  @media (max-width: 520px) {
    .main { padding-top: 72px; }
  }
</style>
