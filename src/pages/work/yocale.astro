---
import BaseLayout from '../../layouts/base-layout.astro';
import CaseStudyHero from '../../components/case-study-hero.astro';
import CaseStudyHighlight from '../../components/case-study-highlight.astro';
import CaseStudySectionHeader from '../../components/case-study-section-header.astro';
import CaseStudyDeliverableImage from '../../components/case-study-deliverable-image.astro';
import CaseStudyCompareSlider from '../../components/case-study-compare-slider.astro';
import CaseStudyGif from '../../components/case-study-gif.astro';
import CaseStudyKeepReading from '../../components/case-study-keep-reading.astro';

const sections = [
  { id: 'impact',    label: '01-Impact' },
  { id: 'overview',  label: '02-Overview' },
  { id: 'challenge', label: '03-Challenge' },
  { id: 'approach',  label: '04-Approach' },
  { id: 'identity',  label: '05-Visual Identity' },
  { id: 'features',  label: '06-Feature Launches' },
  { id: 'landing',  label: '07-Landing Pages' },
  { id: 'webdev',   label: '08-Web Development' },
];
---

<BaseLayout title="Yocale" world="light" sections={sections} description="How I built a design growth system for Yocale that makes lead generation effortless — achieving 5.15% CTR and 40% bounce rate reduction through GTM design, landing pages, and technical SEO.">
  <script slot="head" is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": "Yocale: Building a Design Growth System that Makes Lead Generation Effortless",
    "description": "GTM design, landing page design, technical SEO, and web development for Yocale — a SaaS booking platform.",
    "url": "https://andrewthyip.com/work/yocale/",
    "author": { "@type": "Person", "name": "Andrew Yip", "url": "https://andrewthyip.com" }
  }
  </script>
  <main class="main">

    <CaseStudyHero
      title="Yocale: Building a Design Growth System that Makes Lead Generation Effortless"
      fullTitle="Yocale: Building a Design Growth System that Makes Lead Generation Effortless"
      accentTitle="Yocale"
      gifSrc="/gifs/yocale/haaland.gif"
      gifAlt="Animated walkthrough of the Yocale landing page design system"
      gifAspectRatio="1440 / 900"
      role={["GTM Design", "Landing Page Design", "Technical SEO", "Web Development"]}
      tools={["Figma", "Webflow", "Claude", "Ahrefs"]}
      duration={["2025 – 2026"]}
    />

    <CaseStudyHighlight
      id="impact"
      eyebrow="01"
      title="Impact"
      stats={[
        { value: "5.15%", caption: "Click-through rate" },
        { value: "4", caption: "Feature release launches" },
        { value: "40% ↓", caption: "Bounce rate" },
      ]}
    />

    <section class="case-overview-section" id="overview">
      <div class="padding-global">
        <div class="container-main">
          <div class="case-overview">

            <CaseStudySectionHeader eyebrow="02" title="Overview" />

            <div class="case-overview-content">
              <h3 class="case-overview-heading">Yocale</h3>
              <div class="case-overview-body">
                <p>Yocale is a cloud-based platform that helps service-based businesses — like salons and med spas — manage appointments, payments, and client relationships in one place.</p>
                <p>Our tagline is <em>Business Made Simple</em>. We believe small businesses are the backbone of the economy, and our job is to give them the tools they need to run effortlessly.</p>
              </div>
            </div>

            <CaseStudyDeliverableImage
              src="/gifs/yocale/yocale.homepage.gif"
              alt="Animated walkthrough of the Yocale homepage showcasing the booking management platform"
              width="1196"
              height="720"
              maxWidth="1196px"
            />

          </div>
        </div>
      </div>
    </section>

    <section class="case-challenge-section" id="challenge">
      <div class="padding-global">
        <div class="container-main">
          <div class="case-challenge">

            <CaseStudySectionHeader eyebrow="03" title="Challenge" />

            <div class="case-challenge-content">
              <h3 class="case-challenge-heading">Missing Brand Identity</h3>
              <p class="case-challenge-body">Yocale had no unified visual identity across marketing channels — email, social media, and the website. On top of that, the design and content of the website were outdated and needed optimization for a better user experience.</p>
            </div>

            <CaseStudyDeliverableImage
              src="/images/yocale/yocale-outdated-website-challenge.webp"
              alt="Screenshot of Yocale's outdated website homepage showing the 'Why Yocale' and 'Our Promise' sections with a tablet mockup of the booking calendar"
              width="1196"
              height="560"
              maxWidth="1196px"
            />

          </div>
        </div>
      </div>
    </section>

    <section class="case-approach-section" id="approach">
      <div class="padding-global">
        <div class="container-main">
          <div class="case-approach">

            <CaseStudySectionHeader eyebrow="04" title="Approach" />

            <div class="case-approach-content">
              <div class="case-approach-item">
                <h3 class="case-approach-heading">Build a system</h3>
                <p class="case-approach-body">Establish a reusable visual library — colors, typography, components — that keeps branding consistent across every marketing channel and enables fast delivery.</p>
              </div>
              <div class="case-approach-item">
                <h3 class="case-approach-heading">Design for success</h3>
                <p class="case-approach-body">Design and develop web pages for product GTM launches and SEO optimization.</p>
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

    <section class="case-identity-section" id="identity">
      <div class="padding-global">
        <div class="container-main">
          <div class="case-identity">

            <CaseStudySectionHeader eyebrow="05" title="Visual Identity" />

            <div class="case-identity-grid" data-stagger-reveal>
              <img src="/images/yocale/yocale-brand-color-palette.webp" alt="Yocale brand color palette: coral #F37063, navy #034796, a coral-to-blue gradient, and a light pink-to-blue gradient, each with hex codes" width="464" height="270" loading="lazy" data-stagger-child />
              <img src="/images/yocale/yocale-brand-typography.webp" alt="Yocale typography: General Sans typeface shown in regular weight for headings and bold weight for the 'abc123' sample" width="464" height="270" loading="lazy" data-stagger-child />
              <img src="/images/yocale/yocale-logo.webp" alt="Yocale logo wordmark and icon mark in coral with a starburst accent" width="464" height="270" loading="lazy" data-stagger-child />
            </div>

          </div>
        </div>
      </div>
    </section>

    <section class="case-features-section" id="features">
      <div class="padding-global">
        <div class="container-main">
          <div class="case-features">

            <CaseStudySectionHeader eyebrow="06" title="Feature Launches" />

            <div class="feature-grid">
              <div class="feature-card">
                <div class="feature-card-image">
                  <img src="/images/yocale/invoicing.jpg" alt="Yocale invoicing interface showing an itemized receipt with services, subtotal, tax, and total, alongside a staff member holding a barcode scanner and product" width="708" height="354" loading="lazy" />
                </div>
                <div class="feature-card-info">
                  <span class="feature-card-number">01</span>
                  <h3 class="feature-card-title">Invoicing</h3>
                </div>
              </div>

              <div class="feature-card">
                <div class="feature-card-image">
                  <img src="/images/yocale/yocale-integrated-payments-landing.webp" alt="Yocale integrated payments landing page showing 'Integrated Payments &amp; Point of Sale Made Simple' messaging, adoption statistics, and a suite of supported payment devices" width="708" height="355" loading="lazy" />
                </div>
                <div class="feature-card-info">
                  <span class="feature-card-number">02</span>
                  <h3 class="feature-card-title">Integrated Payments</h3>
                </div>
              </div>

              <div class="feature-card">
                <div class="feature-card-image">
                  <img src="/images/yocale/yocale-buy-now-pay-later-banner.webp" alt="Yocale 'Buy Now, Pay Later' promotional banner showing a phone displaying Affirm, Klarna, and Afterpay payment options" width="708" height="355" loading="lazy" />
                </div>
                <div class="feature-card-info">
                  <span class="feature-card-number">03</span>
                  <h3 class="feature-card-title">Buy Now Pay Later</h3>
                </div>
              </div>

              <div class="feature-card">
                <div class="feature-card-image">
                  <img src="/images/yocale/yocale-gift-card-feature.webp" alt="Yocale gift card management interface showing preset values and a digital gift card balance, with a salon stylist cutting a client's hair in the background" width="708" height="355" loading="lazy" />
                </div>

                <div class="feature-card-info">
                  <span class="feature-card-number">04</span>
                  <h3 class="feature-card-title">Gift Card</h3>
                </div>
              </div>
            </div>

            <div class="feature-gallery">
              <CaseStudyDeliverableImage
                src="/images/yocale/yocale-bnpl-checkout-flow.webp"
                alt="Yocale 'Buy Now, Pay Later' blog article preview with the heading 'Let Clients Book Bigger Services. You Get Paid In Full, Upfront', stat cards for '2-3x higher average tickets' and '0 chasing and risk', and a panel showing Affirm, Afterpay, and Klarna logos"
                width="1196"
                height="467"
                maxWidth="1196px"
              />
            </div>

            <div class="feature-gallery-row-2">
              <div class="feature-scanner-image">
                <img src="/images/yocale/yocale-payment-scanner-mockup.webp" alt="Photo of a hand using a barcode scanner on a product box, overlaid with a Yocale interface card showing 'Hand cream', quantity 88, price $45.00, and brand 'Necessaire'" width="536" height="480" loading="lazy" />
              </div>
              <div class="feature-gift-cards">
                <div class="gift-card-row" data-marquee aria-label="Yocale gift card designs: Thank You, Congrats, For You">
                  <div class="gift-card-track" data-marquee-track>
                    <img src="/images/yocale/gift_cards/yocale-gift-card-thank-you.webp" alt="Yocale 'Thank You' gift card design in deep plum with the Yocale logo and a ring-pattern accent" width="350" height="233" loading="lazy" />
                    <img src="/images/yocale/gift_cards/yocale-gift-card-congrats.webp" alt="Yocale 'Congrats' gift card design in deep rust with the Yocale logo and a ring-pattern accent" width="350" height="233" loading="lazy" />
                    <img src="/images/yocale/gift_cards/yocale-gift-card-for-you.webp" alt="Yocale 'For You' gift card design in deep navy with the Yocale logo and a ring-pattern accent" width="350" height="233" loading="lazy" />
                    <img src="/images/yocale/gift_cards/yocale-gift-card-thank-you.webp" alt="" width="350" height="233" loading="lazy" aria-hidden="true" />
                    <img src="/images/yocale/gift_cards/yocale-gift-card-congrats.webp" alt="" width="350" height="233" loading="lazy" aria-hidden="true" />
                    <img src="/images/yocale/gift_cards/yocale-gift-card-for-you.webp" alt="" width="350" height="233" loading="lazy" aria-hidden="true" />
                  </div>
                </div>
                <div class="gift-card-row" data-marquee data-marquee-reverse aria-label="Yocale gift card designs: Just Because, With Love, Happy Birthday">
                  <div class="gift-card-track" data-marquee-track>
                    <img src="/images/yocale/gift_cards/yocale-gift-card-just-because.webp" alt="Yocale 'Just Because' gift card design in deep maroon with the Yocale logo and a ring-pattern accent" width="350" height="233" loading="lazy" />
                    <img src="/images/yocale/gift_cards/yocale-gift-card-with-love.webp" alt="Yocale 'With Love' gift card design in deep indigo with the Yocale logo and a ring-pattern accent" width="350" height="233" loading="lazy" />
                    <img src="/images/yocale/gift_cards/yocale-gift-card-happy-birthday.webp" alt="Yocale 'Happy Birthday' gift card design in forest green with the Yocale logo and a ring-pattern accent" width="350" height="233" loading="lazy" />
                    <img src="/images/yocale/gift_cards/yocale-gift-card-just-because.webp" alt="" width="350" height="233" loading="lazy" aria-hidden="true" />
                    <img src="/images/yocale/gift_cards/yocale-gift-card-with-love.webp" alt="" width="350" height="233" loading="lazy" aria-hidden="true" />
                    <img src="/images/yocale/gift_cards/yocale-gift-card-happy-birthday.webp" alt="" width="350" height="233" loading="lazy" aria-hidden="true" />
                  </div>
                </div>
              </div>
            </div>

            <div class="feature-gallery-row-3">
              <CaseStudyDeliverableImage
                src="/images/yocale/yocale-navigation-design.webp"
                alt="Yocale website navigation bar with the 'Features' menu open, showing a mega-menu of feature categories including Online Calendar, Online Booking, Marketing, Virtual Meeting, Client Management, Point of Sale, Notifications, Reserve with Google, Client Portal, Business Management, Form &amp; Annotation, Integrated Payment, Invoicing, Yocale Pay, and Yocale Marketing, set against a hero background photo of two people"
                width="1196"
                height="573"
                maxWidth="1196px"
              />
            </div>

            <div class="feature-gallery-row-4">
              <img src="/images/yocale/yocale-never-lose-track-payment.webp" alt="Yocale invoicing dashboard showing a list of invoices with date, client, and status columns, and a status filter dropdown open with Draft, Outstanding, Partially Paid, Paid, and Voided options" width="708" height="630" loading="lazy" />
              <img src="/images/yocale/yocale-accept-every-way-to-pay.webp" alt="Yocale payment integrations panel showing Affirm, Klarna, and Afterpay cards via Stripe, each enabled with a toggle switch and edit button" width="708" height="630" loading="lazy" />
            </div>

            <div class="feature-gallery-row-5">
              <div class="feature-gallery-row-5-grid">
                <img src="/images/yocale/yocale-gift-card-feature-mockup.webp" alt="Yocale mobile screen showing a hand using a phone for integrated payments near retail shelves, with the heading 'Integrated Payments &amp; Point of Sale Made Simple'" width="343" height="515" loading="lazy" />
                <img src="/images/yocale/yocale-invoicing-feature-mockup.webp" alt="Yocale mobile screen with the heading 'Let Clients Book Bigger Services. You Get Paid In Full, Upfront', stat cards for '2-3x higher average tickets' and '0 chasing and risk', and a panel showing Affirm, Afterpay, and Klarna logos" width="343" height="515" loading="lazy" />
                <img src="/images/yocale/yocale-integrated-payments-mockup.webp" alt="Yocale mobile screen showing an invoice creation interface with line items and a signature panel, with the heading 'Create Invoices In Seconds. Get Paid Fast.'" width="343" height="515" loading="lazy" />
              </div>
            </div>

            <div class="feature-gallery-row-6">
              <div class="feature-gallery-row-6-item">
                <img src="/images/yocale/yocale-bnpl-mockup.webp" alt="Yocale mobile checkout screen showing an invoice with 'Amount due $450.00', Affirm and Klarna buy-now-pay-later options, payment method selection with Affirm selected, and a 'Confirm payment' button" width="550" height="708" loading="lazy" />
              </div>
              <div class="feature-gallery-row-6-item">
                <img src="/images/yocale/yocale-commission-tracking-feature.webp" alt="Photo of a woman checking her phone, with a 'Blowdry Commission' card overlay showing a discounted price of $49.00 from $70.00 and staff member 'Natan Jein'" width="536" height="480" loading="lazy" />
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

    <section class="case-features-section" id="landing">
      <div class="padding-global">
        <div class="container-main">
          <div class="case-features">

            <CaseStudySectionHeader eyebrow="07" title="Landing Pages"/>

            <div class="landing-gif-wrap">
              <CaseStudyGif gifSrc="/gifs/yocale/0621(1).gif" alt="Animated walkthrough of Yocale landing page designs" aspectRatio="16 / 9" />
            </div>

            <div class="landing-content">
              <h3 class="landing-content-title">Conversion Funnel</h3>
              <div class="landing-content-body">
                <p>High-converting landing pages follow a proven formula. Every section moves the visitor one step closer to becoming a lead:</p>
                <ol class="landing-content-list">
                  <li>Hook — Lead with awareness and the primary value proposition</li>
                  <li>Core Value — Show how the product solves their specific problem</li>
                  <li>Social Proof — Remove objections and build desire through credibility</li>
                  <li>Call to Action — Drive the conversion</li>
                </ol>
              </div>
            </div>

            <div class="landing-gallery">
              <CaseStudyDeliverableImage
                src="/images/yocale/yocale-landing-page-container-layout.webp"
                alt="Yocale landing page layout showing the full-width container structure and section hierarchy"
                width="1196"
                height="720"
                maxWidth="1196px"
              />

              <div class="landing-gallery-row-2">
                <CaseStudyDeliverableImage
                  src="/images/yocale/yocale-hero-header-design.webp"
                  alt="Yocale hero header design showing the headline, subheading, CTA button, and phone mockup on a clean background"
                  width="1296"
                  height="589"
                  maxWidth="1196px"
                />
              </div>

              <div class="landing-gallery-row-3">
                <div class="landing-row-3-left">
                  <img src="/images/yocale/yocale-client-testimonials.webp" alt="Yocale Spanish-language landing page section showing two client testimonials from Preet and Elena with their photos and quotes" width="574" height="575" loading="lazy" />
                </div>
                <div class="landing-row-3-right">
                  <img src="/images/yocale/yocale-spanish-landing-page-statistics.webp" alt="Yocale Spanish-language 'Beneficios de Yocale' section showing a laptop mockup alongside four statistics: 86% reduction in no-shows, 34% increase in client bookings, 30% increase in recurring bookings, and 64% increase in new bookings" width="611" height="358" loading="lazy" />
                </div>
              </div>

              <div class="landing-localization">
                <h3 class="landing-localization-title">Localization</h3>
                <p class="landing-localization-body">Latin America is both a key service region and a core target audience. To reach Spanish-speaking users, we built a fully localized landing page that the Latin America sales team could share directly.</p>
              </div>

              <div class="landing-gallery-row-4" data-parallax>
                <img
                  src="/images/yocale/yocale-pay-landing-page.webp"
                  alt="Yocale Pay full-page landing page showing the hero headline, feature highlights, and call-to-action section"
                  width="1440"
                  height="800"
                  loading="lazy"
                />
              </div>

              <div class="landing-gallery-row-5">
                <CaseStudyDeliverableImage
                  src="/images/yocale/yocale-seo-tracking-dashboard.webp"
                  alt="Yocale analytics tracking dashboard showing session data, conversion metrics, and user behaviour insights"
                  width="1196"
                  height="678"
                  maxWidth="1196px"
                />
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

    <section class="case-webdev-section" id="webdev">
      <div class="padding-global">
        <div class="container-main">
          <div class="case-webdev">

            <CaseStudySectionHeader eyebrow="08" title="Web Development" />

            <div class="webdev-compare">
              <CaseStudyCompareSlider
                beforeSrc="/images/yocale/old-blog.svg"
                afterSrc="/images/yocale/new-blog.svg"
                beforeAlt="Screenshot of the original Yocale blog layout from 2023 showing all posts on a single page with no category structure"
                afterAlt="Screenshot of the redesigned Yocale blog layout from 2024 showing structured categories and improved navigation"
                beforeLabel="Before"
                afterLabel="After"
                aspectRatio="1440 / 1176"
              />
            </div>

            <div class="webdev-content">
              <h3 class="webdev-content-title">Redesign to solve SEO issues</h3>
              <p class="webdev-content-body">The site had orphan pages in the blog section — the original layout was dumping the latest 100 posts onto a single page while the archive had far more. I restructured the blog with proper categories so every post is indexed and discoverable.</p>
            </div>

            <div class="webdev-gif">
              <CaseStudyDeliverableImage
                src="/gifs/yocale/Figma MCP.gif"
                alt="Screen recording of the Figma and Webflow MCP Bridge App automating web component creation from designs, showing tool call logs and element builder execution"
                width="1182"
                height="640"
                maxWidth="1196px"
              />
            </div>

            <div class="webdev-ai-content">
              <h3 class="webdev-content-title">AI is taking our job </h3>
              <p class="webdev-content-body">Figma and Webflow each have an MCP that enables certain web component automation (with proper auto-layout), but the current limitation is that they can't automate animations yet.</p>
            </div>

            <div class="webdev-gif">
              <CaseStudyDeliverableImage
                src="/gifs/yocale/Webflow web component.gif"
                alt="Screen recording of a Webflow component being built and configured with editable properties for a pricing card, demonstrating reusable web component creation"
                width="932"
                height="640"
                maxWidth="1196px"
              />
            </div>

            <div class="webdev-content">
              <h3 class="webdev-content-title">Webflow Component</h3>
              <p class="webdev-content-body">Creating reusable web components shortens development time and ensures faster delivery. After all, time is money in the SaaS world.</p>
            </div>

            <div class="webdev-gif">
              <CaseStudyDeliverableImage
                src="/gifs/yocale/Notion to Figma Sync.gif"
                alt="Screen recording of the Notion to Figma Sync plugin syncing Notion database content into Figma design layers, demonstrating content translation across languages"
                width="868"
                height="640"
                maxWidth="1196px"
              />
            </div>

            <div class="webdev-content">
              <h3 class="webdev-content-title">Notion to Figma</h3>
              <p class="webdev-content-body">Working with a content writer, we needed a system to test how content worked within the design. I discovered a plugin that syncs a Notion database with Figma (layers need to be named accordingly). With one click, you can localize designs across different content and languages.</p>
            </div>

          </div>
        </div>
      </div>
    </section>

    <section class="case-closing-section">
      <div class="padding-global">
        <div class="container-main">
          <div class="case-closing">
            <div class="case-closing-media">
              <img src="/images/yocale/yocale-client-star-ratings.webp" alt="Yocale client star ratings and reviews showcasing customer satisfaction across the platform" width="1196" height="984" loading="lazy" data-parallax />
            </div>
          </div>
        </div>
      </div>
    </section>

    <CaseStudyKeepReading current="yocale" />

  </main>
</BaseLayout>

<style>
  .main {
    --case-accent:       var(--accent-yocale);
    --case-accent-solid: var(--accent-yocale-2);
    padding-top:         96px;
    min-height:          100vh;
  }

  /* ── 02 Overview ──────────────────────────── */
  .case-overview-content {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(12px, 1.7vw, 24px);
    margin-bottom:         40px;
  }

  .case-overview :global(.deliverable-image) {
    margin-bottom: 40px;
  }

  .case-overview-heading {
    font-family: var(--font-display);
    font-size:   39px;
    font-weight: 400;
    line-height: 1.2;
    color:       var(--text-1);
  }

  .case-overview-body {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-sm);
  }

  .case-overview-body p {
    font-family: var(--font-body);
    font-size:   16px;
    font-weight: 300;
    line-height: 1.6;
    color:       var(--text-2);
  }

  /* ── 03 Challenge ─────────────────────────── */
  .case-challenge-content {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(12px, 1.7vw, 24px);
    margin-bottom:         clamp(20px, 2.8vw, 40px);
  }

  .case-challenge-heading {
    font-family: var(--font-display);
    font-size:   clamp(25px, 3.1vw, 39px);
    font-weight: 400;
    line-height: 1.2;
    color:       var(--text-1);
  }

  .case-challenge-body {
    font-family: var(--font-body);
    font-size:   16px;
    font-weight: 300;
    line-height: 1.6;
    color:       var(--text-2);
  }

  /* ── 04 Approach ──────────────────────────── */
  .case-approach-content {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-lg);
  }

  .case-approach-item {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(12px, 1.7vw, 24px);
  }

  .case-approach-heading {
    font-family: var(--font-display);
    font-size:   39px;
    font-weight: 400;
    line-height: 1.2;
    color:       var(--text-1);
