---
import BaseLayout from '../../layouts/base-layout.astro';
import CaseStudyHero from '../../components/case-study-hero.astro';
import CaseStudyKeepReading from '../../components/case-study-keep-reading.astro';
---

<BaseLayout title="Delta Controls" world="light">
  <main class="main">

    <CaseStudyHero
      title="Delta Controls – [Placeholder Tagline]"
      fullTitle="Delta Controls: [Placeholder Tagline]"
      lottieSrc="/videos/delta-controls/source-hero.json"
      lottieAspectRatio="764 / 212"
      role={["[Placeholder Role]"]}
      tools={["[Placeholder Tool]"]}
      duration={["[Placeholder Duration]"]}
    />

    <CaseStudyKeepReading current="delta" />

  </main>
</BaseLayout>

<style>
  .main {
    padding-top: 96px;
    min-height:  100vh;
  }

  @media (max-width: 768px) {
    .main { padding-top: 80px; }
  }

  @media (max-width: 520px) {
    .main { padding-top: 72px; }
  }
</style>
