---
import BaseLayout from '../../layouts/base-layout.astro';
import CaseStudyHero from '../../components/case-study-hero.astro';
import CaseStudyOverview from '../../components/case-study-overview.astro';
import CaseStudyHighlight from '../../components/case-study-highlight.astro';
import CaseStudyProblem from '../../components/case-study-problem.astro';
import CaseStudySolution from '../../components/case-study-solution.astro';
import CaseStudyResearch from '../../components/case-study-research.astro';
import CaseStudyKeepReading from '../../components/case-study-keep-reading.astro';
---

<BaseLayout title="Delta Controls" world="light">
  <main class="main">

    <CaseStudyHero
      title="Delta Controls Resource Intranet: The Source 2.0 Overcoming Navigation Difficulties and Ineffective Search"
      fullTitle="Delta Controls Resource Intranet: The Source 2.0 Overcoming Navigation Difficulties and Ineffective Search"
      lottieSrc="/videos/delta-controls/source-hero.json"
      lottieAspectRatio="764 / 212"
      role={["Research", "Design", "Development"]}
      tools={["Marketing Director", "Graphic Designer (for banner)", "Back-end Developer"]}
      toolsLabel="Team:"
      duration={["Planning & Research: 7 weeks", "Ideate & Design: 5 weeks", "Develop & Testing: 8 weeks"]}
    />

    <CaseStudyOverview
      eyebrow="01"
      title="Overview"
      body="The Source is a digital library dedicated to providing non-technical documents, training, and marketing materials to Delta Controls' partners and employees. This project aimed to rebuild the entire platform for a more intuitive and fluent user experience."
      imageSrc="/images/delta/The-Source-Header-1.svg"
      imageAlt="Illustration of two hands holding a glowing digital book surrounded by a network of icons representing courses, calendars, messaging, and connected devices"
    />

    <CaseStudyHighlight
      id="impact"
      eyebrow="02"
      title="Impact"
      stats={[
        { value: "2-3 clicks", caption: "Average click to access information" },
        { value: "15% ↑", caption: "Engagement rate" },
        { value: "22.5% ↑", caption: "Download conversion rate" },
      ]}
      compareBeforeSrc="/images/delta/old.svg"
      compareAfterSrc="/images/delta/new.svg"
      compareBeforeAlt="Screenshot of the original Source intranet homepage layout"
      compareAfterAlt="Screenshot of the redesigned Source 2.0 intranet homepage layout"
      compareBeforeLabel="Old Source"
      compareAfterLabel="Source 2.0"
      compareAspectRatio="4 / 3"
    />

    <CaseStudyProblem
      id="problem"
      eyebrow="03"
      title="Problem"
      headline="Users couldn't navigate and search effectively."
      items={[
        { title: "A. Unclear Navigation", body: "Users averaged 4–6 clicks to locate necessary files, which wasted a significant amount of time and reduced productivity." },
        { title: "B. Ineffective Search", body: "70% of users relied on search capabilities, but results were ineffective due to WordPress preset index constraints." },
        { title: "C. Unorganized Category & Layout", body: "Tags are all over the place, and users expect more logical layouts." },
      ]}
      imageSrc="/gifs/delta/user-problem-Source.gif"
      imageAlt="Screen recording of a user browsing The Source's original document library, navigating categories and using the search and filter tools"
    />

    <CaseStudySolution
      id="solution"
      eyebrow="04"
      title="Solution"
      tinted
      mediaRows={[
        {
          imageSrc: "/gifs/delta/navigation.gif",
          imageAlt: "Animated screen recording of The Source 2.0's redesigned homepage with a centralized navigation hub and a hero banner reading 'Your Go-To Resource Hub'",
          title: "Streamlined Access Through a Centralized Resource Hub",
          body: "Create a clear navigation system that is consistent with the company's design system. Simplified navigation reduces clicks to 3-4, ensuring faster information retrieval.",
        },
        {
          imageSrc: "/gifs/delta/search.gif",
          imageAlt: "Animated screen recording of The Source 2.0's category cards and smart search dropdown showing tag suggestions like 'national account' and 'sales and marketing'",
          title: "Enhanced Discoverability with Smart Search",
          body: "The Source will use unified smart search, which will allow all documents, categories, and tags to be searched. Users can fill out a feedback form to notify the marketing staff of any missing content.",
        },
        {
          imageSrc: "/gifs/delta/customisation.gif",
          imageAlt: "Animated screen recording of The Source 2.0's personalized 'Recently Downloaded' section showing document cards for quick access",
          title: "A Modern, Personalized Resource Experience",
          body: "Our modern logical layout enhances customization, featuring recent and most-downloaded documents for quick access. Ensuring an efficient user experience tailored to your needs.",
        },
      ]}
    />

    <CaseStudyResearch
      id="research"
      eyebrow="05"
      title="Research"
      surveyCols={[
        {
          label: "Global Survey for Existing Users",
          items: ["USA, Canada, Europe, Asia", "Anonymous response collection"],
          imageSrc: "/images/delta/global.png",
          imageAlt: "Illustration of a glowing digital globe with cyan network lines highlighting global regions, representing the worldwide reach of the survey",
        },
        {
          label: "Cross-Functional Participants",
          items: ["Department including: sales, technical, support", "Email invitation distribution"],
          imageSrc: "/images/delta/research-work-cloud%201.png",
          imageAlt: "Word cloud of frequent terms from user feedback, with 'search', 'find', 'information', and 'content' shown as the largest and most prominent words",
        },
      ]}
      stats={[
        { value: "43%", title: "Low Usage Frequency", body: "Nearly half of users access the platform less than once per month" },
        { value: "3/5", title: "Low Satisfaction", body: "The average satisfaction score shows tremendous opportunity for improvement." },
        { value: "69%", title: "Excessive Clicking", body: "Users require 4-6+ clicks to access needed information" },
      ]}
      imageSrc="/images/delta/feedback.png"
      imageAlt="Screenshot of a Slack message from Andrew Yip sharing survey findings about the Source Portal, including response counts by department and key findings on click counts, satisfaction, and user pain points"
      quotePanels={[
        {
          imageSrc: "/images/delta/James-interview-screenshot%201.png",
          imageAlt: "Video call screenshot of James Ferdon, Business Development Manager, during a user interview about the Source Portal",
          quote: "If people tell you to search a file at the Source, they basically tell you to go Fxxk yourself",
          attribution: "James Ferdon, Business Development Manager",
        },
        {
          imageSrc: "/images/delta/Tim-interview-screenshot%201.png",
          imageAlt: "Video call screenshot of Tim Arion, Sales Director, during a user interview about the Source Portal",
          quote: "You need to be really familiar with the platform to understand you can get everything from the Index",
          attribution: "Tim Arion, Sales Director",
        },
      ]}
    />

    <CaseStudyKeepReading current="delta" />

  </main>
</BaseLayout>

<style>
  .main {
    --case-accent: var(--accent-delta);
    padding-top:   96px;
    min-height:    100vh;
  }

  @media (max-width: 768px) {
    .main { padding-top: 80px; }
  }

  @media (max-width: 520px) {
    .main { padding-top: 72px; }
  }
</style>
