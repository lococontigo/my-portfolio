---
import BaseLayout from '../../layouts/base-layout.astro';
import CaseStudyHero from '../../components/case-study-hero.astro';
import CaseStudyHighlight from '../../components/case-study-highlight.astro';
import CaseStudyProblem from '../../components/case-study-problem.astro';
import CaseStudySolution from '../../components/case-study-solution.astro';
import CaseStudySectionHeader from '../../components/case-study-section-header.astro';
import CaseStudyInsightCard from '../../components/case-study-insight-card.astro';
import CaseStudyKeepReading from '../../components/case-study-keep-reading.astro';

const sections = [
  { id: 'highlight', label: '01-Highlight' },
  { id: 'problem',   label: '02-Problem' },
  { id: 'solution',  label: '03-Solution' },
  { id: 'research',  label: '04-Research' },
  { id: 'design',    label: '05-Design' },
  { id: 'identity',  label: '06-Visual Identity' },
  { id: 'takeaways', label: '07-Takeaways' },
];
---

<BaseLayout title="Crowd Ease" world="light" sections={sections}>
  <main class="main">

    <CaseStudyHero
      title="Crowd Ease – Business Productivity App for Restaurant Management & Marketing Strategy"
      fullTitle="Crowd Ease: Business Productivity App for Restaurant Management & Marketing Strategy"
      accentTitle="Crowd Ease"
      videoSrc="/videos/crowd-ease/crowd_ease_promotional_animation_v1%20(720p).mp4"
      role={["Research", "Design Token", "Map Design", "Project Management"]}
      tools={["Figma", "Adobe Suite", "Jira", "Slack"]}
      duration={["Planning & Research: 3 weeks", "Ideate & Design: 3 weeks", "Develop & Testing: 6 weeks"]}
    />

    <CaseStudyHighlight
      id="highlight"
      eyebrow="01"
      title="Highlight"
      stats={[
        { value: "Capstone Award", caption: "Langara College Audience Winning" },
        { value: "Cross-functional", caption: "4 developers & 3 designers" },
        { value: "8 weeks Built MVP", caption: "Agile Development" },
      ]}
      imageSrc="/images/crowd-ease/Handout-Front.svg"
      imageAlt="Crowd Ease promotional handout: app logo and tagline 'Be in the Know - Track Events and Monitor Live Crowds with Ease!' alongside a phone mockup showing live event crowd data"
    />

    <CaseStudyProblem
      id="problem"
      eyebrow="02"
      title="Problem"
      rows={[
        {
          title: "Restaurant promotion could be hard.",
          body: "Managers may have a hard time finding the right promotion strategy for the business. They need insights into effective strategies and actionable steps to achieve optimal results. Without a management assisting tool, it is difficult for a small restaurant to retain its service quality and sales quantity.",
        },
        {
          title: "Restaurant management struggle with resource planning.",
          body: "Resource planning is one of the biggest headaches for restaurant owners and managers since they commonly lack customer traffic information. As a result, they might encounter instances where there is a rush of customers due to an event nearby, or have a slower than average night, which results in an inaccurate arrangement of staff and inventory.",
        },
      ]}
    />

    <CaseStudySolution
      id="solution"
      eyebrow="03"
      title="Solution"
      rows={[
        {
          imageSrc: "/gifs/crowd-ease/DASHBOARD.gif",
          imageAlt: "Crowd Ease home screen showing a bar chart of weekly event participants, a 'View Full Report' button, and a promotional suggestion prompt",
          title: "Data Visualization for Business Planning Insights",
          body: "The first element on the homepage is a graph to show the event participants throughout the week because the main purpose of this app is to assist users in getting ready for their business planning. The goal of the data visualization is to facilitate easy analysis at a glance. Then, we give them some calls to action to remind them of the day they should be paying attention to.",
        },
        {
          imageSrc: "/gifs/crowd-ease/DATA-.gif",
          imageAlt: "Crowd Ease home screen leading into the full weekly report with deep data analysis and business strategy suggestions",
          title: "Deep Data Analyze & Strategy Suggestion",
          body: "It is the core of the app, where users can find all the analysis and advice they need for marketing and business planning. Users can explore the app and learn about the value we provide to build a significant acquisition funnel, but when it comes to this page, we require users to sign up or log in, in order to access the report. After that, users can use the top arrow to see a brief report covering the period from this week to next week. Crowd Ease will break down each day's events and provide detailed analysis as well as business recommendations.",
          reverse: true,
        },
        {
          imageSrc: "/gifs/crowd-ease/EVENT.gif",
          imageAlt: "Crowd Ease event list screen with a weekly day picker, search bar, and a filterable list of nearby events",
          title: "Event Overview & Smart Filtering",
          body: "The calendar makes it simple for users to switch around days. We offer options for text search, voice search, event category filtering, and location filtering to ensure a seamless user experience and make it simple for users to find the information they require.",
        },
        {
          imageSrc: "/gifs/crowd-ease/MAP.gif",
          imageAlt: "Crowd Ease event detail screen for 'Cocktail for a Cure 2023' showing event info, location, and a live crowd density heat map",
          title: "Live Crowd Density & Event Location",
          body: "The team created the map by extracting data from various APIs. As a result, this map shows the crowd density in various colors so that users can see how the crowd is moving and modify their activities accordingly. In order to give the user a greater knowledge of the accuracy, we also combined the heated map with a pin map to show the locations of each event.",
          reverse: true,
        },
      ]}
      videoSrc="/videos/crowd-ease/demo.mp4"
    />

    <section class="case-research-section" id="research">
      <div class="padding-global">
        <div class="container-main">
          <div class="case-research">

            <CaseStudySectionHeader eyebrow="04" title="Research Insight" />

            <div class="case-research-cards">
              <CaseStudyInsightCard
                title="Poor Management and Advertising"
                body="I have experienced difficulties in keeping track of local events as we do not have a tool to assist us with that. Although we have a point of sale system, our management and advertising are not streamlined, which can be challenging for our business."
                attribution="Restaurant Manager"
                imageSrc="/images/crowd-ease/shop_3d_Night_Cold.png"
                imageAlt="3D rendering of a restaurant storefront at night with a striped awning and lit sign"
              />
              <CaseStudyInsightCard
                title="Short Preparation Time"
                body="As a manager, I usually plan my inventory and staff schedule a week in advance to ensure smooth operations and avoid any last-minute surprises."
                attribution="Restaurant Owner"
                imageSrc="/images/crowd-ease/Oops.png"
                imageAlt="3D 'Oops!' text illustration in purple and green"
              />
            </div>

            <div class="case-research-image case-research-competitors">
              <img src="/images/crowd-ease/crowdeasecompetitors.png" alt="Competitor analysis comparing Crowd Ease against Crowd Alerts, Crowd Vision, and Crowd Connected across real-time crowd tracking, analytics and reporting, and event tracking — Crowd Ease meets all three criteria" width="836" height="535" loading="lazy" />
            </div>

            <div class="case-research-caption">
              <h3 class="case-research-caption-title">Competitors Analysis</h3>
              <p class="case-research-caption-body">Like our competitors, we all use crowd data on the high mobility industry. However, we are not only able to provide real time data, Crowd Ease combines events around a user’s location and provides an analysis so a business can customize their marketing plan and arrange their business accordingly.</p>
            </div>

            <div class="case-research-image case-research-userflow">
              <img src="/images/crowd-ease/crowdease-userfolw.png" alt="Crowd Ease user flow diagram showing the navigation paths between onboarding, login, home, map, events, report, and profile screens" width="1269" height="751" loading="lazy" />
            </div>

            <div class="case-research-caption">
              <h3 class="case-research-caption-title">User Flow</h3>
              <p class="case-research-caption-body">The team struggled with the user flow as we were unsure of the core feature before beginning to define the interaction design and information architecture of the app. We scheduled an appointment to talk with the app’s developers and other stakeholders and collect feedback on how the app’s features flowed, which was a crucial guidepost for determining the project’s scope.</p>
            </div>

            <div class="case-research-image">
              <img src="/images/crowd-ease/teamwork.png" alt="Illustration of a team collaborating around a table with laptops and design materials" width="2048" height="1196" loading="lazy" />
            </div>


          </div>
        </div>
      </div>
    </section>

    <section class="case-design-section" id="design">
      <div class="padding-global">
        <div class="container-main">
          <div class="case-design">

            <CaseStudySectionHeader eyebrow="05" title="Design" />

            <div class="case-design-wireframes">
              <div class="case-design-wireframes-text">
                <h3 class="case-design-wireframes-title">Wireframes</h3>
                <p class="case-design-wireframes-body">The team finally grasped the key feature – Analytics and Reporting, considering the event data is an effective indicator for decision-making, and also given that the pain point of restaurant owners is that they have trouble filling up their tables.</p>
                <p class="case-design-wireframes-body">It was a big validation and I am grateful that my teammates trusted my design suggestion. Following that, we had an agreement on how it would operate, and we created wireframes under that understanding.</p>
              </div>
              <div class="case-design-wireframes-image">
                <img src="/images/crowd-ease/crowdease-wireframe-drawing.jpeg" alt="Hand-drawn wireframe sketches mapping out Crowd Ease's home, map, event list, and crowd report screens with annotations" width="1170" height="923" loading="lazy" />
              </div>
            </div>

            <div class="case-design-gallery">
              <div class="case-design-gallery-row" data-gallery-row="1">
                <img src="/images/crowd-ease/crowdease-mockup-passed-events-rating.png" alt="Passed Events screen prompting the user to rate how much an event affected their business" width="226" height="494" loading="lazy" />
                <img src="/images/crowd-ease/crowdease-mockup-event-list.png" alt="Event list screen showing a weekly calendar and a list of upcoming events with participant counts" width="226" height="492" loading="lazy" />
                <img src="/images/crowd-ease/crowdease-mockup-sign-up.png" alt="Sign up screen with email, password, and business name fields, plus social sign-up options" width="226" height="494" loading="lazy" />
                <img src="/images/crowd-ease/crowdease-mockup-event-detail.png" alt="Event detail screen for the Vancouver Career Fair showing date, location, description, and a map preview" width="226" height="492" loading="lazy" />
                <img src="/images/crowd-ease/crowdease-mockup-event-filters.png" alt="Event filters overlay with event category and distance options" width="226" height="492" loading="lazy" />
                <img src="/images/crowd-ease/crowdease-mockup-location-permission.png" alt="Location permission screen asking the user to enable GPS or enter a postal code" width="226" height="492" loading="lazy" />
              </div>
              <div class="case-design-gallery-row" data-gallery-row="2">
                <img src="/images/crowd-ease/crowdease-mockup-profile-settings.png" alt="Profile and settings screen with notification preferences and account options" width="226" height="492" loading="lazy" />
                <img src="/images/crowd-ease/crowdease-mockup-event-list-alt.png" alt="Event list screen showing a weekly calendar and a list of upcoming events with participant counts" width="226" height="492" loading="lazy" />
                <img src="/images/crowd-ease/crowdease-mockup-business-insights.png" alt="Business insights screen recommending a focus on concert event promotion, with participation breakdowns by category" width="226" height="493" loading="lazy" />
                <img src="/images/crowd-ease/crowdease-mockup-map-heatmap.png" alt="Map screen showing a live crowd density heat map around downtown Vancouver" width="226" height="493" loading="lazy" />
                <img src="/images/crowd-ease/crowdease-mockup-weekly-report.png" alt="Weekly event preview report listing event numbers and participant totals for each day" width="226" height="494" loading="lazy" />
                <img src="/images/crowd-ease/crowdease-mockup-passed-events.png" alt="Passed Events screen listing past events with options to rate each one" width="226" height="494" loading="lazy" />
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

    <section class="case-identity-section" data-theme="dark" id="identity">
      <div class="padding-global">
        <div class="container-main">
          <div class="case-identity">

            <CaseStudySectionHeader eyebrow="06" title="Visual Identity" />

            <div class="case-identity-intro">
              <h3 class="case-identity-intro-title">Design System</h3>
              <p class="case-identity-intro-body">I worked on the UI kit and made the icons using Illustrator in accordance with the Google Material Design Guidelines. I also established the design system to maintain the same design aesthetic across all screens.</p>
            </div>

            <div class="case-identity-image">
              <img src="/images/crowd-ease/colors.png" alt="Crowd Ease brand color palette: purple, green, blue, and yellow swatches with hex codes B687FF, 90EE90, 68B5DE, and FFFA6E" width="464" height="270" loading="lazy" />
              <img src="/images/crowd-ease/type.png" alt="Circular STD typeface specimen used for Crowd Ease headings and body text" width="464" height="270" loading="lazy" />
              <img src="/images/crowd-ease/icons.png" alt="Grid of outlined UI icons used across Crowd Ease for navigation, profile, notifications, and more" width="464" height="270" loading="lazy" />
            </div>

          </div>
        </div>
      </div>
    </section>

    <section class="case-ia-section">
      <div class="padding-global">
        <div class="container-main">
          <div class="case-ia">

            <div class="case-ia-image">
              <img src="/images/crowd-ease/Crowd-Ease-IA.svg" alt="Crowd Ease information architecture diagram showing the app's screen hierarchy and navigation structure" width="1357" height="1412" loading="lazy" />
            </div>

          </div>
        </div>
      </div>
    </section>

    <section class="case-takeaways-section" id="takeaways">
      <div class="padding-global">
        <div class="container-main">
          <div class="case-takeaways">

            <CaseStudySectionHeader eyebrow="07" title="Takeaways" />

            <div class="case-takeaways-image">
              <img src="/images/crowd-ease/panelists.png" alt="The Crowd Ease team presenting their project to a panel and audience, with a slide showing team member headshots and a QR code to connect" width="2048" height="769" loading="lazy" />
            </div>

            <div class="case-takeaways-caption">
              <h3 class="case-takeaways-caption-title">Acquisition funnel for UX design</h3>
              <p class="case-takeaways-caption-body">From business perspective, this funnel is an important way to increase user acquisition and retention. In Crowd Ease, we need to remove the blockers and ensure that users discover the value of the product or service before they register an account or commit to a purchase. I understand users build up a level of excitement when they download our app and I need to continue that anticipation and make sure that users have a clear understanding of its benefits and features before they are asked to commit.</p>
            </div>

          </div>
        </div>
      </div>
    </section>

    <CaseStudyKeepReading current="crowd-ease" />

  </main>
</BaseLayout>

<style>
  .main {
    padding-top: 96px;
    min-height:  100vh;
  }

  .page-content {
    padding-top:    var(--space-xl);
    padding-bottom: var(--space-xl);
  }

  /* ── 05 Research Insight ─────────────────── */
  .case-research-cards {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(12px, 1.7vw, 24px);
    margin-bottom:         clamp(32px, 5.5vw, 80px);
  }

  .case-research-image {
    margin-bottom: clamp(32px, 5.5vw, 80px);
  }

  .case-research-image:last-child {
    margin-bottom: 0;
  }

  .case-research-image img {
    display:       block;
    width:         100%;
    height:        auto;
    border-radius: var(--r-lg);
  }

  .case-research-competitors,
  .case-research-userflow {
    border-radius: var(--r-lg);
    padding:       var(--space-lg);
    margin-bottom: clamp(20px, 2.8vw, 40px);
  }

  .case-research-competitors {
    background: var(--bg-2);
  }

  .case-research-userflow {
    background: var(--surface);
  }

  .case-research-competitors img,
  .case-research-userflow img {
    max-width:     1196px;
    margin-inline: auto;
  }

  .case-research-caption {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(12px, 1.7vw, 24px);
    max-width:             var(--max-w);
    margin-inline:         auto;
    margin-bottom:         clamp(32px, 5.5vw, 80px);
  }

  .case-research-caption-title {
    font-family:    var(--font-display);
    font-size:      clamp(28px, 3.1vw, 45px);
    font-weight:    400;
    line-height:    1.2;
    letter-spacing: -0.28px;
    color:          var(--text-1);
  }

  .case-research-caption-body {
    font-family: var(--font-body);
    font-size:   15px;
    font-weight: 300;
    line-height: 1.6;
    color:       var(--text-1);
  }

  .case-research-ia {
    max-width:     var(--max-w);
    margin-inline: auto;
    margin-top:    clamp(40px, 11vw, 128px);
  }

  .case-research-ia img {
    display:       block;
    width:         100%;
    height:        auto;
    border-radius: var(--r-lg);
  }

  /* ── 06 Design ───────────────────────────── */
  .case-design-wireframes {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(12px, 1.7vw, 24px);
    align-items:           center;
    margin-bottom:         clamp(32px, 5.5vw, 80px);
  }

  .case-design-wireframes-title {
    font-family:    var(--font-display);
    font-size:      clamp(28px, 3.1vw, 45px);
    font-weight:    400;
    line-height:    1.2;
    letter-spacing: -0.28px;
    color:          var(--text-1);
    margin-bottom:  clamp(16px, 1.7vw, 24px);
  }

  .case-design-wireframes-body {
    font-family:   var(--font-body);
    font-size:     15px;
    font-weight:   300;
    line-height:   1.6;
    color:         var(--text-1);
    margin-bottom: var(--space-sm);
  }

  .case-design-wireframes-body:last-child {
    margin-bottom: 0;
  }

  .case-design-wireframes-image img {
    display:       block;
    width:         100%;
    height:        auto;
    border-radius: var(--r-lg);
  }

  .case-design-gallery {
    display:        flex;
    flex-direction: column;
    gap:            clamp(12px, 1.7vw, 24px);
    overflow:       hidden;
  }

  .case-design-gallery-row {
    display:               grid;
    grid-template-columns: repeat(6, 1fr);
    gap:                   clamp(12px, 1.7vw, 24px);
    will-change:           transform;
  }

  .case-design-gallery img {
    display:       block;
    width:         100%;
    height:        auto;
    border-radius: var(--r-md);
  }

  /* ── 07 Visual Identity ──────────────────── */
  .case-identity-section {
    background: var(--bg);
  }

  .case-identity-intro {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(12px, 1.7vw, 24px);
    margin-bottom:         clamp(32px, 5.5vw, 80px);
  }

  .case-identity-intro-title {
    font-family:    var(--font-display);
    font-size:      clamp(28px, 3.1vw, 45px);
    font-weight:    400;
    line-height:    1.2;
    letter-spacing: -0.28px;
    color:          var(--text-1);
  }

  .case-identity-intro-body {
    font-family: var(--font-body);
    font-size:   15px;
    font-weight: 300;
    line-height: 1.6;
    color:       var(--text-2);
  }

  .case-identity-image {
    display:               grid;
    grid-template-columns: repeat(3, 1fr);
    gap:                   clamp(12px, 1.7vw, 24px);
  }

  .case-identity-image img {
    display: block;
    width:   100%;
    height:  auto;
  }

  /* ── Information Architecture interlude ──── */
  .case-ia-image {
    background:    var(--bg-2);
    padding:       var(--space-lg);
    border-radius: var(--r-lg);
  }

  .case-ia-image img {
    display:       block;
    width:         100%;
    max-width:     1196px;
    height:        auto;
    margin-inline: auto;
    border-radius: var(--r-lg);
  }

  /* ── 08 Takeaways ─────────────────────────── */
  .case-takeaways-image {
    margin-bottom: clamp(32px, 5.5vw, 80px);
  }

  .case-takeaways-image img {
    display:       block;
    width:         100%;
    height:        auto;
    border-radius: var(--r-lg);
  }

  .case-takeaways-caption {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(12px, 1.7vw, 24px);
    max-width:             var(--max-w);
    margin-inline:         auto;
  }

  .case-takeaways-caption-title {
    font-family:    var(--font-display);
    font-size:      clamp(28px, 3.1vw, 45px);
    font-weight:    400;
    line-height:    1.2;
    letter-spacing: -0.28px;
    color:          var(--text-1);
  }

  .case-takeaways-caption-body {
    font-family: var(--font-body);
    font-size:   15px;
    font-weight: 300;
    line-height: 1.6;
    color:       var(--text-1);
  }

  @media (max-width: 1024px) {
    .case-design-gallery-row {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 768px) {
    .main { padding-top: 80px; }

    .case-research-cards {
      grid-template-columns: 1fr;
      gap:                   var(--space-sm);
    }

    .case-research-competitors,
    .case-research-userflow,
    .case-ia-image {
      padding: var(--space-md);
    }

    .case-research-caption {
      grid-template-columns: 1fr;
      gap:                   var(--space-sm);
    }

    .case-design-wireframes {
      grid-template-columns: 1fr;
      gap:                   var(--space-sm);
    }

    .case-design-gallery-row {
      grid-template-columns: repeat(3, 1fr);
    }

    .case-identity-intro {
      grid-template-columns: 1fr;
      gap:                   var(--space-sm);
    }

    .case-identity-image {
      grid-template-columns: 1fr;
      gap:                   var(--space-sm);
    }

    .case-takeaways-caption {
      grid-template-columns: 1fr;
      gap:                   var(--space-sm);
    }
  }

  @media (max-width: 520px) {
    .main { padding-top: 72px; }

    .case-research-competitors,
    .case-research-userflow,
    .case-ia-image {
      padding: var(--space-sm);
    }

    .case-design-gallery-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
