---
import BaseLayout from '../../layouts/base-layout.astro';
import CaseStudyHero from '../../components/case-study-hero.astro';
import CaseStudyHighlight from '../../components/case-study-highlight.astro';
import CaseStudyProblem from '../../components/case-study-problem.astro';
import CaseStudyKeepReading from '../../components/case-study-keep-reading.astro';
import CaseStudySectionHeader from '../../components/case-study-section-header.astro';
import CaseStudyDeliverableImage from '../../components/case-study-deliverable-image.astro';
import CaseStudyDeliverableSlider from '../../components/case-study-deliverable-slider.astro';

const sections = [
  { id: 'impact',       label: '01-Impact' },
  { id: 'identity',     label: '02-Visual Identity' },
  { id: 'approach',     label: '04-Approach' },
  { id: 'deliverables', label: '05-Deliverables' },
];

const sliderCards = [
  { src: '/images/ant/Card/default-2.png', w: 453, h: 576, alt: 'Material Handling category card showing a telehandler lifting a red counterweight attachment' },
  { src: '/images/ant/Card/default.png',   w: 453, h: 566, alt: 'Aerial Work Platforms category card showing an orange and cream JLG telescopic boom lift' },
  { src: '/images/ant/Card/default-1.png', w: 453, h: 566, alt: 'Earth Moving category card showing a John Deere compact track loader with a bucket' },
  { src: '/images/ant/Card/default-5.png', w: 453, h: 566, alt: 'Forklifts category card showing a red Hangcha forklift' },
  { src: '/images/ant/Card/default-3.png', w: 453, h: 576, alt: 'Compaction category card showing a yellow BOMAG tandem roller' },
  { src: '/images/ant/Card/default-4.png', w: 453, h: 566, alt: 'Air Compressors category card showing a towable ELGi diesel air compressor' },
];
---

<BaseLayout title="Ant Equipment Group" world="light" sections={sections}>
  <main class="main">

    <CaseStudyHero
      title="Ant Rentals: Building a Brand for Digital Presence"
      fullTitle="Ant Rentals: Building a Brand for Digital Presence"
      accentTitle="Ant Rentals"
      videoSrc="/videos/ant/ant-rentals-demo.mp4"
      role={["Digital Design", "Content Management", "Web Development"]}
      tools={["Figma", "Adobe Suite", "WordPress", "HubSpot"]}
      duration={["2023 – 2024"]}
    />

    <CaseStudyHighlight
      id="impact"
      eyebrow="01"
      title="Impact"
      stats={[
        { value: ">1k", caption: "Website visitor per month" },
        { value: "80% ↑", caption: "Engagement connections" },
        { value: "40% ↓", caption: "Bounce rate" },
      ]}
    />

    <section class="case-identity-section" id="identity">
      <div class="padding-global">
        <div class="container-main">
          <div class="case-identity">

            <CaseStudySectionHeader eyebrow="02" title="Visual Identity" />

            <div class="case-identity-grid">
              <img src="/images/ant/colors.png" alt="Ant Rentals brand color palette swatches with hex codes" width="464" height="212" loading="lazy" />
              <img src="/images/ant/type.png" alt="Ant Rentals typography: Montserrat typeface shown in regular and bold weights" width="464" height="212" loading="lazy" />
              <img src="/images/ant/logo.png" alt="Ant Rentals logo lockups shown in two sizes" width="464" height="212" loading="lazy" />
            </div>

            <div class="case-identity-gallery">
              <img src="/images/ant/Post-for-Meta.png" alt="Social media post announcing the new XCMG N25 Forklift with its specifications" width="1080" height="1080" loading="lazy" />
              <img src="/images/ant/brand-new-equipment.png" alt="Ant Rentals social media post announcing brand new equipment, showing a delivery truck transporting a boom lift" width="1080" height="1080" loading="lazy" />
              <img src="/images/ant/service-post.png" alt="Ant Rentals social media post for its regular maintenance program, showing a technician servicing equipment" width="1080" height="1080" loading="lazy" />
              <img src="/images/ant/Canada-Day-Instagram-Post.png" alt="Ant Rentals Canada Day Instagram post with a maple leaf graphic and construction equipment" width="1080" height="1080" loading="lazy" />
              <img src="/images/ant/forklift-division.png" alt="Ant Rentals social media post promoting its forklift rentals and sales division" width="1080" height="1080" loading="lazy" />
              <img src="/images/ant/hail-storm.png" alt="Ant Rentals social media post offering hail storm damage recovery support for Calgary" width="1080" height="1080" loading="lazy" />
              <img src="/images/ant/spring-projects.png" alt="Ant Rentals social media post promoting equipment pre-orders for spring projects, featuring a boom lift" width="1512" height="1512" loading="lazy" />
              <img src="/images/ant/compaction.png" alt="Ant Rentals social media post advertising a 15% off new stock offer on compaction equipment" width="1080" height="1080" loading="lazy" />
            </div>

          </div>
        </div>
      </div>
    </section>

    <CaseStudyProblem
      id="approach"
      eyebrow="04"
      title="Approach"
      rows={[
        { title: "Build on the brand", body: "Corporate with WOW branding, we have an elaborated brand guideline and my job is to build on top with all sort of marketing materials, like social media post, website, and presentation etc." },
        { title: "Optimize existing website", body: "There was an existing WordPress website when I took over and I found some places that would be optimized to avoid confusion." },
        { title: "Design for more", body: "Apart from the existing web architecture, I integrated a blog section, a career page, and an online rental system to scale the business." },
      ]}
    />

    <section class="case-deliverables-section" id="deliverables">
      <div class="padding-global">
        <div class="container-main">
          <div class="case-deliverables">

            <CaseStudySectionHeader eyebrow="05" title="Deliverables" />

            <div class="case-deliverables-rows">
              <div class="case-deliverables-row">
                <img src="/images/ant/Blog.svg" alt="Laptop mockup showing the Ant Rentals WordPress blog page with featured posts and a forklift promotion" width="1024" height="624" loading="lazy" />
                <p class="case-deliverables-row-label">WordPress</p>
              </div>

              <div class="case-deliverables-row case-deliverables-row--stacked">
                <p class="case-deliverables-row-label">Web Development</p>
                <div class="case-deliverables-row-images">
                  <img src="/images/ant/rental.svg" alt="Laptop mockup of the Ant Rentals Equipment Rentals page showing categories for aerial work platforms, air compressors, compaction, earth moving, and material handling equipment" width="1024" height="624" loading="lazy" />
                  <img src="/images/ant/Career.svg" alt="Laptop mockup of an Ant Rentals job posting page for a Mobile Service Mechanic position in Burnaby" width="1024" height="624" loading="lazy" />
                </div>
              </div>

              <CaseStudyDeliverableImage
                src="/images/ant/hero-section.png"
                alt="Ant Rentals website hero banner reading &quot;Western Canada's Largest Independent Source for Equipment Rentals and Sales&quot; over a photo of a fleet of yellow boom lifts, with &quot;Equipment Rentals&quot; and &quot;Create An Account&quot; buttons"
                width="1196"
                height="485"
                maxWidth="1196px"
              />

              <CaseStudyDeliverableSlider
                mediaSrc="/images/ant/coupon-1.png"
                mediaAlt="Ant Rentals promotional coupon reading &quot;Save $500 on rent&quot; with coupon code NEW2024, valid for new online customers until September 30th, 2024"
                mediaWidth="514"
                mediaHeight="591"
                cards={sliderCards}
                ariaLabel="Ant Rentals equipment categories"
              />

              <div class="case-deliverables-row--advantages">
                <img src="/images/ant/advantages.png" alt="Banner highlighting Ant Rentals advantages: Newest Fleet in Town, Ontime Delivery Guarantee, Easy Online Rental, Largest Selection For Parts, and 24/7 Service Support, over a photo of construction equipment at dusk" width="1440" height="358" loading="lazy" />
              </div>

              <div class="case-deliverables-row case-deliverables-row--reviews">
                <div class="case-deliverables-reviews">
                  <div class="case-deliverables-reviews-grid">
                    <div class="case-deliverables-reviews-col">
                      <img src="/images/ant/review-blog/testimonial-1.png" alt="Customer review card from Samantha Swansy, rated 5 stars, titled &quot;Satisfied With The Facilities At Ant Equipment Rentals&quot;" width="378" height="282" loading="lazy" />
                      <img src="/images/ant/review-blog/testimonial-3.png" alt="Customer review card from Ken Fisher, rated 5 stars, titled &quot;Fantastic Team At Ant Equipment Rentals&quot;" width="378" height="282" loading="lazy" />
                      <img src="/images/ant/review-blog/testimonial-2.png" alt="Customer review card from Travis PrintPrint, rated 5 stars, titled &quot;Great Customer Service At Ant Equipment Rentals&quot;" width="378" height="252" loading="lazy" />
                    </div>
                    <div class="case-deliverables-reviews-col">
                      <img src="/images/ant/review-blog/blog-post-3.png" alt="Blog post card dated Nov 17, 2023, titled &quot;The Ant Goes Marching: Ant Equipment Rentals Burnaby, B.C.&quot;, with a photo of a staff member in an Ant Rentals polo shirt standing in front of equipment" width="286" height="459" loading="lazy" />
                      <img src="/images/ant/review-blog/blog-post-4.png" alt="Blog post card dated Feb 07, 2024, titled &quot;Calgary, Get Ready! Ant Rentals Sets the Stage for Grand Opening!&quot;, with an aerial photo of a snow-covered facility and the Ant Rentals logo" width="286" height="371" loading="lazy" />
                    </div>
                  </div>
                </div>
                <div class="case-deliverables-calendar">
                  <img src="/images/ant/wall-calendar.png" alt="Ant Rentals 2024 wall calendar mockup showing a January grid alongside a photo of a telehandler lifting a crane attachment inside a glass-domed atrium, with company contact details" width="586" height="759" loading="lazy" />
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

    <section class="case-closing-section">
      <div class="padding-global">
        <div class="container-main">
          <div class="case-closing">
            <div class="case-closing-media" data-parallax>
              <img src="/images/ant/closing.png" alt="Silhouette of Ant Rentals boom lifts, scissor lifts, and telehandlers against a dramatic orange sunset sky" width="1728" height="816" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <CaseStudyKeepReading current="ant" />

  </main>
</BaseLayout>

<style>
  .main {
    --case-accent: var(--accent-ant);
    padding-top:   96px;
    min-height:    100vh;
  }

  /* ── 02 Visual Identity ──────────────────── */
  .case-identity-grid {
    display:               grid;
    grid-template-columns: repeat(3, 1fr);
    gap:                   clamp(12px, 1.7vw, 24px);
  }

  .case-identity-grid img {
    display: block;
    width:   100%;
    height:  auto;
  }

  .case-identity-gallery {
    display:               grid;
    grid-template-columns: repeat(4, 1fr);
    gap:                   clamp(12px, 1.7vw, 24px);
    margin-top:            clamp(20px, 2.8vw, 40px);
  }

  .case-identity-gallery img {
    display:       block;
    width:         100%;
    height:        auto;
    border-radius: var(--r-lg);
  }

  @media (max-width: 1024px) {
    .case-identity-gallery {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .main { padding-top: 80px; }

    .case-identity-grid {
      grid-template-columns: 1fr;
      gap:                   var(--space-sm);
    }

    .case-identity-gallery {
      grid-template-columns: repeat(2, 1fr);
      gap:                   var(--space-sm);
    }
  }

  /* ── 05 Deliverables ─────────────────────── */
  .case-deliverables-rows {
    display:        flex;
    flex-direction: column;
    gap:            clamp(12px, 1.7vw, 24px);
  }

  .case-deliverables-row {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(12px, 1.7vw, 24px);
    align-items:           center;
    padding:               var(--space-md);
    background:            var(--bg-2);
    border-radius:         var(--r-lg);
  }

  .case-deliverables-row img {
    display: block;
    width:   100%;
    height:  auto;
  }

  .case-deliverables-row-label {
    font-family:    var(--font-display);
    font-size:      clamp(40px, 5.5vw, 80px);
    font-weight:    300;
    line-height:    1.2;
    letter-spacing: -1.04px;
    color:          var(--case-accent, var(--accent-2));
  }

  .case-deliverables-row--stacked {
    display:        flex;
    flex-direction: column;
    align-items:    center;
    gap:            clamp(20px, 2.8vw, 40px);
  }

  .case-deliverables-row-images {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(12px, 1.7vw, 24px);
    width:                 100%;
  }

  .case-deliverables-row--advantages {
    display:         flex;
    justify-content: center;
  }

  .case-deliverables-row--advantages img {
    max-width:     var(--max-w);
    border-radius: var(--r-lg);
  }

  /* Row 6 — static review/blog grid + wall calendar */
  .case-deliverables-row--reviews {
    gap:              24px;
    padding:          0;
    background:       none;
    border-radius:    0;
  }

  .case-deliverables-reviews {
    position:      relative;
    overflow:      hidden;
    aspect-ratio:  586 / 759;
    padding:       var(--space-md);
    background:    var(--bg-2);
    border-radius: var(--r-lg);
  }

  .case-deliverables-reviews-grid {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(12px, 1.7vw, 24px);
    width:                 120%;
  }

  .case-deliverables-reviews-col {
    display:        flex;
    flex-direction: column;
    gap:            clamp(12px, 1.7vw, 24px);
  }

  .case-deliverables-reviews-col img {
    display:       block;
    width:         100%;
    height:        auto;
    border-radius: var(--r-md);
  }

  .case-deliverables-calendar {
    display:         flex;
    justify-content: center;
    padding:         var(--space-md);
    background:      var(--bg-2);
    border-radius:   var(--r-lg);
  }

  .case-deliverables-calendar img {
    display:       block;
    width:         100%;
    height:        auto;
    border-radius: var(--r-md);
  }

  /* ── Closing ──────────────────────────────── */
  .case-closing-media {
    position:      relative;
    width:         100vw;
    height:        350px;
    margin-inline: calc(50% - 50vw);
    overflow:      hidden;
  }

  .case-closing-media img {
    position:   absolute;
    top:        0;
    left:       0;
    width:      100%;
    height:     120%;
    object-fit: cover;
  }

  @media (max-width: 520px) {
    .main { padding-top: 72px; }
  }

  @media (max-width: 768px) {
    .case-deliverables-row {
      grid-template-columns: 1fr;
      gap:                   var(--space-sm);
    }

    .case-deliverables-row-images {
      grid-template-columns: 1fr;
      gap:                   var(--space-sm);
    }
  }
</style>
