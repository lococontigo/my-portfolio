---
import BaseLayout from '../../layouts/base-layout.astro';
import CaseStudyHero from '../../components/case-study-hero.astro';
import CaseStudyHighlight from '../../components/case-study-highlight.astro';
import CaseStudyProblem from '../../components/case-study-problem.astro';
import CaseStudyKeepReading from '../../components/case-study-keep-reading.astro';
import CaseStudySectionHeader from '../../components/case-study-section-header.astro';
import CaseStudyDeliverableImage from '../../components/case-study-deliverable-image.astro';
import CaseStudyDeliverableSlider from '../../components/case-study-deliverable-slider.astro';

const sections = [
  { id: 'impact',       label: '01-Impact' },
  { id: 'identity',     label: '02-Visual Identity' },
  { id: 'approach',     label: '04-Approach' },
  { id: 'deliverables', label: '05-Deliverables' },
];

const sliderCards = [
  { src: '/images/ant/Card/ant-equipment-card-material-handling.webp', w: 453, h: 576, alt: 'Material Handling category card showing a telehandler lifting a red counterweight attachment' },
  { src: '/images/ant/Card/ant-equipment-card-aerial-work-platforms.webp',   w: 453, h: 566, alt: 'Aerial Work Platforms category card showing an orange and cream JLG telescopic boom lift' },
  { src: '/images/ant/Card/ant-equipment-card-earth-moving.webp', w: 453, h: 566, alt: 'Earth Moving category card showing a John Deere compact track loader with a bucket' },
  { src: '/images/ant/Card/ant-equipment-card-forklifts.webp', w: 453, h: 566, alt: 'Forklifts category card showing a red Hangcha forklift' },
  { src: '/images/ant/Card/ant-equipment-card-compaction.webp', w: 453, h: 576, alt: 'Compaction category card showing a yellow BOMAG tandem roller' },
  { src: '/images/ant/Card/ant-equipment-card-air-compressors.webp', w: 453, h: 566, alt: 'Air Compressors category card showing a towable ELGi diesel air compressor' },
];

const identityRows = [
  [
    { src: '/images/ant/ant-xcmg-forklift-social-post.webp', w: 1080, h: 1080, alt: 'Social media post announcing the new XCMG N25 Forklift with its specifications' },
    { src: '/images/ant/ant-brand-new-equipment-social-post.webp', w: 1080, h: 1080, alt: 'Ant Rentals social media post announcing brand new equipment, showing a delivery truck transporting a boom lift' },
    { src: '/images/ant/ant-maintenance-service-social-post.webp', w: 1080, h: 1080, alt: 'Ant Rentals social media post for its regular maintenance program, showing a technician servicing equipment' },
    { src: '/images/ant/ant-canada-day-social-post.webp', w: 1080, h: 1080, alt: 'Ant Rentals Canada Day Instagram post with a maple leaf graphic and construction equipment' },
  ],
  [
    { src: '/images/ant/ant-forklift-division-social-post.webp', w: 1080, h: 1080, alt: 'Ant Rentals social media post promoting its forklift rentals and sales division' },
    { src: '/images/ant/ant-hail-storm-recovery-social-post.webp', w: 1080, h: 1080, alt: 'Ant Rentals social media post offering hail storm damage recovery support for Calgary' },
    { src: '/images/ant/ant-spring-projects-social-post.webp', w: 1512, h: 1512, alt: 'Ant Rentals social media post promoting equipment pre-orders for spring projects, featuring a boom lift' },
    { src: '/images/ant/ant-compaction-equipment-social-post.webp', w: 1080, h: 1080, alt: 'Ant Rentals social media post advertising a 15% off new stock offer on compaction equipment' },
  ],
];
---

<BaseLayout title="Ant Equipment Group" world="light" sections={sections} translated={true} description="How I built Ant Rentals' digital brand presence — driving 1k+ monthly visitors, 80% engagement lift, and 40% bounce rate through digital design and WordPress.">
  <script slot="head" is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://andrewthyip.com/" },
      { "@type": "ListItem", "position": 2, "name": "Ant Equipment Group", "item": "https://andrewthyip.com/work/ant/" }
    ]
  }
  </script>
  <script slot="head" is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": "Ant Rentals: Building a Brand for Digital Presence",
    "description": "Digital design, content management, and web development for ANT Equipment Group — western Canada's largest independent equipment rental source.",
    "url": "https://andrewthyip.com/work/ant/",
    "author": { "@type": "Person", "name": "Andrew Yip", "url": "https://andrewthyip.com" }
  }
  </script>
  <main class="main">

    <CaseStudyHero
      title="Ant Rentals: Building a Brand for Digital Presence"
      fullTitle="Ant Rentals: Building a Brand for Digital Presence"
      accentTitle="Ant Rentals"
      videoSrc="/videos/ant/ant-rentals-demo.mp4"
      role={["Digital Design", "Content Management", "Web Development"]}
      tools={["Figma", "Adobe Suite", "WordPress", "HubSpot"]}
      duration={["2023 – 2024"]}
    />

    <CaseStudyHighlight
      id="impact"
      eyebrow="01"
      title="Impact"
      stats={[
        { value: ">1k", caption: "Website visitor per month" },
        { value: "80% ↑", caption: "Engagement connections" },
        { value: "40% ↓", caption: "Bounce rate" },
      ]}
    />

    <section class="case-identity-section" id="identity">
      <div class="padding-global">
        <div class="container-main">
          <div class="case-identity">

            <CaseStudySectionHeader eyebrow="02" title="Visual Identity" />

            <div class="case-identity-grid" data-stagger-reveal>
              <img src="/images/ant/ant-brand-color-palette.webp" alt="Ant Rentals brand color palette swatches with hex codes" width="464" height="212" loading="lazy" data-stagger-child />
              <img src="/images/ant/ant-brand-typography.webp" alt="Ant Rentals typography: Montserrat typeface shown in regular and bold weights" width="464" height="212" loading="lazy" data-stagger-child />
              <img src="/images/ant/ant-equipment-logo.webp" alt="Ant Rentals logo lockups shown in two sizes" width="464" height="212" loading="lazy" data-stagger-child />
            </div>

            <div class="case-design-gallery">
              {identityRows.map((row) => (
                <div class="case-design-gallery-row">
                  <div class="case-design-gallery-track">
                    {[row, row].map((set, si) => (
                      <div class="case-design-gallery-set" aria-hidden={si === 1 ? 'true' : undefined}>
                        {set.map((img) => (
                          <img src={img.src} alt={si === 0 ? img.alt : ''} width={img.w} height={img.h} loading="lazy" />
                        ))}
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>

          </div>
        </div>
      </div>
    </section>

    <CaseStudyProblem
      id="approach"
      eyebrow="04"
      title="Approach"
      rows={[
        { title: "Build on the brand", body: "Ant Rentals had a strong corporate brand with detailed guidelines. My job was to expand that identity across marketing materials — social media posts, website pages, and presentations." },
        { title: "Optimize existing website", body: "When I joined, an existing WordPress site was already in place. I identified key areas that needed optimization to reduce confusion and improve the user journey." },
        { title: "Design for more", body: "Apart from the existing web architecture, I integrated a blog section, a career page, and an online rental system to scale the business." },
      ]}
    />

    <section class="case-deliverables-section" id="deliverables">
      <div class="padding-global">
        <div class="container-main">
          <div class="case-deliverables">

            <CaseStudySectionHeader eyebrow="05" title="Deliverables" />

            <div class="case-deliverables-rows">
              <div class="case-deliverables-row">
                <img src="/images/ant/Blog.svg" alt="Laptop mockup showing the Ant Rentals WordPress blog page with featured posts and a forklift promotion" width="1024" height="624" loading="lazy" />
                <p class="case-deliverables-row-label">WordPress</p>
              </div>

              <div class="case-deliverables-row case-deliverables-row--stacked">
                <p class="case-deliverables-row-label">Web Development</p>
                <div class="case-deliverables-row-images">
                  <img src="/images/ant/rental.svg" alt="Laptop mockup of the Ant Rentals Equipment Rentals page showing categories for aerial work platforms, air compressors, compaction, earth moving, and material handling equipment" width="1024" height="624" loading="lazy" />
                  <img src="/images/ant/Career.svg" alt="Laptop mockup of an Ant Rentals job posting page for a Mobile Service Mechanic position in Burnaby" width="1024" height="624" loading="lazy" />
                </div>
              </div>

              <CaseStudyDeliverableImage
                src="/images/ant/ant-website-hero-section.webp"
                alt="Ant Rentals website hero banner reading &quot;Western Canada's Largest Independent Source for Equipment Rentals and Sales&quot; over a photo of a fleet of yellow boom lifts, with &quot;Equipment Rentals&quot; and &quot;Create An Account&quot; buttons"
                width="1196"
                height="485"
                maxWidth="1196px"
              />

              <CaseStudyDeliverableSlider
                mediaSrc="/images/ant/ant-equipment-rental-coupon.webp"
                mediaAlt="Ant Rentals promotional coupon reading &quot;Save $500 on rent&quot; with coupon code NEW2024, valid for new online customers until September 30th, 2024"
                mediaWidth="514"
                mediaHeight="591"
                cards={sliderCards}
                ariaLabel="Ant Rentals equipment categories"
              />

              <div class="case-deliverables-row--advantages">
                <img src="/images/ant/ant-equipment-advantages-banner.webp" alt="Banner highlighting Ant Rentals advantages: Newest Fleet in Town, Ontime Delivery Guarantee, Easy Online Rental, Largest Selection For Parts, and 24/7 Service Support, over a photo of construction equipment at dusk" width="1440" height="358" loading="lazy" />
              </div>

              <div class="case-deliverables-row case-deliverables-row--reviews">
                <div class="case-deliverables-reviews">
                  <div class="case-deliverables-reviews-grid">
                    <div class="case-deliverables-reviews-col">
                      <img src="/images/ant/review-blog/ant-testimonial-samantha-swansy.webp" alt="Customer review card from Samantha Swansy, rated 5 stars, titled &quot;Satisfied With The Facilities At Ant Equipment Rentals&quot;" width="378" height="282" loading="lazy" />
                      <img src="/images/ant/review-blog/ant-testimonial-ken-fisher.webp" alt="Customer review card from Ken Fisher, rated 5 stars, titled &quot;Fantastic Team At Ant Equipment Rentals&quot;" width="378" height="282" loading="lazy" />
                      <img src="/images/ant/review-blog/test2.webp" alt="Customer review card from Travis PrintPrint, rated 5 stars, titled &quot;Great Customer Service At Ant Equipment Rentals&quot;" width="378" height="282" loading="lazy" />
                    </div>
                    <div class="case-deliverables-reviews-col">
                      <img src="/images/ant/review-blog/ant-blog-post-burnaby-grand-opening.webp" alt="Blog post card dated Nov 17, 2023, titled &quot;The Ant Goes Marching: Ant Equipment Rentals Burnaby, B.C.&quot;, with a photo of a staff member in an Ant Rentals polo shirt standing in front of equipment" width="286" height="459" loading="lazy" />
                      <img src="/images/ant/review-blog/ant-blog-post-calgary-grand-opening.webp" alt="Blog post card dated Feb 07, 2024, titled &quot;Calgary, Get Ready! Ant Rentals Sets the Stage for Grand Opening!&quot;, with an aerial photo of a snow-covered facility and the Ant Rentals logo" width="286" height="371" loading="lazy" />
                    </div>
                  </div>
                </div>
                <div class="case-deliverables-calendar">
                  <img src="/images/ant/ant-2024-wall-calendar-mockup.webp" alt="Ant Rentals 2024 wall calendar mockup showing a January grid alongside a photo of a telehandler lifting a crane attachment inside a glass-domed atrium, with company contact details" width="586" height="759" loading="lazy" />
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

    <section class="case-closing-section">
      <div class="padding-global">
        <div class="container-main">
          <div class="case-closing">
            <div class="case-closing-media">
              <img src="/images/ant/ant-equipment-fleet-sunset.webp" alt="Silhouette of Ant Rentals boom lifts, scissor lifts, and telehandlers against a dramatic orange sunset sky" width="1728" height="816" loading="lazy" data-parallax />
            </div>
          </div>
        </div>
      </div>
    </section>

    <CaseStudyKeepReading current="ant" />

  </main>
</BaseLayout>

<style>
  .main {
    --case-accent:       var(--accent-ant);
    --case-accent-solid: var(--accent-ant);
    padding-top:         96px;
    min-height:          100vh;
  }

  /* ── 02 Visual Identity ──────────────────── */
  .case-identity-grid {
    display:               grid;
    grid-template-columns: repeat(3, 1fr);
    gap:                   clamp(12px, 1.7vw, 24px);
  }

  .case-identity-grid img {
    display: block;
    width:   100%;
    height:  auto;
  }

  /* Split-track horizontal parallax gallery (driven by initGalleryRows) */
  .case-design-gallery {
    width:          100vw;
    margin-inline:  calc(50% - 50vw);
    margin-top:     clamp(20px, 2.8vw, 40px);
    display:        flex;
    flex-direction: column;
    gap:            clamp(12px, 1.7vw, 24px);
  }

  .case-design-gallery-row {
    overflow: hidden;
  }

  .case-design-gallery-track {
    display:     flex;
    gap:         clamp(12px, 1.7vw, 24px);
    width:       max-content;
    will-change: transform;
  }

  .case-design-gallery-set {
    display: flex;
    gap:     clamp(12px, 1.7vw, 24px);
  }

  .case-design-gallery img {
    display:       block;
    flex-shrink:   0;
    width:         clamp(200px, 26vw, 360px);
    height:        auto;
    border-radius: var(--r-lg);
  }

  @media (max-width: 768px) {
    .main { padding-top: 80px; }

    .case-design-gallery { width: 100%; margin-inline: 0; }

    .case-identity-grid {
      grid-template-columns: 1fr;
      gap:                   var(--space-sm);
    }
  }

  /* ── 05 Deliverables ─────────────────────── */
  .case-deliverables :global(.deliverable-slider) {
    align-items: stretch;
  }

  .case-deliverables :global(.deliverable-slider-marquee) {
    display:         flex;
    align-items:     center;
  }

  .case-deliverables :global(.deliverable-slider-track img) {
    height: 430px;
  }

  .case-deliverables-rows {
    display:        flex;
    flex-direction: column;
    gap:            clamp(12px, 1.7vw, 24px);
  }

  .case-deliverables-row {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(12px, 1.7vw, 24px);
    align-items:           center;
    padding:               var(--space-md);
    background:            var(--bg-2);
    border-radius:         var(--r-lg);
  }

  .case-deliverables-row img {
    display: block;
    width:   100%;
    height:  auto;
  }

  .case-deliverables-row-label {
    font-family:    var(--font-display);
    font-size:      clamp(39px, 5.5vw, 76px);
    font-weight:    300;
    line-height:    1.2;
    text-align:     center;
    letter-spacing: -1.04px;
    color:          var(--case-accent, var(--accent-2));
  }

  .case-deliverables-row--stacked {
    display:        flex;
    flex-direction: column;
    align-items:    center;
    gap:            clamp(20px, 2.8vw, 40px);
  }

  .case-deliverables-row-images {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(12px, 1.7vw, 24px);
    width:                 100%;
  }

  .case-deliverables-row--advantages {
    display:         flex;
    justify-content: center;
  }

  .case-deliverables-row--advantages img {
    width:         100%;
    height:        auto;
    max-width:     var(--max-w);
    border-radius: var(--r-lg);
  }

  /* Row 6 — static review/blog grid + wall calendar */
  .case-deliverables-row--reviews {
    gap:              24px;
    padding:          0;
    background:       none;
    border-radius:    0;
  }

  .case-deliverables-reviews {
    position:      relative;
    overflow:      hidden;
    aspect-ratio:  586 / 759;
    padding:       var(--space-md);
    background:    var(--bg-2);
    border-radius: var(--r-lg);
  }

  .case-deliverables-reviews-grid {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(12px, 1.7vw, 24px);
    width:                 120%;
  }

  .case-deliverables-reviews-col {
    display:        flex;
    flex-direction: column;
    gap:            clamp(12px, 1.7vw, 24px);
  }

  .case-deliverables-reviews-col img {
    display:       block;
    width:         100%;
    height:        auto;
    border-radius: var(--r-md);
  }

  .case-deliverables-calendar {
    display:         flex;
    justify-content: center;
    padding:         var(--space-md);
    background:      var(--bg-2);
    border-radius:   var(--r-lg);
  }

  .case-deliverables-calendar img {
    display:       block;
    width:         100%;
    height:        auto;
    border-radius: var(--r-md);
  }

  /* ── Closing ──────────────────────────────── */
  .case-closing-section {
    padding-bottom: 0;
  }

  :global(.keep-reading-section) {
    padding-bottom: var(--space-lg);
  }

  .case-closing-media {
    position:      relative;
    width:         100vw;
    height:        800px;
    margin-inline: calc(50% - 50vw);
    overflow:      hidden;
  }

  .case-closing-media img {
    position:   absolute;
    top:        0;
    left:       0;
    width:      100%;
    height:     1200px;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .case-deliverables-row {
      grid-template-columns: 1fr;
      gap:                   var(--space-sm);
    }

    .case-deliverables-row-images {
      grid-template-columns: 1fr;
      gap:                   var(--space-sm);
    }

    /* Reviews collage: drop the cropped-peek effect, show cards naturally */
    .case-deliverables-reviews {
      aspect-ratio: auto;
    }

    .case-deliverables-reviews-grid {
      width: 100%;
    }

    .case-closing-media { height: 400px; }

    .case-deliverables :global(.deliverable-slider-track img) {
      height: 280px;
    }
  }

  @media (max-width: 520px) {
    .main { padding-top: 72px; }

    .case-closing-media { height: 280px; }

    .case-deliverables :global(.deliverable-slider-track img) {
      height: 200px;
    }
  }
</style>
