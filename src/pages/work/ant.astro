---
import BaseLayout from '../../layouts/base-layout.astro';
import CaseStudyHero from '../../components/case-study-hero.astro';
import CaseStudyHighlight from '../../components/case-study-highlight.astro';
import CaseStudyProblem from '../../components/case-study-problem.astro';
import CaseStudyKeepReading from '../../components/case-study-keep-reading.astro';
import CaseStudySectionHeader from '../../components/case-study-section-header.astro';

const sections = [
  { id: 'impact',   label: '01-Impact' },
  { id: 'identity', label: '02-Visual Identity' },
  { id: 'approach', label: '04-Approach' },
];
---

<BaseLayout title="Ant Equipment Group" world="light" sections={sections}>
  <main class="main">

    <CaseStudyHero
      title="Ant Rentals: Building a Brand for Digital Presence"
      fullTitle="Ant Rentals: Building a Brand for Digital Presence"
      accentTitle="Ant Rentals"
      videoSrc="/videos/ant/ant-rentals-demo.mp4"
      role={["Digital Design", "Content Management", "Web Development"]}
      tools={["Figma", "Adobe Suite", "WordPress", "HubSpot"]}
      duration={["2023 – 2024"]}
    />

    <CaseStudyHighlight
      id="impact"
      eyebrow="01"
      title="Impact"
      stats={[
        { value: ">1k", caption: "Website visitor per month" },
        { value: "80% ↑", caption: "Engagement connections" },
        { value: "40% ↓", caption: "Bounce rate" },
      ]}
    />

    <section class="case-identity-section" id="identity">
      <div class="padding-global">
        <div class="container-main">
          <div class="case-identity">

            <CaseStudySectionHeader eyebrow="02" title="Visual Identity" />

            <div class="case-identity-grid">
              <img src="/images/ant/colors.png" alt="Ant Rentals brand color palette swatches with hex codes" width="464" height="212" loading="lazy" />
              <img src="/images/ant/type.png" alt="Ant Rentals typography: Montserrat typeface shown in regular and bold weights" width="464" height="212" loading="lazy" />
              <img src="/images/ant/logo.png" alt="Ant Rentals logo lockups shown in two sizes" width="464" height="212" loading="lazy" />
            </div>

            <div class="case-identity-gallery">
              <img src="/images/ant/Post-for-Meta.png" alt="Social media post announcing the new XCMG N25 Forklift with its specifications" width="1080" height="1080" loading="lazy" />
              <img src="/images/ant/brand-new-equipment.png" alt="Ant Rentals social media post announcing brand new equipment, showing a delivery truck transporting a boom lift" width="1080" height="1080" loading="lazy" />
              <img src="/images/ant/service-post.png" alt="Ant Rentals social media post for its regular maintenance program, showing a technician servicing equipment" width="1080" height="1080" loading="lazy" />
              <img src="/images/ant/Canada-Day-Instagram-Post.png" alt="Ant Rentals Canada Day Instagram post with a maple leaf graphic and construction equipment" width="1080" height="1080" loading="lazy" />
              <img src="/images/ant/forklift-division.png" alt="Ant Rentals social media post promoting its forklift rentals and sales division" width="1080" height="1080" loading="lazy" />
              <img src="/images/ant/hail-storm.png" alt="Ant Rentals social media post offering hail storm damage recovery support for Calgary" width="1080" height="1080" loading="lazy" />
              <img src="/images/ant/spring-projects.png" alt="Ant Rentals social media post promoting equipment pre-orders for spring projects, featuring a boom lift" width="1512" height="1512" loading="lazy" />
              <img src="/images/ant/compaction.png" alt="Ant Rentals social media post advertising a 15% off new stock offer on compaction equipment" width="1080" height="1080" loading="lazy" />
            </div>

          </div>
        </div>
      </div>
    </section>

    <CaseStudyProblem
      id="approach"
      eyebrow="04"
      title="Approach"
      rows={[
        { title: "Build on the brand", body: "Corporate with WOW branding, we have an elaborated brand guideline and my job is to build on top with all sort of marketing materials, like social media post, website, and presentation etc." },
        { title: "Optimize existing website", body: "There was an existing WordPress website when I took over and I found some places that would be optimized to avoid confusion." },
        { title: "Design for more", body: "Apart from the existing web architecture, I integrated a blog section, a career page, and an online rental system to scale the business." },
      ]}
    />

    <CaseStudyKeepReading current="ant" />

  </main>
</BaseLayout>

<style>
  .main {
    --case-accent: var(--accent-ant);
    padding-top:   96px;
    min-height:    100vh;
  }

  /* ── 02 Visual Identity ──────────────────── */
  .case-identity-grid {
    display:               grid;
    grid-template-columns: repeat(3, 1fr);
    gap:                   clamp(12px, 1.7vw, 24px);
  }

  .case-identity-grid img {
    display: block;
    width:   100%;
    height:  auto;
  }

  .case-identity-gallery {
    display:               grid;
    grid-template-columns: repeat(4, 1fr);
    gap:                   clamp(12px, 1.7vw, 24px);
    margin-top:            clamp(20px, 2.8vw, 40px);
  }

  .case-identity-gallery img {
    display:       block;
    width:         100%;
    height:        auto;
    border-radius: var(--r-lg);
  }

  @media (max-width: 1024px) {
    .case-identity-gallery {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .main { padding-top: 80px; }

    .case-identity-grid {
      grid-template-columns: 1fr;
      gap:                   var(--space-sm);
    }

    .case-identity-gallery {
      grid-template-columns: repeat(2, 1fr);
      gap:                   var(--space-sm);
    }
  }

  @media (max-width: 520px) {
    .main { padding-top: 72px; }
  }
</style>
