---
interface Props {
  debugPanel?: boolean;
  theme?:      'dark' | 'light';
}

const { debugPanel = true, theme = 'light' } = Astro.props;
---

<div class="hero-fluid-bg" data-hero-fluid data-fluid-theme={theme}>
  <canvas class="hero-fluid-canvas" data-fluid-canvas aria-hidden="true"></canvas>

  <div class="hero-fluid-fallback" data-fluid-fallback>
    This device doesn&rsquo;t support WebGL, so the fluid effect can&rsquo;t render.
  </div>

  {debugPanel && (
    <Fragment>
      <button
        class="hero-fluid-toggle"
        data-fluid-toggle
        type="button"
        aria-label="Toggle control panel"
        aria-expanded="false"
        aria-controls="hero-fluid-panel"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="2.4"></circle>
          <path d="M19.4 13a7.5 7.5 0 0 0 0-2l1.5-1.2-1.5-2.6-1.8.6a7.5 7.5 0 0 0-1.7-1l-.3-1.9h-3l-.3 1.9a7.5 7.5 0 0 0-1.7 1l-1.8-.6-1.5 2.6L6.6 11a7.5 7.5 0 0 0 0 2l-1.5 1.2 1.5 2.6 1.8-.6a7.5 7.5 0 0 0 1.7 1l.3 1.9h3l.3-1.9a7.5 7.5 0 0 0 1.7-1l1.8.6 1.5-2.6z"></path>
        </svg>
      </button>

      <aside class="hero-fluid-panel" id="hero-fluid-panel" data-fluid-panel role="dialog" aria-label="Fluid controls">
        <h2 class="hero-fluid-panel-title">Atmosphere</h2>

        <div class="hero-fluid-row">
          <label for="hero-fluid-glow">Glow <span data-fluid-value="glow"></span></label>
          <input id="hero-fluid-glow" data-fluid-slider="GLOW" type="range" min="0.4" max="2.2" step="0.01" />
        </div>
        <div class="hero-fluid-row">
          <label for="hero-fluid-rise">Rise <span data-fluid-value="rise"></span></label>
          <input id="hero-fluid-rise" data-fluid-slider="BUOYANCY" type="range" min="0" max="60" step="0.5" />
        </div>
        <div class="hero-fluid-row">
          <label for="hero-fluid-swirl">Swirl <span data-fluid-value="swirl"></span></label>
          <input id="hero-fluid-swirl" data-fluid-slider="CURL" type="range" min="0" max="50" step="0.5" />
        </div>
        <div class="hero-fluid-row">
          <label for="hero-fluid-linger">Linger <span data-fluid-value="linger"></span></label>
          <input id="hero-fluid-linger" data-fluid-slider="DENSITY_DISSIPATION" type="range" min="0.05" max="1.4" step="0.01" />
        </div>

        <button class="hero-fluid-clear" data-fluid-clear type="button">Clear canvas</button>
      </aside>
    </Fragment>
  )}
</div>

<style>
  /* display:contents keeps this wrapper out of the stacking-context game —
     the canvas, toggle, and panel below position themselves directly
     against `.hero-section` (the nearest positioned ancestor), so their
     z-indexes compare cleanly against `.hero-section > .padding-global`
     (z-index: 1) instead of being trapped inside a child stacking context. */
  .hero-fluid-bg {
    display: contents;
  }

  .hero-fluid-canvas {
    position:    absolute;
    inset:       0;
    width:       100%;
    height:      100%;
    display:     block;
    touch-action: none;
  }

  .hero-fluid-fallback {
    position:       absolute;
    inset:          0;
    display:        none;
    place-items:    center;
    color:          var(--text-2);
    font-family:    var(--font-body);
    font-size:      13px;
    letter-spacing: 0.04em;
    text-align:     center;
    padding:        var(--space-md);
    background:     var(--bg);
  }

  .hero-fluid-fallback[data-visible] {
    display: grid;
  }

  /* ── Toggle ─────────────────────────────── */
  .hero-fluid-toggle {
    position:                 absolute;
    z-index:                  2;
    right:                    max(18px, env(safe-area-inset-right));
    bottom:                   max(18px, env(safe-area-inset-bottom));
    width:                    42px;
    height:                   42px;
    border-radius:            50%;
    display:                  grid;
    place-items:              center;
    background:               color-mix(in srgb, var(--surface) 72%, transparent);
    border:                   1px solid var(--border);
    backdrop-filter:          blur(14px);
    -webkit-backdrop-filter:  blur(14px);
    color:                    var(--text-2);
    cursor:                   pointer;
    opacity:                  0.28;
    transition:               opacity 0.4s var(--ease), color 0.4s var(--ease), transform 0.4s var(--ease);
  }

  .hero-fluid-toggle:hover,
  .hero-fluid-toggle:focus-visible {
    opacity: 1;
    color:   var(--text-1);
  }

  .hero-fluid-toggle svg {
    width:   18px;
    height:  18px;
    display: block;
  }

  /* ── Panel ──────────────────────────────── */
  .hero-fluid-panel {
    position:                 absolute;
    z-index:                  2;
    right:                    max(18px, env(safe-area-inset-right));
    bottom:                   calc(max(18px, env(safe-area-inset-bottom)) + 54px);
    width:                    min(86vw, 288px);
    max-height:               calc(100% - 140px);
    overflow-y:               auto;
    overscroll-behavior:      contain;
    background:               color-mix(in srgb, var(--surface) 72%, transparent);
    border:                   1px solid var(--border);
    border-radius:            var(--r-lg);
    backdrop-filter:          blur(20px);
    -webkit-backdrop-filter:  blur(20px);
    padding:                  18px 18px 14px;
    box-shadow:               var(--neon-sm);
    transform:                translateY(10px) scale(0.98);
    opacity:                  0;
    pointer-events:           none;
    transition:               opacity 0.35s var(--ease), transform 0.45s var(--ease);
  }

  .hero-fluid-panel.is-open {
    transform:      none;
    opacity:        1;
    pointer-events: auto;
  }

  .hero-fluid-panel-title {
    font-family:    var(--font-body);
    font-size:      10px;
    font-weight:    500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color:          var(--text-2);
    margin-bottom:  16px;
  }

  .hero-fluid-row {
    margin-bottom: 15px;
  }

  .hero-fluid-row label {
    display:         flex;
    justify-content: space-between;
    align-items:     baseline;
    font-family:     var(--font-body);
    font-size:       12px;
    color:           var(--text-1);
    margin-bottom:   8px;
  }

  .hero-fluid-row label span {
    font-size:              11px;
    color:                  var(--text-2);
    font-variant-numeric:   tabular-nums;
  }

  .hero-fluid-row input[type='range'] {
    -webkit-appearance: none;
    appearance:          none;
    width:                100%;
    height:               2px;
    background:           var(--border);
    border-radius:        2px;
    outline:              none;
    cursor:               pointer;
  }

  /* Sitewide :focus-visible convention (global.css:56) doesn't apply here
     since outline is intentionally removed above for the custom track/thumb
     styling — restore an equivalent visible indicator: outline on the input
     itself plus a stronger glow on the thumb (WCAG 2.4.7, QA 2026-07-17
     Finding 2). */
  .hero-fluid-row input[type='range']:focus-visible {
    outline:        2px solid var(--accent);
    outline-offset: 3px;
    border-radius:  var(--r-sm);
  }

  .hero-fluid-row input[type='range']:focus-visible::-webkit-slider-thumb {
    box-shadow: var(--neon-md);
    transform:  scale(1.15);
  }

  .hero-fluid-row input[type='range']:focus-visible::-moz-range-thumb {
    box-shadow: var(--neon-md);
  }

  .hero-fluid-row input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance:          none;
    width:                13px;
    height:               13px;
    border-radius:        50%;
    background:           var(--surface);
    border:               1px solid var(--accent);
    box-shadow:           var(--neon-sm);
    transition:           transform 0.2s var(--ease);
  }

  .hero-fluid-row input[type='range']::-webkit-slider-thumb:hover {
    transform: scale(1.15);
  }

  .hero-fluid-row input[type='range']::-moz-range-thumb {
    width:         13px;
    height:        13px;
    border-radius: 50%;
    background:    var(--surface);
    border:        1px solid var(--accent);
    box-shadow:    var(--neon-sm);
  }

  .hero-fluid-row input[type='range']::-moz-range-track {
    height:        2px;
    background:    var(--border);
    border-radius: 2px;
  }

  .hero-fluid-clear {
    width:          100%;
    margin-top:     4px;
    padding:        9px;
    font-family:    var(--font-body);
    font-size:      12px;
    letter-spacing: 0.04em;
    color:          var(--text-2);
    background:     transparent;
    border:         1px solid var(--border);
    border-radius:  var(--r-md);
    cursor:         pointer;
    transition:     color 0.3s var(--ease), border-color 0.3s var(--ease);
  }

  .hero-fluid-clear:hover,
  .hero-fluid-clear:focus-visible {
    color:        var(--text-1);
    border-color: var(--text-2);
  }
</style>

<script>
  // Adapted from a standalone WebGL fluid-simulation prototype. No page in
  // this codebase toggles theme at runtime, so unlike the original prototype
  // there's no live MutationObserver/theme-mix — each instance just picks
  // its static light/dark display shader once at init (see displayShader
  // below), based on the theme prop passed in from the Astro component.

  interface FluidConfig {
    SIM_RESOLUTION:       number;
    DYE_RESOLUTION:       number;
    DENSITY_DISSIPATION:  number;
    VELOCITY_DISSIPATION: number;
    PRESSURE:             number;
    PRESSURE_ITERATIONS:  number;
    CURL:                 number;
    SPLAT_RADIUS:         number;
    SPLAT_FORCE:          number;
    BUOYANCY:             number;
    AMBIENT:              number;
    GLOW:                 number;
    EXPOSURE:             number;
    VIGNETTE:             number;
  }

  type GL = WebGLRenderingContext | WebGL2RenderingContext;

  interface TextureFormat {
    internalFormat: number;
    format:         number;
  }

  interface FluidExt {
    formatRGBA:             TextureFormat | null;
    formatRG:               TextureFormat | null;
    formatR:                TextureFormat | null;
    halfFloatTexType:       number;
    supportLinearFiltering: boolean;
  }

  interface FBO {
    texture:     WebGLTexture | null;
    fbo:         WebGLFramebuffer | null;
    width:       number;
    height:      number;
    texelSizeX:  number;
    texelSizeY:  number;
    attach(id: number): number;
  }

  interface DoubleFBO {
    width:      number;
    height:     number;
    texelSizeX: number;
    texelSizeY: number;
    read:       FBO;
    write:      FBO;
    swap():     void;
  }

  function showStaticFallback(root: HTMLElement): void {
    const canvas   = root.querySelector<HTMLCanvasElement>('[data-fluid-canvas]');
    const fallback = root.querySelector<HTMLElement>('[data-fluid-fallback]');
    const toggle   = root.querySelector<HTMLElement>('[data-fluid-toggle]');
    const panel    = root.querySelector<HTMLElement>('[data-fluid-panel]');

    if (canvas) canvas.style.display = 'none';
    if (toggle) toggle.style.display = 'none';
    if (panel) panel.style.display = 'none';
    if (fallback) fallback.setAttribute('data-visible', '');
  }

  document.querySelectorAll<HTMLElement>('[data-hero-fluid]').forEach((root) => {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Full bailout: never create a GL context or start the RAF loop.
    if (prefersReduced) {
      const canvas = root.querySelector<HTMLCanvasElement>('[data-fluid-canvas]');
      const toggle = root.querySelector<HTMLElement>('[data-fluid-toggle]');
      const panel  = root.querySelector<HTMLElement>('[data-fluid-panel]');
      if (canvas) canvas.style.display = 'none';
      if (toggle) toggle.style.display = 'none';
      if (panel) panel.style.display = 'none';
      return;
    }

    const canvas = root.querySelector<HTMLCanvasElement>('[data-fluid-canvas]');
    if (!canvas) return;

    const isMobile = window.matchMedia('(pointer: coarse)').matches
      || Math.min(window.innerWidth, window.innerHeight) < 600;

    const config: FluidConfig = {
      SIM_RESOLUTION:       isMobile ? 140 : 192,
      DYE_RESOLUTION:       isMobile ? 640 : 1024,
      DENSITY_DISSIPATION:  0.55,
      VELOCITY_DISSIPATION: 0.9,
      PRESSURE:             0.8,
      PRESSURE_ITERATIONS:  22,
      CURL:                 26,
      SPLAT_RADIUS:         0.26,
      SPLAT_FORCE:          6000,
      BUOYANCY:             12,
      AMBIENT:              0.6,
      GLOW:                 1.0,
      EXPOSURE:             1.3,
      VIGNETTE:             0.6,
    };

    function getWebGLContext(canvasEl: HTMLCanvasElement): { gl: GL | null; ext: FluidExt | null } {
      const params: WebGLContextAttributes = {
        alpha: true, depth: false, stencil: false, antialias: false,
        preserveDrawingBuffer: false, powerPreference: 'high-performance',
      };
      let gl: GL | null = canvasEl.getContext('webgl2', params) as WebGL2RenderingContext | null;
      const isWebGL2 = !!gl;
      if (!isWebGL2) {
        gl = (canvasEl.getContext('webgl', params) || canvasEl.getContext('experimental-webgl', params)) as WebGLRenderingContext | null;
      }
      if (!gl) return { gl: null, ext: null };

      let halfFloat: any;
      let supportLinearFiltering: any;
      if (isWebGL2) {
        gl.getExtension('EXT_color_buffer_float');
        supportLinearFiltering = gl.getExtension('OES_texture_float_linear');
      } else {
        halfFloat = gl.getExtension('OES_texture_half_float');
        supportLinearFiltering = gl.getExtension('OES_texture_half_float_linear');
      }
      gl.clearColor(0, 0, 0, 1);
      const halfFloatTexType = isWebGL2
        ? (gl as WebGL2RenderingContext).HALF_FLOAT
        : (halfFloat ? halfFloat.HALF_FLOAT_OES : gl.UNSIGNED_BYTE);

      let formatRGBA: TextureFormat | null;
      let formatRG:   TextureFormat | null;
      let formatR:    TextureFormat | null;
      if (isWebGL2) {
        const gl2 = gl as WebGL2RenderingContext;
        formatRGBA = getSupportedFormat(gl2, gl2.RGBA16F, gl2.RGBA, halfFloatTexType);
        formatRG   = getSupportedFormat(gl2, gl2.RG16F,   gl2.RG,   halfFloatTexType);
        formatR    = getSupportedFormat(gl2, gl2.R16F,    gl2.RED,  halfFloatTexType);
      } else {
        formatRGBA = getSupportedFormat(gl, gl.RGBA, gl.RGBA, halfFloatTexType);
        formatRG   = formatRGBA;
        formatR    = formatRGBA;
      }
      return { gl, ext: { formatRGBA, formatRG, formatR, halfFloatTexType, supportLinearFiltering: !!supportLinearFiltering } };
    }

    function getSupportedFormat(gl: GL, internalFormat: number, format: number, type: number): TextureFormat | null {
      if (!supportRenderTextureFormat(gl, internalFormat, format, type)) {
        const gl2 = gl as WebGL2RenderingContext;
        switch (internalFormat) {
          case gl2.R16F:  return getSupportedFormat(gl, gl2.RG16F, gl2.RG, type);
          case gl2.RG16F: return getSupportedFormat(gl, gl2.RGBA16F, gl2.RGBA, type);
          default: return null;
        }
      }
      return { internalFormat, format };
    }

    function supportRenderTextureFormat(gl: GL, internalFormat: number, format: number, type: number): boolean {
      const tex = gl.createTexture();
      gl.bindTexture(gl.TEXTURE_2D, tex);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.NEAREST);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.NEAREST);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
      gl.texImage2D(gl.TEXTURE_2D, 0, internalFormat, 4, 4, 0, format, type, null);
      const fbo = gl.createFramebuffer();
      gl.bindFramebuffer(gl.FRAMEBUFFER, fbo);
      gl.framebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.TEXTURE_2D, tex, 0);
      return gl.checkFramebufferStatus(gl.FRAMEBUFFER) === gl.FRAMEBUFFER_COMPLETE;
    }

    const { gl, ext } = getWebGLContext(canvas);
    if (!gl || !ext) {
      showStaticFallback(root);
      return;
    }

    function compileShader(type: number, source: string): WebGLShader {
      const s = gl!.createShader(type)!;
      gl!.shaderSource(s, source);
      gl!.compileShader(s);
      if (!gl!.getShaderParameter(s, gl!.COMPILE_STATUS)) console.error(gl!.getShaderInfoLog(s));
      return s;
    }
    function createProgram(vs: WebGLShader, fs: WebGLShader): WebGLProgram {
      const p = gl!.createProgram()!;
      gl!.attachShader(p, vs);
      gl!.attachShader(p, fs);
      gl!.bindAttribLocation(p, 0, 'aPosition');
      gl!.linkProgram(p);
      if (!gl!.getProgramParameter(p, gl!.LINK_STATUS)) console.error(gl!.getProgramInfoLog(p));
      return p;
    }
    class Program {
      program: WebGLProgram;
      uniforms: Record<string, WebGLUniformLocation | null>;
      constructor(vsSource: string, fsSource: string) {
        this.program = createProgram(compileShader(gl!.VERTEX_SHADER, vsSource), compileShader(gl!.FRAGMENT_SHADER, fsSource));
        this.uniforms = {};
        const n = gl!.getProgramParameter(this.program, gl!.ACTIVE_UNIFORMS);
        for (let i = 0; i < n; i++) {
          const info = gl!.getActiveUniform(this.program, i)!;
          this.uniforms[info.name] = gl!.getUniformLocation(this.program, info.name);
        }
      }
      bind(): void { gl!.useProgram(this.program); }
    }

    const baseVertex = `
      precision highp float;
      attribute vec2 aPosition;
      varying vec2 vUv; varying vec2 vL; varying vec2 vR; varying vec2 vT; varying vec2 vB;
      uniform vec2 texelSize;
      void main(){
        vUv = aPosition * 0.5 + 0.5;
        vL = vUv - vec2(texelSize.x, 0.0);
        vR = vUv + vec2(texelSize.x, 0.0);
        vT = vUv + vec2(0.0, texelSize.y);
        vB = vUv - vec2(0.0, texelSize.y);
        gl_Position = vec4(aPosition, 0.0, 1.0);
      }`;

    const copyShader = `
      precision mediump float; varying vec2 vUv; uniform sampler2D uTexture;
      void main(){ gl_FragColor = texture2D(uTexture, vUv); }`;

    const clearShader = `
      precision mediump float; varying vec2 vUv; uniform sampler2D uTexture; uniform float value;
      void main(){ gl_FragColor = value * texture2D(uTexture, vUv); }`;

    const splatShader = `
      precision highp float; varying vec2 vUv;
      uniform sampler2D uTarget; uniform float aspectRatio; uniform vec3 color; uniform vec2 point; uniform float radius;
      void main(){
        vec2 p = vUv - point.xy; p.x *= aspectRatio;
        vec3 splat = exp(-dot(p,p)/radius) * color;
        vec3 base = texture2D(uTarget, vUv).xyz;
        gl_FragColor = vec4(base + splat, 1.0);
      }`;

    const advectionShader = `
      precision highp float; varying vec2 vUv;
      uniform sampler2D uVelocity; uniform sampler2D uSource;
      uniform vec2 texelSize; uniform vec2 dyeTexelSize; uniform float dt; uniform float dissipation;
      vec4 bilerp(sampler2D sam, vec2 uv, vec2 tsize){
        vec2 st = uv / tsize - 0.5;
        vec2 iuv = floor(st); vec2 fuv = fract(st);
        vec4 a = texture2D(sam, (iuv + vec2(0.5,0.5)) * tsize);
        vec4 b = texture2D(sam, (iuv + vec2(1.5,0.5)) * tsize);
        vec4 c = texture2D(sam, (iuv + vec2(0.5,1.5)) * tsize);
        vec4 d = texture2D(sam, (iuv + vec2(1.5,1.5)) * tsize);
        return mix(mix(a,b,fuv.x), mix(c,d,fuv.x), fuv.y);
      }
      void main(){
      #ifdef MANUAL_FILTERING
        vec2 coord = vUv - dt * bilerp(uVelocity, vUv, texelSize).xy * texelSize;
        vec4 result = bilerp(uSource, coord, dyeTexelSize);
      #else
        vec2 coord = vUv - dt * texture2D(uVelocity, vUv).xy * texelSize;
        vec4 result = texture2D(uSource, coord);
      #endif
        float decay = 1.0 + dissipation * dt;
        gl_FragColor = result / decay;
      }`;

    const divergenceShader = `
      precision mediump float; varying vec2 vUv; varying vec2 vL; varying vec2 vR; varying vec2 vT; varying vec2 vB;
      uniform sampler2D uVelocity;
      void main(){
        float L = texture2D(uVelocity, vL).x;
        float R = texture2D(uVelocity, vR).x;
        float T = texture2D(uVelocity, vT).y;
        float B = texture2D(uVelocity, vB).y;
        vec2 C = texture2D(uVelocity, vUv).xy;
        if (vL.x < 0.0) L = -C.x;
        if (vR.x > 1.0) R = -C.x;
        if (vT.y > 1.0) T = -C.y;
        if (vB.y < 0.0) B = -C.y;
        gl_FragColor = vec4(0.5*(R-L+T-B), 0.0, 0.0, 1.0);
      }`;

    const curlShader = `
      precision mediump float; varying vec2 vL; varying vec2 vR; varying vec2 vT; varying vec2 vB;
      uniform sampler2D uVelocity;
      void main(){
        float L = texture2D(uVelocity, vL).y;
        float R = texture2D(uVelocity, vR).y;
        float T = texture2D(uVelocity, vT).x;
        float B = texture2D(uVelocity, vB).x;
        gl_FragColor = vec4(0.5*(R-L-T+B), 0.0, 0.0, 1.0);
      }`;

    const vorticityShader = `
      precision highp float; varying vec2 vUv; varying vec2 vL; varying vec2 vR; varying vec2 vT; varying vec2 vB;
      uniform sampler2D uVelocity; uniform sampler2D uCurl; uniform float curl; uniform float dt;
      void main(){
        float L = texture2D(uCurl, vL).x;
        float R = texture2D(uCurl, vR).x;
        float T = texture2D(uCurl, vT).x;
        float B = texture2D(uCurl, vB).x;
        float C = texture2D(uCurl, vUv).x;
        vec2 force = 0.5 * vec2(abs(T)-abs(B), abs(R)-abs(L));
        force /= length(force) + 0.0001;
        force *= curl * C;
        force.y *= -1.0;
        vec2 vel = texture2D(uVelocity, vUv).xy;
        vel += force * dt;
        vel = clamp(vel, -1000.0, 1000.0);
        gl_FragColor = vec4(vel, 0.0, 1.0);
      }`;

    const pressureShader = `
      precision mediump float; varying vec2 vUv; varying vec2 vL; varying vec2 vR; varying vec2 vT; varying vec2 vB;
      uniform sampler2D uPressure; uniform sampler2D uDivergence;
      void main(){
        float L = texture2D(uPressure, vL).x;
        float R = texture2D(uPressure, vR).x;
        float T = texture2D(uPressure, vT).x;
        float B = texture2D(uPressure, vB).x;
        float div = texture2D(uDivergence, vUv).x;
        gl_FragColor = vec4((L+R+B+T-div)*0.25, 0.0, 0.0, 1.0);
      }`;

    const gradientSubtractShader = `
      precision mediump float; varying vec2 vUv; varying vec2 vL; varying vec2 vR; varying vec2 vT; varying vec2 vB;
      uniform sampler2D uPressure; uniform sampler2D uVelocity;
      void main(){
        float L = texture2D(uPressure, vL).x;
        float R = texture2D(uPressure, vR).x;
        float T = texture2D(uPressure, vT).x;
        float B = texture2D(uPressure, vB).x;
        vec2 vel = texture2D(uVelocity, vUv).xy;
        vel -= vec2(R-L, T-B);
        gl_FragColor = vec4(vel, 0.0, 1.0);
      }`;

    const buoyancyShader = `
      precision highp float; varying vec2 vUv;
      uniform sampler2D uVelocity; uniform sampler2D uDye;
      uniform float dt; uniform float strength; uniform float ambient;
      void main(){
        vec2 vel = texture2D(uVelocity, vUv).xy;
        vec3 d = texture2D(uDye, vUv).rgb;
        float density = (d.r + d.g + d.b) / 3.0;
        vel.y += (density * strength + ambient) * dt;
        gl_FragColor = vec4(vel, 0.0, 1.0);
      }`;

    // Two static color branches — one per page theme, picked once at init
    // from data-fluid-theme below. No live MutationObserver/theme-mix here:
    // nothing in this codebase toggles theme at runtime, so each page just
    // gets the one branch it needs.
    const displayShaderLight = `
      precision highp float; varying vec2 vUv;
      uniform sampler2D uTexture; uniform float uGlow; uniform float uExposure;
      uniform float uVignette; uniform float uTime;
      void main(){
        vec3 dye = texture2D(uTexture, vUv).rgb;
        float density = max(max(dye.r, dye.g), dye.b);
        float t = 1.0 - exp(-density * uExposure);
        float d = distance(vUv, vec2(0.5));
        float vig = smoothstep(0.85, 0.32, d);

        vec3 stone = vec3(0.961, 0.953, 0.933);
        vec3 iLow  = vec3(0.55, 0.78, 0.69);
        vec3 iMid  = vec3(0.114, 0.620, 0.459);
        vec3 iHigh = vec3(0.043, 0.216, 0.169);
        vec3 ink = mix(iLow, iMid, smoothstep(0.0, 0.5, t));
        ink = mix(ink, iHigh, smoothstep(0.6, 1.0, t));
        vec3 col = mix(stone, ink, clamp(t * uGlow, 0.0, 1.0));
        // Vignette should only shape the ink itself, never darken the flat
        // resting "stone" base — gate its influence by density (t) so a
        // dye-free region (t = 0) renders as pure stone with zero falloff.
        col *= 1.0 - uVignette * 0.12 * (1.0 - vig) * t;

        float dn = fract(sin(dot(vUv + uTime, vec2(12.9898,78.233))) * 43758.5453);
        col += (dn - 0.5) / 255.0;
        gl_FragColor = vec4(col, 1.0);
      }`;

    const displayShaderDark = `
      precision highp float; varying vec2 vUv;
      uniform sampler2D uTexture; uniform float uGlow; uniform float uExposure;
      uniform float uVignette; uniform float uTime;
      void main(){
        vec3 dye = texture2D(uTexture, vUv).rgb;
        float density = max(max(dye.r, dye.g), dye.b);
        float t = 1.0 - exp(-density * uExposure);
        float d = distance(vUv, vec2(0.5));
        float vig = smoothstep(0.85, 0.32, d);

        vec3 cLow  = vec3(0.62, 0.22, 0.04);
        vec3 cMid  = vec3(0.937, 0.624, 0.153);      // #EF9F27
        vec3 cHigh = vec3(1.0, 0.95, 0.82);
        vec3 grad = mix(cLow, cMid, smoothstep(0.0, 0.45, t));
        grad = mix(grad, cHigh, smoothstep(0.55, 1.0, t));
        vec3 col = vec3(0.012, 0.017, 0.030) + grad * t * uGlow;
        col *= mix(1.0 - uVignette, 1.0, vig);

        float dn = fract(sin(dot(vUv + uTime, vec2(12.9898,78.233))) * 43758.5453);
        col += (dn - 0.5) / 255.0;
        gl_FragColor = vec4(col, 1.0);
      }`;

    const displayShader = root.dataset.fluidTheme === 'dark' ? displayShaderDark : displayShaderLight;

    const blit = (() => {
      gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, -1, 1, 1, 1, 1, -1]), gl.STATIC_DRAW);
      gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, gl.createBuffer());
      gl.bufferData(gl.ELEMENT_ARRAY_BUFFER, new Uint16Array([0, 1, 2, 0, 2, 3]), gl.STATIC_DRAW);
      gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);
      gl.enableVertexAttribArray(0);
      return (target: FBO | null, clear = false) => {
        if (target == null) {
          gl.viewport(0, 0, gl.drawingBufferWidth, gl.drawingBufferHeight);
          gl.bindFramebuffer(gl.FRAMEBUFFER, null);
        } else {
          gl.viewport(0, 0, target.width, target.height);
          gl.bindFramebuffer(gl.FRAMEBUFFER, target.fbo);
        }
        if (clear) { gl.clearColor(0, 0, 0, 1); gl.clear(gl.COLOR_BUFFER_BIT); }
        gl.drawElements(gl.TRIANGLES, 6, gl.UNSIGNED_SHORT, 0);
      };
    })();

    function createFBO(w: number, h: number, internalFormat: number, format: number, type: number, param: number): FBO {
      gl!.activeTexture(gl!.TEXTURE0);
      const texture = gl!.createTexture();
      gl!.bindTexture(gl!.TEXTURE_2D, texture);
      gl!.texParameteri(gl!.TEXTURE_2D, gl!.TEXTURE_MIN_FILTER, param);
      gl!.texParameteri(gl!.TEXTURE_2D, gl!.TEXTURE_MAG_FILTER, param);
      gl!.texParameteri(gl!.TEXTURE_2D, gl!.TEXTURE_WRAP_S, gl!.CLAMP_TO_EDGE);
      gl!.texParameteri(gl!.TEXTURE_2D, gl!.TEXTURE_WRAP_T, gl!.CLAMP_TO_EDGE);
      gl!.texImage2D(gl!.TEXTURE_2D, 0, internalFormat, w, h, 0, format, type, null);
      const fbo = gl!.createFramebuffer();
      gl!.bindFramebuffer(gl!.FRAMEBUFFER, fbo);
      gl!.framebufferTexture2D(gl!.FRAMEBUFFER, gl!.COLOR_ATTACHMENT0, gl!.TEXTURE_2D, texture, 0);
      gl!.viewport(0, 0, w, h); gl!.clear(gl!.COLOR_BUFFER_BIT);
      return {
        texture, fbo, width: w, height: h, texelSizeX: 1 / w, texelSizeY: 1 / h,
        attach(id: number) { gl!.activeTexture(gl!.TEXTURE0 + id); gl!.bindTexture(gl!.TEXTURE_2D, texture); return id; },
      };
    }
    function createDoubleFBO(w: number, h: number, if_: number, f: number, t: number, p: number): DoubleFBO {
      let fbo1 = createFBO(w, h, if_, f, t, p);
      let fbo2 = createFBO(w, h, if_, f, t, p);
      return {
        width: w, height: h, texelSizeX: 1 / w, texelSizeY: 1 / h,
        get read() { return fbo1; }, set read(v: FBO) { fbo1 = v; },
        get write() { return fbo2; }, set write(v: FBO) { fbo2 = v; },
        swap() { const t2 = fbo1; fbo1 = fbo2; fbo2 = t2; },
      };
    }
    function resizeFBO(target: FBO, w: number, h: number, if_: number, f: number, t: number, p: number): FBO {
      const newFBO = createFBO(w, h, if_, f, t, p);
      copyProgram.bind();
      gl!.uniform1i(copyProgram.uniforms.uTexture, target.attach(0));
      blit(newFBO);
      return newFBO;
    }
    function resizeDoubleFBO(target: DoubleFBO, w: number, h: number, if_: number, f: number, t: number, p: number): DoubleFBO {
      if (target.width === w && target.height === h) return target;
      target.read = resizeFBO(target.read, w, h, if_, f, t, p);
      target.write = createFBO(w, h, if_, f, t, p);
      target.width = w; target.height = h; target.texelSizeX = 1 / w; target.texelSizeY = 1 / h;
      return target;
    }

    function getResolution(resolution: number): { width: number; height: number } {
      let aspect = gl!.drawingBufferWidth / gl!.drawingBufferHeight;
      if (aspect < 1) aspect = 1 / aspect;
      const min = Math.round(resolution);
      const max = Math.round(resolution * aspect);
      if (gl!.drawingBufferWidth > gl!.drawingBufferHeight) return { width: max, height: min };
      return { width: min, height: max };
    }

    const copyProgram        = new Program(baseVertex, copyShader);
    const clearProgram       = new Program(baseVertex, clearShader);
    const splatProgram       = new Program(baseVertex, splatShader);
    const advectionProgram   = new Program(baseVertex, ext.supportLinearFiltering ? advectionShader : '#define MANUAL_FILTERING\n' + advectionShader);
    const divergenceProgram  = new Program(baseVertex, divergenceShader);
    const curlProgram        = new Program(baseVertex, curlShader);
    const vorticityProgram   = new Program(baseVertex, vorticityShader);
    const pressureProgram    = new Program(baseVertex, pressureShader);
    const gradientSubProgram = new Program(baseVertex, gradientSubtractShader);
    const buoyancyProgram    = new Program(baseVertex, buoyancyShader);
    const displayProgram     = new Program(baseVertex, displayShader);

    let dye: DoubleFBO, velocity: DoubleFBO, divergence: FBO, curl: FBO, pressure: DoubleFBO;
    function initFramebuffers(): void {
      const simRes = getResolution(config.SIM_RESOLUTION);
      const dyeRes = getResolution(config.DYE_RESOLUTION);
      const texType = ext!.halfFloatTexType;
      const rgba = ext!.formatRGBA!, rg = ext!.formatRG!, r = ext!.formatR!;
      const filtering = ext!.supportLinearFiltering ? gl!.LINEAR : gl!.NEAREST;
      gl!.disable(gl!.BLEND);

      dye = dye
        ? resizeDoubleFBO(dye, dyeRes.width, dyeRes.height, rgba.internalFormat, rgba.format, texType, filtering)
        : createDoubleFBO(dyeRes.width, dyeRes.height, rgba.internalFormat, rgba.format, texType, filtering);
      velocity = velocity
        ? resizeDoubleFBO(velocity, simRes.width, simRes.height, rg.internalFormat, rg.format, texType, filtering)
        : createDoubleFBO(simRes.width, simRes.height, rg.internalFormat, rg.format, texType, filtering);
      divergence = createFBO(simRes.width, simRes.height, r.internalFormat, r.format, texType, gl!.NEAREST);
      curl       = createFBO(simRes.width, simRes.height, r.internalFormat, r.format, texType, gl!.NEAREST);
      pressure   = createDoubleFBO(simRes.width, simRes.height, r.internalFormat, r.format, texType, gl!.NEAREST);
    }

    function resizeCanvas(): boolean {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = Math.floor(canvas!.clientWidth * dpr);
      const h = Math.floor(canvas!.clientHeight * dpr);
      if (canvas!.width !== w || canvas!.height !== h) { canvas!.width = w; canvas!.height = h; return true; }
      return false;
    }
    resizeCanvas();
    initFramebuffers();

    function step(dt: number): void {
      gl!.disable(gl!.BLEND);

      curlProgram.bind();
      gl!.uniform2f(curlProgram.uniforms.texelSize, velocity.texelSizeX, velocity.texelSizeY);
      gl!.uniform1i(curlProgram.uniforms.uVelocity, velocity.read.attach(0));
      blit(curl);

      vorticityProgram.bind();
      gl!.uniform2f(vorticityProgram.uniforms.texelSize, velocity.texelSizeX, velocity.texelSizeY);
      gl!.uniform1i(vorticityProgram.uniforms.uVelocity, velocity.read.attach(0));
      gl!.uniform1i(vorticityProgram.uniforms.uCurl, curl.attach(1));
      gl!.uniform1f(vorticityProgram.uniforms.curl, config.CURL);
      gl!.uniform1f(vorticityProgram.uniforms.dt, dt);
      blit(velocity.write); velocity.swap();

      buoyancyProgram.bind();
      gl!.uniform1i(buoyancyProgram.uniforms.uVelocity, velocity.read.attach(0));
      gl!.uniform1i(buoyancyProgram.uniforms.uDye, dye.read.attach(1));
      gl!.uniform1f(buoyancyProgram.uniforms.dt, dt);
      gl!.uniform1f(buoyancyProgram.uniforms.strength, config.BUOYANCY);
      gl!.uniform1f(buoyancyProgram.uniforms.ambient, config.AMBIENT);
      blit(velocity.write); velocity.swap();

      divergenceProgram.bind();
      gl!.uniform2f(divergenceProgram.uniforms.texelSize, velocity.texelSizeX, velocity.texelSizeY);
      gl!.uniform1i(divergenceProgram.uniforms.uVelocity, velocity.read.attach(0));
      blit(divergence);

      clearProgram.bind();
      gl!.uniform1i(clearProgram.uniforms.uTexture, pressure.read.attach(0));
      gl!.uniform1f(clearProgram.uniforms.value, config.PRESSURE);
      blit(pressure.write); pressure.swap();

      pressureProgram.bind();
      gl!.uniform2f(pressureProgram.uniforms.texelSize, velocity.texelSizeX, velocity.texelSizeY);
      gl!.uniform1i(pressureProgram.uniforms.uDivergence, divergence.attach(0));
      for (let i = 0; i < config.PRESSURE_ITERATIONS; i++) {
        gl!.uniform1i(pressureProgram.uniforms.uPressure, pressure.read.attach(1));
        blit(pressure.write); pressure.swap();
      }

      gradientSubProgram.bind();
      gl!.uniform2f(gradientSubProgram.uniforms.texelSize, velocity.texelSizeX, velocity.texelSizeY);
      gl!.uniform1i(gradientSubProgram.uniforms.uPressure, pressure.read.attach(0));
      gl!.uniform1i(gradientSubProgram.uniforms.uVelocity, velocity.read.attach(1));
      blit(velocity.write); velocity.swap();

      advectionProgram.bind();
      gl!.uniform2f(advectionProgram.uniforms.texelSize, velocity.texelSizeX, velocity.texelSizeY);
      if (!ext!.supportLinearFiltering) gl!.uniform2f(advectionProgram.uniforms.dyeTexelSize, velocity.texelSizeX, velocity.texelSizeY);
      gl!.uniform1i(advectionProgram.uniforms.uVelocity, velocity.read.attach(0));
      gl!.uniform1i(advectionProgram.uniforms.uSource, velocity.read.attach(0));
      gl!.uniform1f(advectionProgram.uniforms.dt, dt);
      gl!.uniform1f(advectionProgram.uniforms.dissipation, config.VELOCITY_DISSIPATION);
      blit(velocity.write); velocity.swap();

      advectionProgram.bind();
      if (!ext!.supportLinearFiltering) gl!.uniform2f(advectionProgram.uniforms.dyeTexelSize, dye.texelSizeX, dye.texelSizeY);
      gl!.uniform2f(advectionProgram.uniforms.texelSize, velocity.texelSizeX, velocity.texelSizeY);
      gl!.uniform1i(advectionProgram.uniforms.uVelocity, velocity.read.attach(0));
      gl!.uniform1i(advectionProgram.uniforms.uSource, dye.read.attach(1));
      gl!.uniform1f(advectionProgram.uniforms.dt, dt);
      gl!.uniform1f(advectionProgram.uniforms.dissipation, config.DENSITY_DISSIPATION);
      blit(dye.write); dye.swap();
    }

    function render(): void {
      displayProgram.bind();
      gl!.uniform1i(displayProgram.uniforms.uTexture, dye.read.attach(0));
      gl!.uniform1f(displayProgram.uniforms.uGlow, config.GLOW);
      gl!.uniform1f(displayProgram.uniforms.uExposure, config.EXPOSURE);
      gl!.uniform1f(displayProgram.uniforms.uVignette, config.VIGNETTE);
      gl!.uniform1f(displayProgram.uniforms.uTime, (performance.now() * 0.001) % 100.0);
      blit(null);
    }

    function correctRadius(r: number): number {
      const aspect = canvas!.width / canvas!.height;
      return aspect > 1 ? r * aspect : r;
    }
    function splatVelocity(x: number, y: number, dx: number, dy: number, radius: number): void {
      splatProgram.bind();
      gl!.uniform1i(splatProgram.uniforms.uTarget, velocity.read.attach(0));
      gl!.uniform1f(splatProgram.uniforms.aspectRatio, canvas!.width / canvas!.height);
      gl!.uniform2f(splatProgram.uniforms.point, x, y);
      gl!.uniform3f(splatProgram.uniforms.color, dx, dy, 0.0);
      gl!.uniform1f(splatProgram.uniforms.radius, correctRadius(radius / 100));
      blit(velocity.write); velocity.swap();
    }
    function splatDye(x: number, y: number, color: { r: number; g: number; b: number }, radius: number): void {
      splatProgram.bind();
      gl!.uniform1i(splatProgram.uniforms.uTarget, dye.read.attach(0));
      gl!.uniform1f(splatProgram.uniforms.aspectRatio, canvas!.width / canvas!.height);
      gl!.uniform2f(splatProgram.uniforms.point, x, y);
      gl!.uniform3f(splatProgram.uniforms.color, color.r, color.g, color.b);
      gl!.uniform1f(splatProgram.uniforms.radius, correctRadius(radius / 100));
      blit(dye.write); dye.swap();
    }

    function smokeColor(intensity: number, v = 0): { r: number; g: number; b: number } {
      const j = 0.85 + Math.random() * 0.3;
      return {
        r: 0.937 * intensity * j,
        g: (0.624 - v * 0.14) * intensity * j,
        b: (0.153 - v * 0.05) * intensity * j,
      };
    }

    const intro = {
      active:   true,
      t:        0,
      duration: 3.2,
      delay:    0.5,
      prevX:    null as number | null,
      prevY:    null as number | null,
    };

    function easeInOut(u: number): number { return u < 0.5 ? 2 * u * u : 1 - Math.pow(-2 * u + 2, 2) / 2; }

    const PHI = 1.618033988749895;
    function introPoint(u: number): { x: number; y: number } {
      const e = easeInOut(u);
      const sweep = 1.5 * Math.PI;
      const th0 = -1.25 * Math.PI;
      const th = th0 + sweep * e;
      const r = 0.075 * Math.pow(PHI, (sweep * e) / (Math.PI * 0.5));
      const minWH = Math.min(canvas!.width, canvas!.height);
      const cx = 0.5, cy = 0.52;
      return {
        x: cx + r * Math.cos(th) * (minWH / canvas!.width),
        y: cy + r * Math.sin(th) * (minWH / canvas!.height),
      };
    }

    function stepIntro(dt: number): void {
      if (!intro.active) return;
      intro.t += dt;
      const t = intro.t - intro.delay;
      if (t < 0) return;
      const u = Math.min(t / intro.duration, 1);
      const p = introPoint(u);
      if (intro.prevX !== null && intro.prevY !== null) {
        const dx = p.x - intro.prevX, dy = p.y - intro.prevY;
        if (dx * dx + dy * dy > 1e-9) {
          const fade = Math.sin(u * Math.PI);
          splatVelocity(p.x, p.y, dx * config.SPLAT_FORCE, dy * config.SPLAT_FORCE, config.SPLAT_RADIUS);
          splatDye(p.x, p.y, smokeColor(0.10 + 0.10 * fade, Math.random() * 0.4), config.SPLAT_RADIUS * 1.05);
        }
      }
      intro.prevX = p.x; intro.prevY = p.y;
      if (u >= 1) intro.active = false;
    }
    function cancelIntro(): void { intro.active = false; }

    interface QueuedSplat { x: number; y: number; dx: number; dy: number; dye: boolean; }
    const queue: QueuedSplat[] = [];
    let lastX = 0, lastY = 0, hasLast = false, isDown = false;

    function pointerPos(e: { clientX: number; clientY: number }): { x: number; y: number } {
      const rect = canvas!.getBoundingClientRect();
      return { x: (e.clientX - rect.left) / rect.width, y: 1 - (e.clientY - rect.top) / rect.height };
    }
    function onDown(e: { clientX: number; clientY: number }): void {
      cancelIntro();
      const p = pointerPos(e);
      lastX = p.x; lastY = p.y; hasLast = true; isDown = true;
    }
    function onMove(e: { clientX: number; clientY: number }): void {
      if (!heroVisible) return;
      const p = pointerPos(e);
      if (!hasLast) { lastX = p.x; lastY = p.y; hasLast = true; return; }
      const dx = p.x - lastX, dy = p.y - lastY;
      const dist2 = dx * dx + dy * dy;
      lastX = p.x; lastY = p.y;
      if (dist2 < 1e-7) return;
      const force = config.SPLAT_FORCE * (isDown ? 1.0 : 0.32);
      queue.push({ x: p.x, y: p.y, dx: dx * force, dy: dy * force, dye: isDown });
    }
    function onUp(): void { isDown = false; }

    canvas.addEventListener('mousedown', (e: MouseEvent) => onDown(e));
    window.addEventListener('mousemove', (e: MouseEvent) => onMove(e));
    window.addEventListener('mouseup', onUp);
    canvas.addEventListener('touchstart', (e: TouchEvent) => { e.preventDefault(); onDown(e.touches[0]); }, { passive: false });
    canvas.addEventListener('touchmove', (e: TouchEvent) => {
      e.preventDefault();
      for (let i = 0; i < e.touches.length; i++) onMove(e.touches[i]);
    }, { passive: false });
    canvas.addEventListener('touchend', () => { onUp(); hasLast = false; }, { passive: false });
    canvas.addEventListener('mouseleave', () => { hasLast = false; });

    function processQueue(): void {
      for (const s of queue) {
        splatVelocity(s.x, s.y, s.dx, s.dy, config.SPLAT_RADIUS);
        if (s.dye) splatDye(s.x, s.y, smokeColor(0.18, Math.random() * 0.5), config.SPLAT_RADIUS * 1.05);
      }
      queue.length = 0;
    }

    // ── Visibility gating ─────────────────────
    // The canvas is now scoped to the hero section rather than the full
    // page, so gate all GPU work (and splat queuing) on the section
    // actually being on screen — otherwise scrolling back to the hero
    // after time away would dump a burst of stale queued splats, and the
    // sim would keep running while scrolled past it.
    let heroVisible = false;
    const observerTarget = root.closest<HTMLElement>('.hero-section') || root;
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => { heroVisible = entry.isIntersecting; });
    });
    io.observe(observerTarget);

    let lastTime = performance.now();
    let resizeTimer: ReturnType<typeof setTimeout> | null = null;
    function frame(now: number): void {
      let dt = (now - lastTime) / 1000;
      lastTime = now;
      dt = Math.min(dt, 0.016666);

      if (heroVisible && !document.hidden) {
        stepIntro(dt);
        processQueue();
        step(dt);
        render();
      }
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);

    window.addEventListener('resize', () => {
      if (resizeTimer) clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        if (resizeCanvas()) initFramebuffers();
      }, 120);
    });

    canvas.addEventListener('webglcontextlost', (e: Event) => { e.preventDefault(); }, false);

    // ── Debug panel ────────────────────────────
    const panel  = root.querySelector<HTMLElement>('[data-fluid-panel]');
    const toggle = root.querySelector<HTMLButtonElement>('[data-fluid-toggle]');

    if (toggle && panel) {
      toggle.addEventListener('click', () => {
        const open = panel.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      document.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Escape' && panel.classList.contains('is-open')) {
          panel.classList.remove('is-open');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.focus();
        }
      });

      function bindSlider(key: keyof FluidConfig, valueKey: string, fmt: (v: number) => string): void {
        const el  = root!.querySelector<HTMLInputElement>(`[data-fluid-slider="${key}"]`);
        const out = root!.querySelector<HTMLElement>(`[data-fluid-value="${valueKey}"]`);
        if (!el || !out) return;
        el.value = String(config[key]);
        out.textContent = fmt(config[key]);
        el.addEventListener('input', () => {
          config[key] = parseFloat(el.value);
          out.textContent = fmt(config[key]);
        });
      }
      const f1 = (v: number) => v.toFixed(1);
      const f2 = (v: number) => v.toFixed(2);
      bindSlider('GLOW', 'glow', f2);
      bindSlider('BUOYANCY', 'rise', f1);
      bindSlider('CURL', 'swirl', f1);
      bindSlider('DENSITY_DISSIPATION', 'linger', f2);

      const clearBtn = root.querySelector<HTMLButtonElement>('[data-fluid-clear]');
      clearBtn?.addEventListener('click', () => {
        clearProgram.bind();
        gl!.uniform1i(clearProgram.uniforms.uTexture, dye.read.attach(0));
        gl!.uniform1f(clearProgram.uniforms.value, 0.0);
        blit(dye.write); dye.swap();
        gl!.uniform1i(clearProgram.uniforms.uTexture, velocity.read.attach(0));
        gl!.uniform1f(clearProgram.uniforms.value, 0.0);
        blit(velocity.write); velocity.swap();
      });
    }
  });
</script>
