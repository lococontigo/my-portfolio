---
import en from '../i18n/en.json';
import zhHant from '../i18n/zh-hant.json';

const locale = Astro.currentLocale ?? 'en';
const dict   = locale === 'zh-Hant' ? zhHant : en;
---
<footer class="footer">
  <div class="padding-global">
    <div class="container-main">
      <div class="footer-inner">

        <p class="footer-copy">© 2026 Andrew YIP</p>

        <div class="footer-links">
          <a
            href="https://www.linkedin.com/in/andrewthyip/"
            class="footer-link"
            target="_blank"
            rel="noopener noreferrer"
          >{dict.footer.linkedin}</a>
          <a href="mailto:andrewthyip@gmail.com" class="footer-cta">{dict.footer.sayHello}</a>
        </div>

      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 0.5px solid var(--border);
  }

  .footer-inner {
    display:         flex;
    align-items:     center;
    justify-content: space-between;
    padding-block:   20px;
  }

  .footer-copy {
    font-family: var(--font-body);
    font-size:   12px;
    font-weight: 400;
    color:       var(--text-2);
  }

  .footer-links {
    display:     flex;
    align-items: center;
    gap:         24px;
  }

  .footer-link {
    font-family: var(--font-body);
    font-size:   12px;
    font-weight: 400;
    color:       var(--text-2);
    transition:  color 0.25s var(--ease);
  }

  .footer-link:hover {
    color: var(--text-1);
  }

  .footer-cta {
    font-family:   var(--font-body);
    font-size:     12px;
    font-weight:   400;
    /* --accent-text, not --accent: light theme's teal is 3.05:1 against
       --bg, failing WCAG AA text contrast — see nav.astro's .nav-cta for
       the same fix. */
    color:         var(--accent-text);
    border:        0.5px solid var(--accent);
    border-radius: var(--r-sm);
    padding:       6px 14px;
    transition:    color 0.25s var(--ease),
                   background 0.25s var(--ease),
                   box-shadow 0.25s var(--ease),
                   transform 0.1s var(--ease);
  }

  .footer-cta:hover  { background: var(--accent-dim); box-shadow: var(--neon-sm); }
  .footer-cta:active { transform: scale(0.96); }

  @media (max-width: 520px) {
    .footer-copy  { font-size: 10px; }
    .footer-inner { flex-direction: column; gap: var(--space-sm); text-align: center; }
    .footer-links { gap: 12px; }
  }
</style>
