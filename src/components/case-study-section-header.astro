---
const { eyebrow, title } = Astro.props;
---

<div class="section-header">
  <span class="section-header-eyebrow">{eyebrow}</span>
  <h2 class="section-header-title">{title}</h2>
</div>

<style>
  .section-header {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-xs);
    margin-bottom:  clamp(32px, 5.5vw, 80px);
  }

  .section-header-eyebrow {
    font-family: var(--font-body);
    font-size:   16px;
    font-weight: 400;
    color:       var(--text-1);
  }

  .section-header-title {
    font-family:    var(--font-display);
    font-size:      clamp(36px, 3.6vw, 52px);
    font-weight:    300;
    line-height:    1;
    letter-spacing: -1.04px;
    color:          var(--text-1);
  }
</style>
