---
import CaseStudySectionHeader from './case-study-section-header.astro';
import CaseStudyVideo from './case-study-video.astro';

const { eyebrow, title, rows = [], mediaRows = [], videoSrc, id, tinted = false } = Astro.props;
---

<section class={`case-solution-section ${tinted ? 'case-solution-section--tinted' : ''}`} id={id}>
  <div class="padding-global">
    <div class="container-main">
      <div class="case-solution">

        <CaseStudySectionHeader eyebrow={eyebrow} title={title} />

        {rows.length > 0 && (
          <div class="case-solution-panel">
            <div class="case-solution-rows">
              {rows.map((row: { imageSrc: string; imageAlt: string; title: string; body: string; reverse?: boolean }) => (
                <div class={`case-solution-row ${row.reverse ? 'case-solution-row--reverse' : ''}`}>
                  <div class="case-solution-media">
                    <img src={row.imageSrc} alt={row.imageAlt} width="348" height="700" loading="lazy" />
                  </div>
                  <div class="case-solution-text">
                    <h3 class="case-solution-row-title">{row.title}</h3>
                    <p class="case-solution-row-body">{row.body}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {mediaRows.length > 0 && (
          <div class="case-solution-media-rows">
            {mediaRows.map((row: { imageSrc: string; imageAlt: string; title: string; body: string }) => (
              <div class="case-solution-media-row">
                <div class="case-solution-media-frame">
                  <img src={row.imageSrc} alt={row.imageAlt} loading="lazy" />
                </div>
                <div class="case-solution-media-text">
                  <h3 class="case-solution-media-title">{row.title}</h3>
                  <p class="case-solution-media-body">{row.body}</p>
                </div>
              </div>
            ))}
          </div>
        )}

        {videoSrc && (
          <div class="case-solution-video">
            <CaseStudyVideo videoSrc={videoSrc} autoplay={false} muted={false} loop={false} />
          </div>
        )}

      </div>
    </div>
  </div>
</section>

<style>
  .case-solution-section--tinted {
    background: var(--bg-2);
  }

  .case-solution-panel {
    background:    var(--surface-2);
    border-radius: var(--r-lg);
    padding:       var(--space-lg);
  }

  .case-solution-video {
    margin-top: clamp(32px, 5.5vw, 80px);
  }

  .case-solution-rows {
    display:        flex;
    flex-direction: column;
    gap:            clamp(20px, 2.8vw, 40px);
  }

  .case-solution-row {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(12px, 1.7vw, 24px);
    align-items:           center;
    max-width:             1196px;
    margin-inline:         auto;
  }

  .case-solution-media {
    order: 1;
  }

  .case-solution-text {
    order: 2;
  }

  .case-solution-row--reverse .case-solution-media {
    order: 2;
  }

  .case-solution-row--reverse .case-solution-text {
    order: 1;
  }

  .case-solution-media img {
    display:     block;
    width:       100%;
    max-width:   clamp(220px, 26vw, 320px);
    height:      auto;
    margin-inline: auto;
  }

  .case-solution-row-title {
    font-family:    var(--font-display);
    font-size:      clamp(28px, 3.1vw, 45px);
    font-weight:    400;
    line-height:    1.2;
    letter-spacing: -0.28px;
    color:          var(--text-1);
    margin-bottom:  clamp(16px, 1.7vw, 24px);
  }

  .case-solution-row-body {
    font-family: var(--font-body);
    font-size:   15px;
    font-weight: 400;
    line-height: 1.49;
    color:       var(--text-1);
  }

  /* ── Media rows (full-width screen captures) ─ */
  .case-solution-media-rows {
    display:        flex;
    flex-direction: column;
    gap:            clamp(32px, 5.5vw, 80px);
  }

  .case-solution-media-row {
    display:        flex;
    flex-direction: column;
    gap:            clamp(20px, 2.8vw, 40px);
  }

  .case-solution-media-frame img {
    display:       block;
    width:         100%;
    height:        auto;
    aspect-ratio:  16 / 9;
    object-fit:    cover;
    border-radius: var(--r-lg);
  }

  .case-solution-media-text {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(12px, 1.7vw, 24px);
    align-items:           center;
  }

  .case-solution-media-title {
    font-family:    var(--font-display);
    font-size:      clamp(28px, 3.1vw, 45px);
    font-weight:    400;
    line-height:    1.2;
    letter-spacing: -0.28px;
    color:          var(--text-1);
  }

  .case-solution-media-body {
    font-family: var(--font-body);
    font-size:   15px;
    font-weight: 400;
    line-height: 1.49;
    color:       var(--text-1);
  }

  @media (max-width: 768px) {
    .case-solution-media-text {
      grid-template-columns: 1fr;
      gap:                   var(--space-sm);
    }
  }

  @media (max-width: 1024px) {
    .case-solution-panel {
      padding: var(--space-md);
    }
  }

  @media (max-width: 768px) {
    .case-solution-row {
      grid-template-columns: 1fr;
      gap:                   var(--space-sm);
    }

    .case-solution-media,
    .case-solution-row--reverse .case-solution-media {
      order: 1;
    }

    .case-solution-text,
    .case-solution-row--reverse .case-solution-text {
      order: 2;
    }
  }

  @media (max-width: 520px) {
    .case-solution-panel {
      padding: var(--space-sm);
    }
  }
</style>
