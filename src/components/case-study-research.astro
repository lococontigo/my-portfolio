---
import CaseStudySectionHeader from './case-study-section-header.astro';

const { eyebrow, title, id, surveyCols = [], stats = [], imageSrc, imageAlt, quotePanels = [] } = Astro.props;
---

<section class="case-research-section" id={id}>
  <div class="padding-global">
    <div class="container-main">
      <div class="case-research">

        <CaseStudySectionHeader eyebrow={eyebrow} title={title} />

        {surveyCols.length > 0 && (
          <div class="case-research-survey-grid">
            {surveyCols.map((col: { label: string; items: string[]; imageSrc: string; imageAlt: string }) => (
              <div class="case-research-survey-col">
                <span class="case-research-survey-label">{col.label}</span>
                <ul class="case-research-survey-list">
                  {col.items.map((item: string) => <li>{item}</li>)}
                </ul>
                <div class="case-research-survey-image">
                  <img src={col.imageSrc} alt={col.imageAlt} loading="lazy" />
                </div>
              </div>
            ))}
          </div>
        )}

        {stats.length > 0 && (
          <div class="case-research-stats">
            {stats.map((stat: { value: string; title: string; body: string }) => (
              <div class="case-research-stat">
                <p class="case-research-stat-value">{stat.value}</p>
                <h3 class="case-research-stat-title">{stat.title}</h3>
                <p class="case-research-stat-body">{stat.body}</p>
              </div>
            ))}
          </div>
        )}

        {imageSrc && (
          <div class="case-research-feedback">
            <img src={imageSrc} alt={imageAlt} loading="lazy" />
          </div>
        )}

        {quotePanels.length > 0 && (
          <div class="case-research-quotes" data-horizontal-scroll>
            <div class="case-research-quotes-track" data-scroll-track>
              {quotePanels.map((panel: { imageSrc: string; imageAlt: string; quote: string; attribution: string }) => (
                <div class="case-research-quote-panel">
                  <img class="case-research-quote-image" src={panel.imageSrc} alt={panel.imageAlt} loading="lazy" />
                  <div class="case-research-quote-overlay"></div>
                  <div class="case-research-quote-content">
                    <blockquote class="case-research-quote-text">{panel.quote}</blockquote>
                    <p class="case-research-quote-attribution">{panel.attribution}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

      </div>
    </div>
  </div>
</section>

<style>
  /* ── Survey grid ─────────────────────────── */
  .case-research-survey-grid {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(12px, 1.7vw, 24px);
    margin-bottom:         clamp(12px, 1.7vw, 24px);
  }

  .case-research-survey-col {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-xs);
    padding:        var(--space-md);
    background:     var(--bg-2);
    border-radius:  var(--r-lg);
  }

  .case-research-survey-label {
    font-family: var(--font-body);
    font-size:   15px;
    font-weight: 700;
    color:       var(--case-accent, var(--accent-2));
  }

  .case-research-survey-list {
    list-style:     disc;
    padding-left:   var(--space-sm);
    display:        flex;
    flex-direction: column;
    gap:            4px;
  }

  .case-research-survey-list li {
    font-family: var(--font-body);
    font-size:   15px;
    font-weight: 300;
    line-height: 1.6;
    color:       var(--text-1);
  }

  .case-research-survey-image {
    margin-top:    var(--space-xs);
    aspect-ratio:  648 / 311;
    border-radius: var(--r-md);
    overflow:      hidden;
  }

  .case-research-survey-image img {
    display:    block;
    width:      100%;
    height:     100%;
    object-fit: cover;
  }

  /* ── Stats row ───────────────────────────── */
  .case-research-stats {
    display:               grid;
    grid-template-columns: repeat(3, 1fr);
    gap:                   clamp(12px, 1.7vw, 24px);
    margin-bottom:         clamp(12px, 1.7vw, 24px);
  }

  .case-research-stat {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-xs);
    padding:        var(--space-md);
    background:     var(--bg-2);
    border-radius:  var(--r-lg);
  }

  .case-research-stat-value {
    font-family:    var(--font-display);
    font-size:      clamp(40px, 5.5vw, 80px);
    font-weight:    300;
    line-height:    1.2;
    letter-spacing: -1.04px;
    color:          var(--case-accent, var(--accent-2));
  }

  .case-research-stat-title {
    font-family: var(--font-display);
    font-size:   clamp(20px, 1.9vw, 27px);
    font-weight: 400;
    line-height: 1.2;
    color:       var(--text-1);
  }

  .case-research-stat-body {
    font-family: var(--font-body);
    font-size:   15px;
    font-weight: 300;
    line-height: 1.6;
    color:       var(--text-2);
  }

  /* ── Feedback image ──────────────────────── */
  .case-research-feedback {
    margin-bottom: clamp(12px, 1.7vw, 24px);
  }

  .case-research-feedback:last-child {
    margin-bottom: 0;
  }

  .case-research-feedback img {
    display:       block;
    width:         100%;
    height:        auto;
    border-radius: var(--r-lg);
  }

  /* ── Interview quote scroller ────────────── */
  .case-research-quotes {
    position:     relative;
    aspect-ratio: 8 / 9;
  }

  .case-research-quotes-track {
    position:     sticky;
    top:          0;
    display:      flex;
    width:        200%;
    aspect-ratio: 32 / 9;
  }

  .case-research-quote-panel {
    position:      relative;
    flex-shrink:   0;
    width:         50%;
    border-radius: var(--r-lg);
    overflow:      hidden;
  }

  .case-research-quote-image {
    display:    block;
    width:      100%;
    height:     100%;
    object-fit: cover;
  }

  .case-research-quote-overlay {
    position:   absolute;
    inset:      0;
    background: var(--scrim);
  }

  .case-research-quote-content {
    position:        absolute;
    inset:           0;
    display:         flex;
    flex-direction:  column;
    justify-content: center;
    gap:             var(--space-sm);
    max-width:       720px;
    padding:         var(--space-lg);
  }

  .case-research-quote-text {
    font-family: var(--font-display);
    font-style:  italic;
    font-size:   clamp(28px, 4vw, 56px);
    font-weight: 300;
    line-height: 1.3;
    color:       var(--text-on-image);
  }

  .case-research-quote-text::before { content: '\201C'; }
  .case-research-quote-text::after  { content: '\201D'; }

  .case-research-quote-attribution {
    font-family: var(--font-body);
    font-size:   16px;
    font-weight: 400;
    color:       var(--text-on-image);
  }

  @media (max-width: 768px) {
    .case-research-survey-grid,
    .case-research-stats {
      grid-template-columns: 1fr;
      gap:                   var(--space-sm);
    }

    .case-research-quotes {
      aspect-ratio: auto;
    }

    .case-research-quotes-track {
      position:       static;
      flex-direction: column;
      width:          100%;
      aspect-ratio:   auto;
      gap:            var(--space-sm);
    }

    .case-research-quote-panel {
      width:        100%;
      aspect-ratio: 16 / 9;
    }

    .case-research-quote-content {
      padding: var(--space-md);
    }
  }
</style>
