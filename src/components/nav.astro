---
const pathname = Astro.url.pathname;
const { sections = [] } = Astro.props;
---

<nav class="nav">

  <!-- ── Bar ──────────────────────────────── -->
  <div class="padding-global">
    <div class="container-main">
      <div class="nav-inner">

        <!-- Logo mark -->
        <a href="/" class="nav-logo" aria-label="Andrew Yip — Home">
          <img src="/images/logo.png" alt="Andrew Yip" class="nav-logo-img" />
        </a>

        <!-- Desktop links -->
        <div class="nav-links">
          <div class="nav-links-default">
            <a href="/"      class={`nav-link${pathname === '/'      ? ' active' : ''}`}>Work</a>
            <a href="/about" class={`nav-link${pathname === '/about' ? ' active' : ''}`}>About</a>
            <a href="mailto:andrewyip30@gmail.com" class="nav-cta">Say hello →</a>
          </div>

          {sections.length > 0 && (
            <div class="nav-links-sections">
              {sections.map((s: { id: string; label: string }) => (
                <a href={`#${s.id}`} class="nav-link nav-link-section">{s.label}</a>
              ))}
            </div>
          )}
        </div>

        <!-- Hamburger (mobile) -->
        <button class="nav-burger" id="nav-burger" aria-label="Toggle navigation" aria-expanded="false">
          <span class="nav-burger-bar"></span>
          <span class="nav-burger-bar"></span>
        </button>

      </div>
    </div>
  </div>

  <!-- ── Mobile overlay ───────────────────── -->
  <div class="nav-mobile" id="nav-mobile" aria-hidden="true">
    <div class="nav-mobile-inner">
      <a href="/"      class={`nav-mobile-link${pathname === '/'      ? ' active' : ''}`}>Work</a>
      <a href="/about" class={`nav-mobile-link${pathname === '/about' ? ' active' : ''}`}>About</a>
      <a href="mailto:andrewthyip@gmail.com" class="nav-mobile-cta">Say hello →</a>
    </div>
  </div>

</nav>

<style>
  /* ── Fixed shell ───────────────────────── */
  .nav {
    position: fixed;
    top:      0;
    left:     0;
    right:    0;
    z-index:  100;
  }

  /* Top padding scoped to nav only */
  .padding-global {
    padding-top: 16px;
  }

  /* ── Dark card ─────────────────────────── */
  .nav-inner {
    display:         flex;
    align-items:     center;
    justify-content: space-between;
    height:          56px;
    padding:         0 24px;
    background:      var(--bg);
    border:          0.5px solid var(--border);
    border-radius:   var(--r-lg);
    transition:      background 0.4s var(--ease),
                     border-color 0.3s var(--ease),
                     backdrop-filter 0.4s var(--ease);
  }

  /* ── Glassmorphism on scroll ───────────── */
  .nav.scrolled .nav-inner {
    background:              color-mix(in srgb, var(--bg) 65%, transparent);
    backdrop-filter:         blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border-color:            var(--border-2);
  }

  /* ── Logo ──────────────────────────────── */
  .nav-logo {
    display:     flex;
    align-items: center;
    flex-shrink: 0;
    transition:  opacity 0.2s var(--ease);
  }

  .nav-logo:hover { opacity: 0.7; }

  .nav-logo-img {
    width:   70px;
    height:  auto;
    display: block;
  }

  :global([data-theme="dark"]) .nav-logo-img {
    filter: invert(1);
  }

  /* ── Desktop links ─────────────────────── */
  .nav-links {
    display: block;
  }

  .nav-links-default {
    display:     flex;
    align-items: center;
    gap:         4px;
  }

  .nav-links-sections {
    display: none;
  }

  .nav-link-section {
    padding:     8px 8px;
    white-space: nowrap;
  }

  .nav-link-section::after {
    left:  8px;
    right: 8px;
  }

  /* ── Case study section nav (crossfade) ─── */
  @media (min-width: 1025px) {
    .nav-links {
      display:     grid;
      align-items: center;
    }

    .nav-links-default,
    .nav-links-sections {
      grid-area:    1 / 1;
      justify-self: end;
      transition:   opacity 0.3s var(--ease);
    }

    .nav-links-sections {
      display:        flex;
      align-items:    center;
      gap:            4px;
      opacity:        0;
      pointer-events: none;
    }

    .nav.case-mode .nav-links-default {
      opacity:        0;
      pointer-events: none;
    }

    .nav.case-mode .nav-links-sections {
      opacity:        1;
      pointer-events: auto;
    }
  }

  .nav-link {
    font-family:    var(--font-body);
    font-size:      11px;
    font-weight:    500;
    letter-spacing: 0.01em;
    color:          var(--text-2);
    padding:        8px 14px;
    position:       relative;
    transition:     color 0.2s var(--ease);
  }

  .nav-link::after {
    content:          '';
    position:         absolute;
    bottom:           4px;
    left:             14px;
    right:            14px;
    height:           0.5px;
    background:       var(--accent);
    transform:        scaleX(0);
    transform-origin: left;
    transition:       transform 0.2s var(--ease);
  }

  .nav-link:hover          { color: var(--text-1); }
  .nav-link:hover::after,
  .nav-link.active::after  { transform: scaleX(1); }
  .nav-link.active         { color: var(--text-1); }

  /* ── CTA ───────────────────────────────── */
  .nav-cta {
    font-family:    var(--font-body);
    font-size:      11px;
    font-weight:    500;
    letter-spacing: 0.02em;
    color:          var(--accent);
    border:         0.5px solid var(--accent);
    border-radius:  var(--r-sm);
    padding:        6px 14px;
    margin-left:    8px;
    white-space:    nowrap;
    transition:     all 0.2s var(--ease);
  }

  .nav-cta:hover {
    background: var(--accent-dim);
    box-shadow: var(--neon-sm);
  }

  /* ── Hamburger ─────────────────────────── */
  .nav-burger {
    display:         none;
    flex-direction:  column;
    justify-content: center;
    gap:             6px;
    width:           32px;
    height:          32px;
    padding:         4px;
    color:           var(--text-2);
    transition:      color 0.2s var(--ease);
  }

  .nav-burger:hover { color: var(--text-1); }

  .nav-burger-bar {
    display:          block;
    width:            22px;
    height:           1px;
    background:       currentColor;
    border-radius:    1px;
    transform-origin: center;
    transition:       transform 0.3s var(--ease), opacity 0.2s;
  }

  .nav-burger.open .nav-burger-bar:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .nav-burger.open .nav-burger-bar:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* ── Mobile overlay ────────────────────── */
  .nav-mobile {
    position:        fixed;
    inset:           0;
    background:      var(--bg);
    z-index:         99;
    display:         flex;
    flex-direction:  column;
    align-items:     center;
    justify-content: center;
    opacity:         0;
    pointer-events:  none;
    transform:       translateY(-10px);
    transition:      opacity 0.35s var(--ease), transform 0.35s var(--ease);
  }

  .nav-mobile.open {
    opacity:        1;
    pointer-events: auto;
    transform:      translateY(0);
  }

  .nav-mobile-inner {
    display:        flex;
    flex-direction: column;
    align-items:    center;
    gap:            var(--space-sm);
  }

  .nav-mobile-link {
    font-family:    var(--font-display);
    font-size:      clamp(36px, 8vw, 56px);
    font-weight:    300;
    letter-spacing: -0.02em;
    line-height:    1.1;
    color:          var(--text-3);
    transition:     color 0.2s var(--ease);
  }

  .nav-mobile-link:hover,
  .nav-mobile-link.active { color: var(--text-1); }

  .nav-mobile-cta {
    font-family:    var(--font-body);
    font-size:      11px;
    font-weight:    500;
    letter-spacing: 0.02em;
    color:          var(--accent);
    border:         0.5px solid var(--accent);
    border-radius:  var(--r-sm);
    padding:        10px 24px;
    margin-top:     var(--space-xs);
    transition:     all 0.2s var(--ease);
  }

  .nav-mobile-cta:hover {
    background: var(--accent-dim);
    box-shadow: var(--neon-sm);
  }

  /* ── Responsive ────────────────────────── */
  @media (max-width: 768px) {
    .nav-links  { display: none; }
    .nav-burger { display: flex; }
    .nav-inner  { padding: 0 16px; }
  }

  @media (max-width: 520px) {
    .padding-global { padding-top: 12px; }
    .nav-inner      { height: 48px; }
  }
</style>

<script>
  const nav    = document.querySelector('.nav') as HTMLElement | null;
  const burger = document.getElementById('nav-burger') as HTMLButtonElement | null;
  const mobile = document.getElementById('nav-mobile') as HTMLElement | null;

  if (nav) {
    window.addEventListener('scroll', () => {
      nav.classList.toggle('scrolled', window.scrollY > 20);
    }, { passive: true });
  }

  if (burger && mobile) {
    burger.addEventListener('click', () => {
      const isOpen = mobile.classList.toggle('open');
      burger.classList.toggle('open');
      burger.setAttribute('aria-expanded', String(isOpen));
      mobile.setAttribute('aria-hidden', String(!isOpen));
      document.body.style.overflow = isOpen ? 'hidden' : '';
    });

    mobile.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobile.classList.remove('open');
        burger.classList.remove('open');
        burger.setAttribute('aria-expanded', 'false');
        mobile.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      });
    });
  }

  // ── Case study section nav ────────────────
  const sectionLinks = document.querySelectorAll('.nav-link-section');

  if (nav && sectionLinks.length) {
    const hero = document.querySelector('.case-hero-section');

    const updateMode = () => {
      const threshold = hero
        ? hero.getBoundingClientRect().bottom + window.scrollY - 96
        : 400;
      nav.classList.toggle('case-mode', window.scrollY > threshold);
    };

    window.addEventListener('scroll', updateMode, { passive: true });
    updateMode();

    const sectionEls = Array.from(sectionLinks)
      .map((link) => document.getElementById((link.getAttribute('href') || '').slice(1)))
      .filter((el): el is HTMLElement => el !== null);

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          sectionLinks.forEach((link) => {
            link.classList.toggle('active', link.getAttribute('href') === `#${entry.target.id}`);
          });
        }
      });
    }, { rootMargin: '-45% 0px -50% 0px' });

    sectionEls.forEach((el) => observer.observe(el));
  }
</script>
