---
interface Props {
  fallbackSrc: string;
  fallbackAlt: string;
}
const { fallbackSrc, fallbackAlt } = Astro.props;
---

<div class="case-globe" data-case-globe>
  <canvas class="case-globe-canvas" data-globe-canvas aria-hidden="true"></canvas>
  <img class="case-globe-fallback" data-globe-fallback src={fallbackSrc} alt={fallbackAlt} loading="lazy" />
</div>

<style>
  .case-globe {
    position:   relative;
    width:      100%;
    height:     100%;
    background: transparent;
  }

  .case-globe-canvas {
    position: absolute;
    inset:    0;
    width:    100%;
    height:   100%;
    display:  none;
    cursor:   grab;
  }

  .case-globe-canvas[data-visible] {
    display: block;
  }

  .case-globe-canvas:active {
    cursor: grabbing;
  }

  .case-globe-fallback {
    display:    block;
    width:      100%;
    height:     100%;
    object-fit: cover;
  }

  .case-globe-fallback[data-hidden] {
    display: none;
  }
</style>

<script>
  // Adapted from a standalone Three.js globe prototype. Ported to this
  // codebase's established conventions for exactly this kind of thing (see
  // hero-fluid-bg.astro, case-study-compare-slider.astro): data-attribute
  // scoped so multiple instances on one page never collide, full bailout on
  // prefers-reduced-motion, IntersectionObserver-gated so the (lazily
  // loaded) Three.js payload and the render loop only ever run while the
  // card is actually visible.
  //
  // Progressive enhancement, deliberately in this order: the fallback <img>
  // (the same static illustration this replaced) is visible by default in
  // the markup above. This script only switches to the canvas once a real
  // WebGL globe is actually up and rendering — so no-JS, reduced-motion,
  // and WebGL-unavailable visitors all still see the correct image, never
  // a blank box.

  declare const THREE: any;

  let threeLoadPromise: Promise<void> | null = null;
  function loadThree(): Promise<void> {
    if (typeof THREE !== 'undefined') return Promise.resolve();
    if (threeLoadPromise) return threeLoadPromise;
    threeLoadPromise = new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = 'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js';
      script.onload = () => resolve();
      script.onerror = () => reject(new Error('Failed to load three.js'));
      document.head.appendChild(script);
    });
    return threeLoadPromise;
  }

  function initGlobe(root: HTMLElement): void {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-globe-canvas]');
    const fallback = root.querySelector<HTMLImageElement>('[data-globe-fallback]');
    if (!canvas || !fallback) return;

    const RADIUS = 1;
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 100);
    // The reference prototype framed this in a 720x470 (~1.53:1) box; this
    // card's own frame (.case-research-survey-image, 648/311 ~= 2.08:1) is
    // wider and shorter, which crops more of the sphere's top/bottom at the
    // same camera distance — that's the intended "cut off at the bottom"
    // look carried over from the reference, just naturally more pronounced
    // in this wider frame.
    camera.position.set(0, 0.1, 2.7);

    function resize(): boolean {
      const w = root.clientWidth, h = root.clientHeight;
      if (w === 0 || h === 0) return false;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      return true;
    }

    const globeGroup = new THREE.Group();
    scene.add(globeGroup);

    function buildGraticule(radius: number, meridians: number, parallels: number) {
      const group = new THREE.Group();
      const mat = new THREE.LineBasicMaterial({ color: 0x2f7ab8, transparent: true, opacity: 0.32 });
      const matEq = new THREE.LineBasicMaterial({ color: 0x6fd4ff, transparent: true, opacity: 0.55 });
      for (let i = 0; i < meridians; i++) {
        const theta = (i / meridians) * Math.PI * 2;
        const pts = [];
        for (let j = 0; j <= 72; j++) {
          const phi = (j / 72) * Math.PI * 2;
          pts.push(new THREE.Vector3(radius * Math.sin(phi) * Math.cos(theta), radius * Math.cos(phi), radius * Math.sin(phi) * Math.sin(theta)));
        }
        group.add(new THREE.LineLoop(new THREE.BufferGeometry().setFromPoints(pts), mat));
      }
      for (let i = 1; i < parallels; i++) {
        const lat = -90 + (i / parallels) * 180;
        const phi = (90 - lat) * (Math.PI / 180);
        const y = radius * Math.cos(phi);
        const r = radius * Math.sin(phi);
        const pts = [];
        for (let j = 0; j <= 72; j++) {
          const t = (j / 72) * Math.PI * 2;
          pts.push(new THREE.Vector3(r * Math.cos(t), y, r * Math.sin(t)));
        }
        const isEquator = Math.abs(lat) < 1;
        group.add(new THREE.LineLoop(new THREE.BufferGeometry().setFromPoints(pts), isEquator ? matEq : mat));
      }
      return group;
    }
    globeGroup.add(buildGraticule(RADIUS, 18, 14));

    const CONTINENTS = [
      [[-160,68],[-141,69],[-125,55],[-125,48],[-124,40],[-117,32],[-105,20],
       [-97,18],[-90,16],[-84,10],[-80,25],[-75,35],[-70,44],[-60,47],[-55,52],
       [-65,60],[-80,62],[-95,68],[-110,72],[-130,71],[-160,68]],
      [[-79,9],[-77,1],[-70,-4],[-70,-18],[-71,-30],[-72,-42],[-68,-54],[-65,-55],
       [-62,-45],[-58,-34],[-48,-25],[-35,-9],[-50,3],[-60,9],[-72,11],[-79,9]],
      [[-17,15],[-16,7],[-9,5],[3,6],[9,4],[9,-3],[13,-15],[12,-18],[16,-28],
       [20,-34],[28,-33],[33,-25],[35,-20],[40,-11],[43,0],[50,-1],[51,10],
       [43,12],[38,15],[35,22],[36,30],[32,31],[25,32],[10,37],[-2,36],[-9,32],[-17,15]],
      [[-9,38],[-9,43],[-2,44],[3,42],[7,44],[8,48],[2,51],[4,53],[9,54],[8,57],
       [11,59],[18,58],[23,60],[28,60],[30,55],[27,47],[20,42],[14,38],[6,37],[-1,36],[-9,38]],
      [[27,42],[30,55],[27,60],[35,66],[45,68],[60,70],[75,73],[95,75],[113,73],
       [130,71],[140,60],[135,50],[128,42],[122,31],[110,20],[103,10],[97,6],
       [92,15],[80,17],[70,25],[62,25],[55,27],[48,30],[42,37],[35,38],[27,42]],
      [[113,-22],[121,-19],[130,-12],[137,-12],[142,-11],[145,-16],[150,-22],
       [153,-28],[150,-33],[142,-38],[135,-35],[128,-32],[118,-34],[113,-26],[113,-22]]
    ];
    function pointInPolygon(lon: number, lat: number, poly: number[][]): boolean {
      let inside = false;
      for (let i = 0, j = poly.length - 1; i < poly.length; j = i++) {
        const [xi, yi] = poly[i], [xj, yj] = poly[j];
        const intersect = ((yi > lat) !== (yj > lat)) && (lon < (xj - xi) * (lat - yi) / (yj - yi) + xi);
        if (intersect) inside = !inside;
      }
      return inside;
    }
    function latLonToVec3(lat: number, lon: number, r: number) {
      const phi = (90 - lat) * (Math.PI / 180);
      const theta = (lon + 180) * (Math.PI / 180);
      return new THREE.Vector3(-r * Math.sin(phi) * Math.cos(theta), r * Math.cos(phi), r * Math.sin(phi) * Math.sin(theta));
    }
    function buildDotSprite() {
      const size = 64;
      const c = document.createElement('canvas'); c.width = c.height = size;
      const ctx = c.getContext('2d')!;
      const g = ctx.createRadialGradient(size/2, size/2, 0, size/2, size/2, size/2);
      g.addColorStop(0, 'rgba(255,255,255,1)');
      g.addColorStop(0.35, 'rgba(150,235,255,0.85)');
      g.addColorStop(1, 'rgba(150,235,255,0)');
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, size, size);
      return new THREE.CanvasTexture(c);
    }
    const dotSprite = buildDotSprite();
    const positions: number[] = [];
    const step = 1.4;
    for (let lat = -88; lat <= 88; lat += step) {
      for (let lon = -180; lon <= 180; lon += step) {
        const onLand = CONTINENTS.some(poly => pointInPolygon(lon, lat, poly));
        if (!onLand) continue;
        if (Math.random() > 0.65) continue;
        const v = latLonToVec3(lat + (Math.random()-0.5)*step, lon + (Math.random()-0.5)*step, RADIUS * 1.002);
        positions.push(v.x, v.y, v.z);
      }
    }
    const dotGeo = new THREE.BufferGeometry();
    dotGeo.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
    const dotMat = new THREE.PointsMaterial({ size: 0.028, map: dotSprite, transparent: true, opacity: 0.9, blending: THREE.AdditiveBlending, depthWrite: false, sizeAttenuation: true });
    globeGroup.add(new THREE.Points(dotGeo, dotMat));

    const atmoMat = new THREE.ShaderMaterial({
      transparent: true, blending: THREE.AdditiveBlending, side: THREE.BackSide,
      uniforms: { glowColor: { value: new THREE.Color(0x4fd8ff) } },
      vertexShader: `varying float intensity; void main() { vec3 vNormal = normalize(normalMatrix * normal); vec3 vNormel = normalize(normalMatrix * vec3(0.0, 0.0, 1.0)); intensity = pow(clamp(0.5 - dot(vNormal, vNormel), 0.0, 1.0), 4.5); gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0); }`,
      fragmentShader: `uniform vec3 glowColor; varying float intensity; void main() { gl_FragColor = vec4(glowColor, 1.0) * intensity * 0.55; }`
    });
    globeGroup.add(new THREE.Mesh(new THREE.SphereGeometry(RADIUS * 1.08, 64, 64), atmoMat));

    function makeArc(startLL: number[], endLL: number[], colorHex: number) {
      const start = latLonToVec3(startLL[0], startLL[1], RADIUS);
      const end = latLonToVec3(endLL[0], endLL[1], RADIUS);
      const mid = start.clone().add(end).multiplyScalar(0.5);
      mid.setLength(RADIUS * 1.4);
      const curve = new THREE.QuadraticBezierCurve3(start, mid, end);
      const tubeGeo = new THREE.TubeGeometry(curve, 80, 0.006, 8, false);
      const tubeMat = new THREE.MeshBasicMaterial({ color: colorHex, transparent: true, opacity: 0.85, blending: THREE.AdditiveBlending });
      globeGroup.add(new THREE.Mesh(tubeGeo, tubeMat));
      const flare = new THREE.Mesh(new THREE.SphereGeometry(0.018, 12, 12), new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.95, blending: THREE.AdditiveBlending }));
      globeGroup.add(flare);
      return { curve, flare };
    }
    const arcs = [
      makeArc([1, 34], [51, 4], 0xff6a35),
      makeArc([-14, -51], [40, 116], 0xffd23f),
      makeArc([37, -95], [51, 10], 0x6fe0ff)
    ];

    // Tip the north pole toward the camera so the animation starts looking
    // down at the top of the globe, rather than the default straight-on
    // equatorial view — within the same clamp range drag uses below.
    globeGroup.rotation.x = 0.8;

    let autoRotate = true, isDragging = false;
    let prev = { x: 0, y: 0 };
    const rotVel = { x: 0, y: 0 };

    canvas.addEventListener('pointerdown', (e: PointerEvent) => {
      isDragging = true; autoRotate = false;
      prev = { x: e.clientX, y: e.clientY };
      canvas.setPointerCapture(e.pointerId);
    });
    canvas.addEventListener('pointermove', (e: PointerEvent) => {
      if (!isDragging) return;
      const dx = e.clientX - prev.x, dy = e.clientY - prev.y;
      rotVel.y = dx * 0.005; rotVel.x = dy * 0.005;
      globeGroup.rotation.y += rotVel.y;
      globeGroup.rotation.x = THREE.MathUtils.clamp(globeGroup.rotation.x + rotVel.x, -1.1, 1.1);
      prev = { x: e.clientX, y: e.clientY };
    });
    canvas.addEventListener('pointerup', () => { isDragging = false; });
    canvas.addEventListener('pointercancel', () => { isDragging = false; });

    let visible = false;
    const clock = new THREE.Clock();
    function animate() {
      requestAnimationFrame(animate);
      if (!visible || document.hidden) return;
      const dt = clock.getDelta();
      const t = clock.getElapsedTime();
      if (autoRotate) globeGroup.rotation.y += dt * 0.1;
      else if (!isDragging) {
        rotVel.x *= 0.92; rotVel.y *= 0.92;
        globeGroup.rotation.y += rotVel.y * 0.15;
        globeGroup.rotation.x = THREE.MathUtils.clamp(globeGroup.rotation.x + rotVel.x * 0.15, -1.1, 1.1);
        if (Math.abs(rotVel.x) < 0.0001 && Math.abs(rotVel.y) < 0.0001) autoRotate = true;
      }
      arcs.forEach((a, i) => {
        const local = a.curve.getPointAt((t * 0.2 + i * 0.33) % 1);
        a.flare.position.copy(local);
      });
      renderer.render(scene, camera);
    }

    canvas.addEventListener('webglcontextlost', (e: Event) => { e.preventDefault(); }, false);

    if (resize()) {
      // First real paint before revealing — avoids a flash of a
      // zero-size/garbage frame swapping in for the fallback image.
      renderer.render(scene, camera);
      fallback.setAttribute('data-hidden', '');
      canvas.setAttribute('data-visible', '');
    }

    const ro = new ResizeObserver(() => resize());
    ro.observe(root);

    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => { visible = entry.isIntersecting; });
    });
    io.observe(root);

    animate();
  }

  document.querySelectorAll<HTMLElement>('[data-case-globe]').forEach((root) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let started = false;
    const lazyInit = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting || started) return;
        started = true;
        lazyInit.disconnect();
        loadThree().then(() => initGlobe(root)).catch(() => { /* fallback image stays visible */ });
      });
    }, { rootMargin: '200px' });
    lazyInit.observe(root);
  });
</script>
