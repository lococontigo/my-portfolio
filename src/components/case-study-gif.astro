---
const { gifSrc, videoSrc, alt, aspectRatio = '16 / 9' } = Astro.props;
---

<div class="case-gif-wrap" style={`aspect-ratio: ${aspectRatio};`}>
  {videoSrc ? (
    <video class="case-gif" autoplay loop muted playsinline>
      <source src={videoSrc} type="video/mp4" />
    </video>
  ) : (
    <img class="case-gif" src={gifSrc} alt={alt} fetchpriority="high" />
  )}
</div>

<style>
  .case-gif-wrap {
    width:      100%;
    overflow:   hidden;
    background: var(--bg-3);
  }

  .case-gif {
    display:    block;
    width:      100%;
    height:     100%;
    object-fit: cover;
  }
</style>
