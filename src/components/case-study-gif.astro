---
const { gifSrc, alt, aspectRatio = '16 / 9' } = Astro.props;
---

<div class="case-gif-wrap" style={`aspect-ratio: ${aspectRatio};`}>
  <img class="case-gif" src={gifSrc} alt={alt} fetchpriority="high" />
</div>

<style>
  .case-gif-wrap {
    width:         100%;
    border-radius: var(--r-lg);
    overflow:      hidden;
    background:    var(--bg-3);
  }

  .case-gif {
    display:    block;
    width:      100%;
    height:     100%;
    object-fit: cover;
  }
</style>
