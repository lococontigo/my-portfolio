---
interface Testimonial {
  quote: string;
  name:  string;
  role:  string;
}

interface Props {
  slides?: Testimonial[];
  prevLabel?: string;
  nextLabel?: string;
  slideLabel?: (n: number) => string;
}

// Edit testimonials here — shared by about.astro and services.astro.
const defaultSlides: Testimonial[] = [
  {
    quote: 'I found Andrew’s understanding of user experience design for web combined with his relentless drive to find and implement viable solutions to achieve positive outcomes were amongst his strongest assets and talents. I strongly recommend Andrew to any potential employers or contractors needing web management or any type of UX web skills on their team as I find him to be highly reliable and very skilled in his craft.',
    name:  'Allan Lanzador',
    role:  'Director of Marketing at Delta Controls Inc.',
  },
  {
    quote: 'Whether you are looking for a UX/UI designer or a promising project manager, he would bring an extraordinary level of experience, passion and leadership to any position. Given the chance, Andrew would undoubtedly be an excellent addition to any team.',
    name:  'Aurelio Selman',
    role:  'Web Development Specialist',
  },
  {
    quote: 'Andrew has exceptional project management and design thinking skills. His strong organizational skills and ability to delegate tasks effectively helped us stay focused and productive throughout the project. I have no doubt that he will continue to excel in their future endeavors and positively impact wherever he goes.',
    name:  'Ana Rodriguez',
    role:  'Senior Graphic Designer',
  },
  {
    quote: 'Andrew values punctuality and organization. He has a reputation for fulfilling his commitments in a timely manner. Andrew will thrive in the most complex of challenges, and he would be a valuable addition to any organization requiring his skillset.',
    name:  'Winall Lopes',
    role:  'Senior SAP Consultant at IBM',
  },
  {
    quote: 'Andrew has a unique combination of creativity and strategic thinking that sets him apart from other designers. He has a deep understanding of user needs and always delivers designs that meet those needs. He was also an excellent communicator, keeping the development team informed about the status of design tasks and providing clear feedback on our work.',
    name:  'Florida Joca',
    role:  'Software Developer',
  },
  {
    quote: 'We got our website made from Andrew and he designed it really well. Thanks to his services we were able to bring our business online and get more clients.',
    name:  'Khachak Studio',
    role:  'Client',
  },
];

const {
  slides = defaultSlides,
  prevLabel = 'Previous',
  nextLabel = 'Next',
  slideLabel = (n: number) => `Slide ${n}`,
} = Astro.props as Props;
---

<div class="testi-slider" id="testi-slider">

  <div class="testi-track" id="testi-track">
    {slides.map((slide, i) => (
      <div class:list={['testi-slide', { active: i === 0 }]}>
        <span class="testi-quote-mark">"</span>
        <p class="testi-quote">{slide.quote}</p>
        <div class="testi-attribution">
          <span class="testi-dash">—</span>
          <span class="testi-name">{slide.name}</span>
          <span class="testi-sep">·</span>
          <span class="testi-role">{slide.role}</span>
        </div>
      </div>
    ))}
  </div>

  <div class="testi-controls">
    <button type="button" class="testi-btn" id="testi-prev" aria-label={prevLabel}>‹</button>
    <div class="testi-dots" id="testi-dots">
      {slides.map((_, i) => (
        <button type="button" class:list={['testi-dot', { active: i === 0 }]} aria-label={slideLabel(i + 1)}></button>
      ))}
    </div>
    <button type="button" class="testi-btn" id="testi-next" aria-label={nextLabel}>›</button>
  </div>

</div>

<style>
  .testi-slider {
    cursor: default;
  }

  .testi-track {
    display: grid;
  }

  .testi-slide {
    grid-area:      1 / 1;
    padding:        var(--space-md);
    opacity:        0;
    transform:      translateY(10px);
    transition:     opacity 0.55s var(--ease), transform 0.55s var(--ease);
    pointer-events: none;
  }

  .testi-slide.active {
    opacity:        1;
    transform:      translateY(0);
    pointer-events: auto;
  }

  .testi-quote-mark {
    font-family:   var(--font-display);
    font-size:     61px;
    line-height:   1;
    color:         var(--accent-text);
    display:       block;
    margin-bottom: -10px;
    opacity:       0.7;
    user-select:   none;
  }

  .testi-quote {
    font-family:    var(--font-body);
    font-style:     italic;
    font-size:      20px;
    font-weight:    300;
    color:          var(--text-1);
    line-height:    1.5;
    width:          100%;
    margin-bottom:  20px;
    letter-spacing: -0.01em;
    text-wrap:      pretty;
  }

  .testi-attribution {
    display:        flex;
    flex-direction: column;
    gap:            4px;
  }

  .testi-dash {
    font-size: 12px;
    color:     var(--text-2);
  }

  .testi-name {
    font-family: var(--font-body);
    font-size:   16px;
    font-weight: 500;
    color:       var(--text-1);
  }

  .testi-sep {
    display: none;
  }

  .testi-role {
    font-family: var(--font-body);
    font-size:   12px;
    color:       var(--text-2);
  }

  .testi-controls {
    display:         flex;
    align-items:     center;
    justify-content: space-between;
    margin-top:      28px;
    padding-top:     20px;
    border-top:      0.5px solid var(--border);
  }

  .testi-dots {
    display:     flex;
    align-items: center;
    gap:         8px;
  }

  .testi-dot {
    position:      relative;
    width:         6px;
    height:        6px;
    border-radius: 50%;
    background:    var(--border-2);
    cursor:        pointer;
    border:        none;
    padding:       0;
    transition-property:       background-color, box-shadow, width, border-radius;
    transition-duration:       0.25s;
    transition-timing-function: var(--ease);
  }

  /* Dots sit only 8px apart, so the hit area can't reach the usual 40px
     minimum without overlapping a neighbor — 12px is the largest square
     that still clears the tightest (two inactive dots) spacing. */
  .testi-dot::after {
    content:   '';
    position:  absolute;
    top:       50%;
    left:      50%;
    width:     12px;
    height:    12px;
    transform: translate(-50%, -50%);
  }

  .testi-dot:focus-visible {
    outline:        2px solid var(--accent);
    outline-offset: 3px;
  }

  .testi-dot.active {
    background:    var(--accent);
    box-shadow:    var(--neon-sm);
    width:         18px;
    border-radius: var(--r-pill);
  }

  .testi-btn {
    width:         40px;
    height:        40px;
    display:       inline-flex;
    align-items:   center;
    justify-content: center;
    background:    var(--bg-2);
    border:        0.5px solid var(--border);
    border-radius: var(--r-sm);
    color:         var(--text-2);
    cursor:        pointer;
    font-family:   var(--font-body);
    font-size:     16px;
    line-height:   1;
    transition-property:       border-color, color, box-shadow, scale;
    transition-duration:       0.2s;
    transition-timing-function: var(--ease);
  }

  .testi-btn:active {
    scale: 0.96;
  }

  .testi-btn:hover {
    border-color: var(--accent);
    color:        var(--accent-text);
    box-shadow:   var(--neon-sm);
  }

  @media (max-width: 520px) {
    .testi-quote {
      font-size: 16px;
    }
  }
</style>

<script>
  const slider = document.getElementById('testi-slider');
  const prev   = document.getElementById('testi-prev');
  const next   = document.getElementById('testi-next');

  if (!slider || !prev || !next) throw new Error('Testimonials: required elements not found');

  const slides  = slider.querySelectorAll('.testi-slide');
  const dots    = slider.querySelectorAll('.testi-dot');
  let current   = 0;
  let timer     = 0;
  let hovering  = false;

  function goTo(index: number) {
    slides[current].classList.remove('active');
    dots[current].classList.remove('active');
    current = (index + slides.length) % slides.length;
    slides[current].classList.add('active');
    dots[current].classList.add('active');
  }

  function startAuto() { timer = window.setInterval(() => goTo(current + 1), 5000); }
  function stopAuto()  { clearInterval(timer); }

  dots.forEach((dot, i) => dot.addEventListener('click', () => { stopAuto(); goTo(i); if (!hovering) startAuto(); }));
  prev.addEventListener('click', () => { stopAuto(); goTo(current - 1); if (!hovering) startAuto(); });
  next.addEventListener('click', () => { stopAuto(); goTo(current + 1); if (!hovering) startAuto(); });
  slider.addEventListener('mouseenter', () => { hovering = true; stopAuto(); });
  slider.addEventListener('mouseleave', () => { hovering = false; startAuto(); });

  // Keyboard navigation
  slider.setAttribute('tabindex', '0');
  slider.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'ArrowLeft')  { stopAuto(); goTo(current - 1); if (!hovering) startAuto(); }
    if (e.key === 'ArrowRight') { stopAuto(); goTo(current + 1); if (!hovering) startAuto(); }
  });

  startAuto();
</script>
