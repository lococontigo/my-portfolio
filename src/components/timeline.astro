<style>
  .timeline {
    position:       relative;
    display:        flex;
    flex-direction: column;
  }

  /* Vertical line through dot column center (56px year + 16px = 72px) */
  .timeline::before {
    content:    '';
    position:   absolute;
    left:       72px;
    top:        8px;
    bottom:     36px;
    width:      0.5px;
    background: linear-gradient(to bottom, var(--border) 60%, var(--accent));
  }

  .timeline-item {
    display:               grid;
    grid-template-columns: 56px 32px 1fr;
    align-items:           start;
    padding-bottom:        40px;
    cursor:                default;
  }

  .timeline-item:last-child {
    padding-bottom: 8px;
  }

  .timeline-year {
    font-family:  var(--font-mono);
    font-size:    11px;
    color:        var(--text-3);
    text-align:   right;
    padding-top:  3px;
    padding-right: 14px;
    line-height:  1;
    transition:   color 0.2s var(--ease);
  }

  .timeline-node {
    display:         flex;
    justify-content: center;
    padding-top:     4px;
    position:        relative;
    z-index:         1;
  }

  .timeline-dot {
    width:         8px;
    height:        8px;
    border-radius: 50%;
    background:    var(--bg);
    border:        0.5px solid var(--border-2);
    flex-shrink:   0;
    transition:    all 0.25s var(--ease);
  }

  .timeline-body {
    padding-left: 8px;
    transition:   transform 0.2s var(--ease);
  }

  .timeline-title-row {
    display:     flex;
    align-items: center;
    gap:         10px;
    flex-wrap:   wrap;
    margin-bottom: 5px;
  }

  .timeline-title {
    font-family:    var(--font-display);
    font-size:      20px;
    font-weight:    400;
    color:          var(--text-1);
    line-height:    1.2;
    letter-spacing: -0.01em;
  }

  .timeline-title em {
    font-style: italic;
    color:      var(--accent);
  }

  .timeline-desc {
    font-family:  var(--font-body);
    font-size:    11px;
    font-weight:  400;
    color:        var(--text-3);
    line-height:  1.65;
    max-width:    440px;
    margin-bottom: 8px;
  }

  .timeline-year-mobile {
    display:        none;
    font-family:    var(--font-mono);
    font-size:      8px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color:          var(--text-3);
    margin-bottom:  5px;
  }

  /* Current tag pill */
  .timeline-current-tag {
    display:        inline-flex;
    align-items:    center;
    gap:            5px;
    padding:        4px 10px;
    border-radius:  var(--r-pill);
    font-family:    var(--font-body);
    font-size:      11px;
    font-weight:    500;
    letter-spacing: 0.03em;
    color:          var(--success);
    background:     color-mix(in srgb, var(--success) 10%, transparent);
    border:         0.5px solid color-mix(in srgb, var(--success) 30%, transparent);
  }

  .timeline-current-tag::before {
    content:       '';
    display:       block;
    width:         5px;
    height:        5px;
    border-radius: 50%;
    background:    var(--success);
    flex-shrink:   0;
  }

  /* Current milestone */
  .timeline-item.current .timeline-dot {
    background:   var(--accent);
    border-color: var(--accent);
    box-shadow:   var(--neon-sm);
  }

  .timeline-item.current .timeline-year {
    color: var(--accent);
  }

  .timeline-item.current .timeline-title em {
    color: var(--accent);
  }

  /* Hover */
  .timeline-item:hover .timeline-dot {
    border-color: var(--accent);
    box-shadow:   var(--neon-sm);
    background:   var(--accent-dim);
  }

  .timeline-item:hover .timeline-year {
    color: var(--text-2);
  }

  .timeline-item:hover .timeline-body {
    transform: translateX(3px);
  }

  /* Mobile */
  @media (max-width: 520px) {
    .timeline::before {
      left: 8px;
    }

    .timeline-item {
      grid-template-columns: 20px 1fr;
    }

    .timeline-year {
      display: none;
    }

    .timeline-year-mobile {
      display: block;
    }

    .timeline-node {
      padding-top: 6px;
    }
  }
</style>
