---
interface TimelineItem {
  year?:     string;
  title:    string;
  emphasis?: string;
  desc:     string;
  current?: boolean;
}

interface Props {
  items?: TimelineItem[];
}

// Edit milestones here — shared by about.astro and services.astro.
// `emphasis` renders as the accent-colored italic word at the end of `title`.
const defaultItems: TimelineItem[] = [
  {
    year:  '2022',
    title: 'Arrived in ',
    emphasis: 'Canada',
    desc:  'Landed in Vancouver. New hemisphere, new chapter.',
  },
  {
    year:  '2022',
    title: 'WMDD Program',
    desc:  'Started a post-graduate program in Web Design & Mobile App Design & Development at Langara College.',
  },
  {
    year:  '2022',
    title: 'Freelance Projects',
    desc:  'Led the development of custom WordPress and e-commerce solutions for RKWINC and BLU-BATH, successfully migrating over 2,000 projects and driving a 25% increase in conversion rates.',
  },
  {
    year:  '2023',
    title: 'Ant Equipment Group',
    desc:  'Optimized ANT EQUIPMENT GROUP’s web platform through strategic CMS integrations and homepage redesigns, resulting in a 36.7% traffic increase and a 4-to-6x surge in monthly online orders.',
  },
  {
    year:  '2024',
    title: 'Delta Controls',
    desc:  'Designed and developed a new internal resource hub and custom CRM solution for Delta Intelligent Building Technologies, utilizing Figma and WordPress to boost user engagement by 15%.',
  },
  {
    year:  '2025',
    title: 'Yocale AI',
    desc:  'Launched feature pages for four major product releases and built a scalable Figma/Webflow component library for Yocale, optimizing Google Ads landing pages to achieve a 5.15% CTR.',
  },
  {
    year:  'Now',
    title: 'Open for New ',
    emphasis: 'Opportunity!',
    desc:  'Building UX in the world of AI.',
    current: true,
  },
];

const { items = defaultItems } = Astro.props as Props;
---

<div class:list={['timeline', { 'no-year': !items.some((i) => i.year) }]}>
  {items.map((item) => (
    <div class:list={['timeline-item', { current: item.current }]}>
      {item.year && <div class="timeline-year">{item.year}</div>}
      <div class="timeline-node"><div class="timeline-dot"></div></div>
      <div class="timeline-body">
        {item.year && <div class="timeline-year-mobile">{item.year}</div>}
        {item.current ? (
          <div class="timeline-title-row">
            <div class="timeline-title">{item.title}{item.emphasis && <em>{item.emphasis}</em>}</div>
            <span class="timeline-current-tag">Current</span>
          </div>
        ) : (
          <div class="timeline-title">{item.title}{item.emphasis && <em>{item.emphasis}</em>}</div>
        )}
        <div class="timeline-desc">{item.desc}</div>
      </div>
    </div>
  ))}
</div>

<style>
  .timeline {
    position:       relative;
    display:        flex;
    flex-direction: column;
  }

  /* Vertical line through dot column center (56px year + 16px = 72px) */
  .timeline::before {
    content:    '';
    position:   absolute;
    left:       72px;
    top:        8px;
    bottom:     36px;
    width:      0.5px;
    background: linear-gradient(to bottom, var(--border) 60%, var(--accent));
  }

  .timeline-item {
    display:               grid;
    grid-template-columns: 56px 32px 1fr;
    align-items:           start;
    padding-bottom:        40px;
    cursor:                default;
  }

  .timeline-item:last-child {
    padding-bottom: 8px;
  }

  /* No year column (e.g. workflow steps) — drop the year track and shift
     the connecting line to sit under the node column instead. */
  .timeline.no-year::before {
    left: 16px;
  }

  .timeline.no-year .timeline-item {
    grid-template-columns: 32px 1fr;
  }

  .timeline-year {
    font-family:  var(--font-mono);
    font-size:    12px;
    color:        var(--text-2);
    text-align:   right;
    padding-top:  3px;
    padding-right: 14px;
    line-height:  1;
    transition:   color 0.2s var(--ease);
  }

  .timeline-node {
    display:         flex;
    justify-content: center;
    padding-top:     4px;
    position:        relative;
    z-index:         1;
  }

  .timeline-dot {
    width:         8px;
    height:        8px;
    border-radius: 50%;
    background:    var(--bg);
    border:        0.5px solid var(--border-2);
    flex-shrink:   0;
    transition-property:       background-color, border-color, box-shadow;
    transition-duration:       0.25s;
    transition-timing-function: var(--ease);
  }

  .timeline-body {
    padding-left: 8px;
    transition:   transform 0.2s var(--ease);
  }

  .timeline-title-row {
    display:     flex;
    align-items: center;
    gap:         10px;
    flex-wrap:   wrap;
    margin-bottom: 5px;
  }

  .timeline-title {
    font-family:    var(--font-display);
    font-size:      20px;
    font-weight:    400;
    color:          var(--text-1);
    line-height:    1.2;
    letter-spacing: -0.01em;
  }

  .timeline-title em {
    font-style: italic;
    color:      var(--accent-text);
  }

  .timeline-desc {
    font-family:  var(--font-body);
    font-size:    12px;
    font-weight:  400;
    color:        var(--text-2);
    line-height:  1.65;
    max-width:    440px;
    margin-bottom: 8px;
  }

  .timeline-year-mobile {
    display:        none;
    font-family:    var(--font-mono);
    font-size:      10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color:          var(--text-2);
    margin-bottom:  5px;
  }

  /* Current tag pill */
  .timeline-current-tag {
    display:        inline-flex;
    align-items:    center;
    gap:            5px;
    padding:        4px 10px;
    border-radius:  var(--r-pill);
    font-family:    var(--font-body);
    font-size:      12px;
    font-weight:    500;
    letter-spacing: 0.03em;
    color:          var(--success);
    background:     color-mix(in srgb, var(--success) 10%, transparent);
    border:         0.5px solid color-mix(in srgb, var(--success) 30%, transparent);
  }

  .timeline-current-tag::before {
    content:       '';
    display:       block;
    width:         5px;
    height:        5px;
    border-radius: 50%;
    background:    var(--success);
    flex-shrink:   0;
  }

  /* Current milestone */
  .timeline-item.current .timeline-dot {
    background:   var(--accent);
    border-color: var(--accent);
    box-shadow:   var(--neon-sm);
  }

  .timeline-item.current .timeline-year {
    color: var(--accent-text);
  }

  .timeline-item.current .timeline-title em {
    color: var(--accent-text);
  }

  /* Hover */
  .timeline-item:hover .timeline-dot {
    border-color: var(--accent);
    box-shadow:   var(--neon-sm);
    background:   var(--accent-dim);
  }

  .timeline-item:hover .timeline-year {
    color: var(--text-2);
  }

  .timeline-item:hover .timeline-body {
    transform: translateX(3px);
  }

  /* Mobile */
  @media (max-width: 520px) {
    .timeline::before {
      left: 8px;
    }

    .timeline-item {
      grid-template-columns: 20px 1fr;
    }

    .timeline-year {
      display: none;
    }

    .timeline-year-mobile {
      display: block;
    }

    .timeline-node {
      padding-top: 6px;
    }
  }
</style>
