---
import CaseStudyVideo from './case-study-video.astro';
import CaseStudyGif from './case-study-gif.astro';

const {
  title,
  fullTitle,
  accentTitle,
  videoSrc,
  gifSrc,
  gifVideoSrc,
  gifAspectRatio,
  gifAlt,
  role = [],
  tools = [],
  toolsLabel = 'Tool:',
  duration = [],
} = Astro.props;

const restTitle = accentTitle ? title.slice(accentTitle.length) : title;
---

<section class="case-hero-section">
  <div class="padding-global">
    <div class="container-main">
      <div class="case-hero">

        <h1 class="case-hero-title">
          <span aria-hidden="true">
            {accentTitle && <em class="case-hero-title-accent">{accentTitle}</em>}{restTitle}
          </span>
          <span class="sr-only">{fullTitle}</span>
        </h1>

        <div class="case-hero-video-spacing">
          {gifSrc || gifVideoSrc ? (
            <CaseStudyGif gifSrc={gifSrc} videoSrc={gifVideoSrc} alt={gifAlt} aspectRatio={gifAspectRatio} />
          ) : videoSrc ? (
            <CaseStudyVideo videoSrc={videoSrc} />
          ) : (
            <div class="case-hero-video-empty">
              <svg class="case-hero-video-empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 4v16l13-8z" />
              </svg>
              <p class="case-hero-video-empty-label">Demo video coming soon</p>
            </div>
          )}
        </div>

        <div class="case-hero-meta">
          <dl class="case-meta-box">
            <dt class="case-meta-label">Role:</dt>
            <dd>
              <ul class="case-meta-list">
                {role.map((item: string) => <li>{item}</li>)}
              </ul>
            </dd>
          </dl>

          <dl class="case-meta-box">
            <dt class="case-meta-label">{toolsLabel}</dt>
            <dd>
              <ul class="case-meta-list">
                {tools.map((item: string) => <li>{item}</li>)}
              </ul>
            </dd>
          </dl>

          <dl class="case-meta-box">
            <dt class="case-meta-label">Duration:</dt>
            <dd>
              <ul class="case-meta-list">
                {duration.map((item: string) => <li>{item}</li>)}
              </ul>
            </dd>
          </dl>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .case-hero-section {
    padding-top: clamp(32px, 5.5vw, 80px);
  }

  .sr-only {
    position: absolute;
    width:    1px;
    height:   1px;
    margin:   -1px;
    overflow: hidden;
    clip:     rect(0, 0, 0, 0);
    white-space: nowrap;
    border:   0;
  }

  .case-hero-title {
    font-family:    var(--font-display);
    font-size:      clamp(39px, 3.6vw, 49px);
    font-weight:    300;
    line-height:    1;
    letter-spacing: -1.04px;
    color:          var(--text-1);
    margin-bottom:  clamp(20px, 2.8vw, 40px);
    text-wrap:      balance;
  }

  .case-hero-title-accent {
    font-style:           normal;
    background:           var(--case-accent, var(--accent-2));
    background-clip:      text;
    -webkit-background-clip: text;
    color:                transparent;
  }

  /* ── Video ───────────────────────────────── */
  .case-hero-video-spacing {
    margin-bottom: clamp(20px, 2.8vw, 40px);
  }

  .case-hero-video-empty {
    display:        flex;
    flex-direction: column;
    align-items:    center;
    justify-content: center;
    gap:            var(--space-xs);
    aspect-ratio:   16 / 9;
    border:         0.5px solid var(--border);
    border-radius:  var(--r-lg);
    background:     var(--bg-3);
    color:          var(--text-3);
  }

  .case-hero-video-empty-icon {
    width:  32px;
    height: 32px;
  }

  .case-hero-video-empty-label {
    font-family:    var(--font-body);
    font-size:      12px;
    font-weight:    500;
    letter-spacing: 0.01em;
  }

  /* ── Metadata row ────────────────────────── */
  .case-hero-meta {
    display:               grid;
    grid-template-columns: repeat(3, 1fr);
    gap:                   clamp(12px, 1.7vw, 24px);
  }

  .case-meta-box {
    display:        flex;
    flex-direction: column;
    padding:        var(--space-sm);
    border:         0.5px solid var(--case-accent-solid, var(--accent-2));
    border-radius:  var(--r-lg);
    background:     var(--bg-2);
  }

  .case-meta-label {
    font-family:   var(--font-body);
    font-size:     12px;
    font-weight:   500;
    color:         var(--text-1);
    line-height:   1.6;
    margin-bottom: 4px;
  }

  .case-meta-list {
    display:        flex;
    flex-direction: column;
  }

  .case-meta-list li {
    font-family: var(--font-body);
    font-size:   12px;
    font-weight: 400;
    color:       var(--text-2);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .case-hero-meta {
      grid-template-columns: 1fr;
    }
  }
</style>
