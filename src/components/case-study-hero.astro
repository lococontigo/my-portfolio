---
const {
  title,
  fullTitle,
  videoSrc,
  role = [],
  tools = [],
  duration = [],
} = Astro.props;
---

<section class="case-hero-section">
  <div class="padding-global">
    <div class="container-main">
      <div class="case-hero">

        <h1 class="case-hero-title">
          <span aria-hidden="true">{title}</span>
          <span class="sr-only">{fullTitle}</span>
        </h1>

        <div class="case-hero-video-wrap">
          <video class="case-hero-video" autoplay muted loop playsinline>
            <source src={videoSrc} type="video/mp4" />
          </video>
          <button class="case-hero-mute-btn" type="button" aria-pressed="true" aria-label="Unmute video">
            <svg class="icon-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M11 5 6 9H2v6h4l5 4V5Z" />
              <line x1="22" y1="9" x2="16" y2="15" />
              <line x1="16" y1="9" x2="22" y2="15" />
            </svg>
            <svg class="icon-unmuted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M11 5 6 9H2v6h4l5 4V5Z" />
              <path d="M15.54 8.46a5 5 0 0 1 0 7.07" />
              <path d="M19.07 4.93a10 10 0 0 1 0 14.14" />
            </svg>
          </button>
        </div>

        <div class="case-hero-meta">
          <dl class="case-meta-box">
            <dt class="case-meta-label">Role:</dt>
            <dd>
              <ul class="case-meta-list">
                {role.map((item) => <li>{item}</li>)}
              </ul>
            </dd>
          </dl>

          <dl class="case-meta-box">
            <dt class="case-meta-label">Tool:</dt>
            <dd>
              <ul class="case-meta-list">
                {tools.map((item) => <li>{item}</li>)}
              </ul>
            </dd>
          </dl>

          <dl class="case-meta-box">
            <dt class="case-meta-label">Duration:</dt>
            <dd>
              <ul class="case-meta-list">
                {duration.map((item) => <li>{item}</li>)}
              </ul>
            </dd>
          </dl>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .sr-only {
    position: absolute;
    width:    1px;
    height:   1px;
    margin:   -1px;
    overflow: hidden;
    clip:     rect(0, 0, 0, 0);
    white-space: nowrap;
    border:   0;
  }

  .case-hero-title {
    font-family:    var(--font-display);
    font-size:      clamp(36px, 3.6vw, 52px);
    font-weight:    300;
    line-height:    1;
    letter-spacing: -1.04px;
    color:          var(--accent-2);
    margin-bottom:  clamp(20px, 2.8vw, 40px);
  }

  /* ── Video ───────────────────────────────── */
  .case-hero-video-wrap {
    position:      relative;
    width:         100%;
    aspect-ratio:  16 / 9;
    border-radius: var(--r-lg);
    overflow:      hidden;
    background:    var(--bg-3);
    margin-bottom: clamp(20px, 2.8vw, 40px);
  }

  .case-hero-video {
    width:      100%;
    height:     100%;
    object-fit: cover;
  }

  .case-hero-mute-btn {
    position:        absolute;
    bottom:          var(--space-sm);
    right:           var(--space-sm);
    display:         flex;
    align-items:     center;
    justify-content: center;
    width:           40px;
    height:          40px;
    border-radius:   var(--r-pill);
    border:          0.5px solid transparent;
    background:      color-mix(in srgb, var(--bg) 70%, transparent);
    color:           var(--text-1);
    transition:      border-color 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }

  .case-hero-mute-btn svg {
    width:  18px;
    height: 18px;
  }

  .case-hero-mute-btn .icon-unmuted { display: none; }
  .case-hero-mute-btn[aria-pressed="false"] .icon-muted   { display: none; }
  .case-hero-mute-btn[aria-pressed="false"] .icon-unmuted { display: block; }

  .case-hero-mute-btn:hover {
    border-color: var(--accent-2);
    box-shadow:   var(--neon-purple);
  }

  /* ── Metadata row ────────────────────────── */
  .case-hero-meta {
    display:               grid;
    grid-template-columns: repeat(3, 1fr);
    gap:                   clamp(12px, 1.7vw, 24px);
  }

  .case-meta-box {
    display:        flex;
    flex-direction: column;
    padding:        var(--space-sm);
    border:         0.5px solid var(--accent-2);
    border-radius:  var(--r-lg);
    background:     var(--bg-2);
  }

  .case-meta-label {
    font-family:   var(--font-body);
    font-size:     13px;
    font-weight:   500;
    color:         var(--text-1);
    line-height:   1.6;
    margin-bottom: 4px;
  }

  .case-meta-list {
    display:        flex;
    flex-direction: column;
  }

  .case-meta-list li {
    font-family: var(--font-body);
    font-size:   13px;
    font-weight: 400;
    color:       var(--text-2);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .case-hero-meta {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const wrap = document.querySelector('.case-hero-video-wrap');
  const video = wrap?.querySelector('.case-hero-video');
  const btn = wrap?.querySelector('.case-hero-mute-btn');

  btn?.addEventListener('click', () => {
    if (!(video instanceof HTMLVideoElement)) return;
    video.muted = !video.muted;
    btn.setAttribute('aria-pressed', String(video.muted));
    btn.setAttribute('aria-label', video.muted ? 'Unmute video' : 'Mute video');
  });
</script>
