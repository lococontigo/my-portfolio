---
const {
  title,
  fullTitle,
  videoSrc,
  role = [],
  tools = [],
  duration = [],
} = Astro.props;
---

<section class="case-hero-section">
  <div class="padding-global">
    <div class="container-main">
      <div class="case-hero">

        <h1 class="case-hero-title">
          <span aria-hidden="true">{title}</span>
          <span class="sr-only">{fullTitle}</span>
        </h1>

        <div class="case-hero-video-wrap">
          <video class="case-hero-video" autoplay muted loop playsinline>
            <source src={videoSrc} type="video/mp4" />
          </video>
          <div class="case-hero-controls">
            <button class="case-hero-ctrl-btn case-hero-play-btn" type="button" aria-pressed="false" aria-label="Pause video">
              <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <rect x="6" y="4" width="4" height="16" rx="1" />
                <rect x="14" y="4" width="4" height="16" rx="1" />
              </svg>
              <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M7 4v16l13-8z" />
              </svg>
            </button>

            <input class="case-hero-seek" type="range" min="0" max="100" step="0.1" value="0" aria-label="Seek video" />

            <span class="case-hero-timestamp">0:00 / 0:00</span>

            <button class="case-hero-ctrl-btn case-hero-mute-btn" type="button" aria-pressed="true" aria-label="Unmute video">
              <svg class="icon-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M11 5 6 9H2v6h4l5 4V5Z" />
                <line x1="22" y1="9" x2="16" y2="15" />
                <line x1="16" y1="9" x2="22" y2="15" />
              </svg>
              <svg class="icon-unmuted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M11 5 6 9H2v6h4l5 4V5Z" />
                <path d="M15.54 8.46a5 5 0 0 1 0 7.07" />
                <path d="M19.07 4.93a10 10 0 0 1 0 14.14" />
              </svg>
            </button>
          </div>
        </div>

        <div class="case-hero-meta">
          <dl class="case-meta-box">
            <dt class="case-meta-label">Role:</dt>
            <dd>
              <ul class="case-meta-list">
                {role.map((item) => <li>{item}</li>)}
              </ul>
            </dd>
          </dl>

          <dl class="case-meta-box">
            <dt class="case-meta-label">Tool:</dt>
            <dd>
              <ul class="case-meta-list">
                {tools.map((item) => <li>{item}</li>)}
              </ul>
            </dd>
          </dl>

          <dl class="case-meta-box">
            <dt class="case-meta-label">Duration:</dt>
            <dd>
              <ul class="case-meta-list">
                {duration.map((item) => <li>{item}</li>)}
              </ul>
            </dd>
          </dl>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .sr-only {
    position: absolute;
    width:    1px;
    height:   1px;
    margin:   -1px;
    overflow: hidden;
    clip:     rect(0, 0, 0, 0);
    white-space: nowrap;
    border:   0;
  }

  .case-hero-title {
    font-family:    var(--font-display);
    font-size:      clamp(36px, 3.6vw, 52px);
    font-weight:    300;
    line-height:    1;
    letter-spacing: -1.04px;
    color:          var(--accent-2);
    margin-bottom:  clamp(20px, 2.8vw, 40px);
  }

  /* ── Video ───────────────────────────────── */
  .case-hero-video-wrap {
    position:      relative;
    width:         100%;
    aspect-ratio:  16 / 9;
    border-radius: var(--r-lg);
    overflow:      hidden;
    background:    var(--bg-3);
    margin-bottom: clamp(20px, 2.8vw, 40px);
  }

  .case-hero-video {
    width:      100%;
    height:     100%;
    object-fit: cover;
  }

  .case-hero-controls {
    position:       absolute;
    left:           var(--space-sm);
    right:          var(--space-sm);
    bottom:         var(--space-sm);
    display:        flex;
    align-items:    center;
    gap:            var(--space-xs);
    padding:        var(--space-xs) var(--space-sm);
    border-radius:  var(--r-pill);
    background:     color-mix(in srgb, var(--bg) 70%, transparent);
    opacity:        0;
    transform:      translateY(6px);
    transition:     opacity 0.25s var(--ease), transform 0.25s var(--ease);
    pointer-events: none;
  }

  .case-hero-video-wrap:hover .case-hero-controls,
  .case-hero-video-wrap:focus-within .case-hero-controls {
    opacity:        1;
    transform:      translateY(0);
    pointer-events: auto;
  }

  .case-hero-ctrl-btn {
    display:         flex;
    align-items:     center;
    justify-content: center;
    flex-shrink:     0;
    width:           32px;
    height:          32px;
    border-radius:   var(--r-pill);
    border:          0.5px solid transparent;
    color:           var(--text-1);
    transition:      border-color 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }

  .case-hero-ctrl-btn svg {
    width:  16px;
    height: 16px;
  }

  .case-hero-ctrl-btn:hover {
    border-color: var(--accent-2);
    box-shadow:   var(--neon-purple);
  }

  .case-hero-seek {
    flex:         1;
    height:       4px;
    accent-color: var(--accent-2);
    cursor:       pointer;
  }

  .case-hero-timestamp {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size:   11px;
    color:       var(--text-1);
    white-space: nowrap;
  }

  /* Play / pause toggle */
  .case-hero-play-btn .icon-play { display: none; }
  .case-hero-play-btn[aria-pressed="true"] .icon-pause { display: none; }
  .case-hero-play-btn[aria-pressed="true"] .icon-play  { display: block; }

  /* Mute / unmute toggle */
  .case-hero-mute-btn .icon-unmuted { display: none; }
  .case-hero-mute-btn[aria-pressed="false"] .icon-muted   { display: none; }
  .case-hero-mute-btn[aria-pressed="false"] .icon-unmuted { display: block; }

  /* ── Metadata row ────────────────────────── */
  .case-hero-meta {
    display:               grid;
    grid-template-columns: repeat(3, 1fr);
    gap:                   clamp(12px, 1.7vw, 24px);
  }

  .case-meta-box {
    display:        flex;
    flex-direction: column;
    padding:        var(--space-sm);
    border:         0.5px solid var(--accent-2);
    border-radius:  var(--r-lg);
    background:     var(--bg-2);
  }

  .case-meta-label {
    font-family:   var(--font-body);
    font-size:     13px;
    font-weight:   500;
    color:         var(--text-1);
    line-height:   1.6;
    margin-bottom: 4px;
  }

  .case-meta-list {
    display:        flex;
    flex-direction: column;
  }

  .case-meta-list li {
    font-family: var(--font-body);
    font-size:   13px;
    font-weight: 400;
    color:       var(--text-2);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .case-hero-meta {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const wrap = document.querySelector('.case-hero-video-wrap');
  const video = wrap?.querySelector('.case-hero-video');
  const playBtn = wrap?.querySelector('.case-hero-play-btn');
  const muteBtn = wrap?.querySelector('.case-hero-mute-btn');
  const seek = wrap?.querySelector('.case-hero-seek');
  const timestamp = wrap?.querySelector('.case-hero-timestamp');
  let isSeeking = false;

  function formatTime(seconds) {
    if (!isFinite(seconds) || seconds < 0) return '0:00';
    const m = Math.floor(seconds / 60);
    const s = Math.floor(seconds % 60).toString().padStart(2, '0');
    return `${m}:${s}`;
  }

  if (video instanceof HTMLVideoElement) {
    playBtn?.addEventListener('click', () => {
      if (video.paused) {
        video.play();
      } else {
        video.pause();
      }
    });

    video.addEventListener('play', () => {
      playBtn?.setAttribute('aria-pressed', 'false');
      playBtn?.setAttribute('aria-label', 'Pause video');
    });

    video.addEventListener('pause', () => {
      playBtn?.setAttribute('aria-pressed', 'true');
      playBtn?.setAttribute('aria-label', 'Play video');
    });

    muteBtn?.addEventListener('click', () => {
      video.muted = !video.muted;
      muteBtn.setAttribute('aria-pressed', String(video.muted));
      muteBtn.setAttribute('aria-label', video.muted ? 'Unmute video' : 'Mute video');
    });

    seek?.addEventListener('input', () => {
      if (!isFinite(video.duration)) return;
      isSeeking = true;
      video.currentTime = (Number(seek.value) / 100) * video.duration;
    });

    seek?.addEventListener('change', () => {
      isSeeking = false;
    });

    const updateTimestamp = () => {
      if (timestamp) {
        timestamp.textContent = `${formatTime(video.currentTime)} / ${formatTime(video.duration)}`;
      }
      if (seek && !isSeeking && isFinite(video.duration)) {
        seek.value = String((video.currentTime / video.duration) * 100);
      }
    };

    video.addEventListener('loadedmetadata', updateTimestamp);
    video.addEventListener('timeupdate', updateTimestamp);
  }
</script>
