---
const { eyebrow, title, body, imageSrc, imageAlt, id } = Astro.props;
---

<section class="case-overview-section" id={id}>
  <div class="case-overview" data-parallax>

    <img class="case-overview-image" src={imageSrc} alt={imageAlt} loading="lazy" />
    <div class="case-overview-overlay"></div>

    <div class="padding-global">
      <div class="container-main">
        <div class="case-overview-text">
          <span class="case-overview-eyebrow">{eyebrow}</span>
          <h2 class="case-overview-title">{title}</h2>
          <p class="case-overview-body">{body}</p>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .case-overview {
    position:     relative;
    overflow:     hidden;
    width:        100%;
    aspect-ratio: 2560 / 879;
  }

  .case-overview-image {
    position:   absolute;
    top:        -10%;
    left:       0;
    width:      100%;
    height:     120%;
    object-fit: cover;
  }

  .case-overview-overlay {
    display: none;
  }

  .case-overview .padding-global {
    position: absolute;
    inset:    0;
  }

  .case-overview .container-main {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    align-items:           center;
    height:                100%;
  }

  .case-overview-text {
    display:        flex;
    flex-direction: column;
    gap:            var(--space-xs);
    max-width:      480px;
    justify-self:   center;
  }

  .case-overview-eyebrow {
    font-family: var(--font-body);
    font-size:   16px;
    font-weight: 400;
    color:       var(--text-on-image);
  }

  .case-overview-title {
    font-family:    var(--font-display);
    font-size:      clamp(39px, 3.6vw, 49px);
    font-weight:    300;
    line-height:    1;
    letter-spacing: -1.04px;
    color:          var(--text-on-image);
  }

  .case-overview-body {
    font-family: var(--font-body);
    font-size:   16px;
    font-weight: 300;
    line-height: 1.6;
    color:       var(--text-on-image);
  }

  @media (max-width: 520px) {
    .case-overview {
      aspect-ratio: 4 / 5;
    }

    .case-overview .container-main {
      grid-template-columns: 1fr;
    }

    .case-overview-text {
      max-width: 100%;
    }
  }
</style>
