---
const {
  beforeSrc,
  afterSrc,
  beforeAlt,
  afterAlt,
  beforeLabel = 'Before',
  afterLabel = 'After',
  aspectRatio = '16 / 9',
} = Astro.props;
---

<div class="compare-slider" style={`aspect-ratio: ${aspectRatio};`}>
  <div class="compare-layer compare-layer-after">
    <img src={afterSrc} alt={afterAlt} loading="lazy" draggable="false" />
  </div>
  <div class="compare-layer compare-layer-before">
    <img src={beforeSrc} alt={beforeAlt} loading="lazy" draggable="false" />
  </div>

  <span class="compare-badge compare-badge-left">{beforeLabel}</span>
  <span class="compare-badge compare-badge-right">{afterLabel}</span>

  <div class="compare-handle"></div>
  <div class="compare-knob" data-knob role="slider" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" tabindex="0" aria-label="Drag to compare before and after">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="9 6 4 12 9 18"></polyline>
      <polyline points="15 6 20 12 15 18"></polyline>
    </svg>
  </div>
</div>

<style>
  .compare-slider {
    --pos:         50%;
    position:      relative;
    width:         100%;
    border-radius: var(--r-lg);
    overflow:      hidden;
    background:    var(--bg-3);
    border:        0.5px solid var(--border);
    user-select:   none;
    touch-action:  pan-y;
    cursor:        ew-resize;
  }

  /* Both layers are full-size and never move — the top layer
     is only clipped, so the two images stay pixel-aligned. */
  .compare-layer {
    position: absolute;
    inset:    0;
  }

  .compare-layer img {
    position:   absolute;
    inset:      0;
    display:    block;
    width:      100%;
    height:     100%;
    object-fit: cover;
  }

  .compare-layer-after {
    z-index: 1;
  }

  .compare-layer-before {
    z-index:   2;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  .compare-badge {
    position:        absolute;
    top:             50%;
    transform:       translateY(-50%);
    z-index:         5;
    font-family:     var(--font-mono);
    font-size:       11px;
    letter-spacing:  0.12em;
    text-transform:  uppercase;
    color:           var(--text-on-image);
    background:      var(--scrim);
    padding:         6px 11px;
    border-radius:   var(--r-pill);
    backdrop-filter: blur(6px);
  }

  .compare-badge-left  { left:  var(--space-sm); }
  .compare-badge-right { right: var(--space-sm); }

  .compare-handle {
    position:   absolute;
    top:        0;
    bottom:     0;
    left:       var(--pos);
    width:      2.5px;
    background: var(--bg);
    z-index:    6;
    transform:  translateX(-50%);
  }

  .compare-knob {
    position:        absolute;
    top:             50%;
    left:            var(--pos);
    transform:       translate(-50%, -50%);
    width:           54px;
    height:          54px;
    border-radius:   var(--r-pill);
    background:      var(--surface);
    border:          0.5px solid var(--border);
    box-shadow:      var(--neon-md);
    color:           var(--text-1);
    z-index:         7;
    display:         flex;
    align-items:     center;
    justify-content: center;
    cursor:          ew-resize;
    transition:      box-shadow 0.25s var(--ease);
  }

  .compare-knob:hover,
  .compare-knob:focus-visible {
    box-shadow: var(--neon-lg);
  }

  .compare-knob svg {
    width:  22px;
    height: 22px;
  }

  @media (max-width: 520px) {
    .compare-slider {
      aspect-ratio: 4 / 5;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.compare-slider').forEach((compare) => {
    const knob = compare.querySelector<HTMLElement>('[data-knob]');
    if (!knob) return;

    let pct = 50;
    let frame = 0;

    function render() {
      frame = 0;
      compare.style.setProperty('--pos', `${pct}%`);
      knob!.setAttribute('aria-valuenow', String(Math.round(pct)));
    }

    function setPct(next: number) {
      pct = Math.max(0, Math.min(100, next));
      if (!frame) frame = requestAnimationFrame(render);
    }

    function fromClientX(clientX: number) {
      const rect = compare.getBoundingClientRect();
      setPct(((clientX - rect.left) / rect.width) * 100);
    }

    compare.addEventListener('pointerdown', (e: PointerEvent) => {
      compare.setPointerCapture(e.pointerId);
      fromClientX(e.clientX);
      if (e.pointerType === 'mouse') e.preventDefault();
    });

    compare.addEventListener('pointermove', (e: PointerEvent) => {
      if (!compare.hasPointerCapture(e.pointerId)) return;
      fromClientX(e.clientX);
    });

    knob.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') { setPct(pct - 4); e.preventDefault(); }
      if (e.key === 'ArrowRight') { setPct(pct + 4); e.preventDefault(); }
    });

    render();
  });
</script>
