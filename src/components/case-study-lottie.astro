---
const { lottieSrc, aspectRatio = '16 / 9' } = Astro.props;
---

<div class="case-lottie-wrap" style={`aspect-ratio: ${aspectRatio};`}>
  <div class="case-lottie" data-lottie-src={lottieSrc}></div>
</div>

<style>
  .case-lottie-wrap {
    width:         100%;
    border-radius: var(--r-lg);
    overflow:      hidden;
    background:    var(--bg-3);
  }

  .case-lottie {
    width:  100%;
    height: 100%;
  }
</style>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/lottie-web/5.12.2/lottie.min.js"></script>
<script>
  declare const lottie: any;

  document.querySelectorAll<HTMLElement>('.case-lottie').forEach((el) => {
    const src = el.dataset.lottieSrc;
    if (src) {
      lottie.loadAnimation({
        container: el,
        renderer:  'svg',
        loop:      true,
        autoplay:  true,
        path:      src,
      });
    }
  });
</script>
