---
interface Props {
  title:      string;
  subheading: string;
  items:      string[];
}

const { title, subheading, items } = Astro.props as Props;
---

<div class="service-card">
  <h3 class="service-card-title">{title}</h3>
  <p class="service-card-subheading">{subheading}</p>
  <ul class="service-card-list">
    {items.map((item) => <li>{item}</li>)}
  </ul>
</div>

<style>
  .service-card {
    display:        flex;
    flex-direction: column;
    background:     var(--bg-2);
    border-radius:  var(--r-lg);
    padding:        var(--space-md);
    height:         100%;
  }

  .service-card-title {
    font-family:    var(--font-display);
    font-size:      clamp(48px, 6vw, 76px);
    font-weight:    300;
    line-height:    1;
    letter-spacing: -0.02em;
    color:          var(--accent);
    margin-bottom:  var(--space-sm);
    text-wrap:      balance;
  }

  .service-card-subheading {
    font-family:   var(--font-display);
    font-size:     clamp(20px, 2vw, 25px);
    font-weight:   400;
    line-height:   1.3;
    color:         var(--text-1);
    margin-bottom: var(--space-sm);
    text-wrap:     pretty;
  }

  .service-card-list {
    display:        flex;
    flex-direction: column;
    gap:            8px;
    list-style:     disc;
    padding-left:   var(--space-sm);
    margin-top:     auto;
  }

  .service-card-list li {
    font-family: var(--font-body);
    font-size:   16px;
    font-weight: 300;
    line-height: 1.5;
    color:       var(--text-2);
  }

  @media (max-width: 520px) {
    .service-card { padding: var(--space-sm); }
  }
</style>
